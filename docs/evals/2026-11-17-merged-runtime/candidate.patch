diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..693891a
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,43 @@
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn fixture(mode: &str) -> (tempfile::TempDir, PathBuf) {
+    let dir = tempfile::tempdir().expect("temporary fixture directory");
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py", dir.path().to_str().unwrap(), mode])
+        .status()
+        .expect("run protected fixture helper");
+    assert!(status.success(), "fixture helper failed: {status}");
+    let root = dir.path().to_path_buf();
+    (dir, root)
+}
+
+fn cli(root: &Path) -> std::process::Output {
+    let binary = std::env::var_os("CARGO_BIN_EXE_spiral-coder")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from(env!("CARGO_BIN_EXE_spiral-coder")));
+    Command::new(binary)
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .expect("run coupled-status")
+}
+
+#[test]
+fn completed_fixture_succeeds_and_reports_json() {
+    let (_tmp, root) = fixture("completed");
+    let output = cli(&root);
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("JSON output");
+    assert_eq!(value["status"], "completed");
+    assert!(value["iterations"].as_array().unwrap().len() == 1);
+}
+
+#[test]
+fn missing_run_dir_fails_without_stdout() {
+    let dir = tempfile::tempdir().unwrap();
+    let output = cli(&dir.path().join("missing"));
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
