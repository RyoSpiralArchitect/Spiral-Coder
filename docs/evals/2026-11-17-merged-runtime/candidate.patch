+++ b/src/coupled_status.rs
@@ -0,0 +1,305 @@
+use anyhow::{anyhow, bail, Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(clap::Args, Debug)]
+pub struct Args {
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+#[derive(Deserialize)]
+struct Manifest {
+    version: u64,
+    max_iterations: u64,
+    max_task_requests_per_iteration: u64,
+    max_task_requests: u64,
+    max_wire_requests: u64,
+    completed: bool,
+    stop_reason: Option<String>,
+    active_iteration: Option<String>,
+    interrupted_iteration: Option<PendingManifest>,
+    iterations: Vec<Row>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+#[derive(Deserialize)]
+struct PendingManifest {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+#[derive(Deserialize)]
+struct Row {
+    iteration: u64,
+    directory: String,
+    task_id: String,
+    parent_task_id: Option<String>,
+    termination: String,
+    completed: bool,
+    task_requests: u64,
+    wire_requests: u64,
+    progress: Progress,
+}
+#[derive(Deserialize)]
+struct Progress {
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+#[derive(Deserialize)]
+struct Ledger {
+    task_id: String,
+    requests: Vec<Request>,
+}
+#[derive(Deserialize)]
+struct Request {
+    id: u64,
+    charge: Option<String>,
+    status: Option<String>,
+}
+#[derive(Serialize)]
+struct Output {
+    version: u64,
+    status: String,
+    stop_reason: Option<String>,
+    iterations: Vec<OutputRow>,
+    pending: Option<OutputPending>,
+    requests: Requests,
+}
+#[derive(Serialize)]
+struct OutputRow {
+    iteration: u64,
+    task_id: String,
+    termination: String,
+    task_requests: u64,
+    wire_requests: u64,
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+#[derive(Serialize)]
+struct OutputPending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+    in_flight_requests: Option<u64>,
+}
+#[derive(Serialize)]
+struct Requests {
+    task_used: Option<u64>,
+    wire_used: Option<u64>,
+    task_limit: u64,
+    wire_limit: u64,
+    task_remaining: Option<u64>,
+    wire_remaining: Option<u64>,
+}
+
+fn safe_path(root: &Path, relative: &str) -> Result<PathBuf> {
+    let p = Path::new(relative);
+    if p.is_absolute()
+        || p.components().any(|c| {
+            matches!(
+                c,
+                Component::ParentDir | Component::RootDir | Component::Prefix(_)
+            )
+        })
+    {
+        bail!("unsafe path")
+    }
+    let mut cur = root.to_path_buf();
+    for c in p.components() {
+        cur.push(c.as_os_str());
+        if cur.is_symlink() {
+            bail!("symlink path: {}", cur.display())
+        }
+    }
+    Ok(cur)
+}
+fn read_json<T: for<'a> Deserialize<'a>>(path: &Path) -> Result<T> {
+    if path.is_symlink() {
+        bail!("symlink path: {}", path.display())
+    }
+    Ok(serde_json::from_slice(
+        &fs::read(path).with_context(|| format!("read {}", path.display()))?,
+    )?)
+}
+fn ledger(root: &Path, directory: &str) -> Result<(Ledger, u64, u64, u64)> {
+    let p = safe_path(root, directory)?.join("state/tui-work.json");
+    let p = safe_path(root, &p.strip_prefix(root)?.to_string_lossy())?;
+    let l: Ledger = read_json(&p)?;
+    let task_id = l.task_id.clone();
+    let mut ids = HashSet::new();
+    let mut task: u64 = 0;
+    let mut inflight: u64 = 0;
+    for r in &l.requests {
+        if !ids.insert(r.id) {
+            bail!("duplicate request id")
+        }
+        if r.charge.as_deref().unwrap_or("task") == "task" {
+            task += 1;
+        }
+        if r.status.as_deref() == Some("in_flight_or_interrupted") {
+            inflight += 1;
+        }
+    }
+    let wire = l.requests.len() as u64;
+    Ok((l, task, wire, inflight))
+}
+pub fn run(args: Args) -> Result<()> {
+    let root = if args.run_dir.is_absolute() {
+        args.run_dir
+    } else {
+        std::env::current_dir()?.join(args.run_dir)
+    };
+    let m: Manifest = read_json(&root.join("iterations.json"))?;
+    if m.version != 1
+        || m.max_iterations == 0
+        || m.max_task_requests_per_iteration == 0
+        || m.max_task_requests.checked_mul(1).is_none()
+        || m.max_iterations
+            .checked_mul(m.max_task_requests_per_iteration)
+            != Some(m.max_task_requests)
+        || m.max_wire_requests < m.max_task_requests
+        || m.iterations.len() as u64 > m.max_iterations
+    {
+        bail!("invalid manifest")
+    }
+    if m.active_iteration.is_some() && m.interrupted_iteration.is_some() {
+        bail!("two pending iterations")
+    }
+    let mut seen = HashSet::new();
+    let mut rows = Vec::new();
+    let mut task_total: u64 = 0;
+    let mut wire_total: u64 = 0;
+    for (i, r) in m.iterations.iter().enumerate() {
+        if r.iteration != (i + 1) as u64
+            || r.directory != format!("iteration-{:02}", i + 1)
+            || r.task_id.is_empty()
+            || !seen.insert(r.task_id.clone())
+            || r.completed != (r.termination == "completed")
+            || (i + 1 < m.iterations.len() && r.completed)
+            || r.task_requests > m.max_task_requests_per_iteration
+        {
+            bail!("invalid row")
+        }
+        if (i == 0 && r.parent_task_id.is_some())
+            || (i > 0 && r.parent_task_id.as_deref() != Some(&m.iterations[i - 1].task_id))
+        {
+            bail!("invalid parent")
+        }
+        let (l, t, w, _) = ledger(&root, &r.directory)?;
+        if l.task_id != r.task_id || t != r.task_requests || w != r.wire_requests {
+            bail!("ledger mismatch")
+        }
+        task_total = task_total
+            .checked_add(t)
+            .ok_or_else(|| anyhow!("overflow"))?;
+        wire_total = wire_total
+            .checked_add(w)
+            .ok_or_else(|| anyhow!("overflow"))?;
+        rows.push(OutputRow {
+            iteration: r.iteration,
+            task_id: r.task_id.clone(),
+            termination: r.termination.clone(),
+            task_requests: t,
+            wire_requests: w,
+            changed_files: r.progress.changed_files.clone(),
+            newly_verified: r.progress.newly_verified.clone(),
+        });
+    }
+    let pending_dir = m.active_iteration.clone().or_else(|| {
+        m.interrupted_iteration
+            .as_ref()
+            .map(|p| p.directory.clone())
+    });
+    let mut pending = None;
+    let mut known_task = task_total;
+    let mut known_wire = wire_total;
+    if let Some(d) = pending_dir {
+        if d != format!("iteration-{:02}", m.iterations.len() + 1)
+            || m.iterations.len() as u64 + 1 > m.max_iterations
+        {
+            bail!("invalid pending directory")
+        }
+        let p = safe_path(&root, &d)?.join("state/tui-work.json");
+        let rel = p.strip_prefix(&root)?.to_string_lossy().into_owned();
+        let maybe = if p.exists() {
+            Some(ledger(&root, &d)?)
+        } else {
+            None
+        };
+        let (tid, tr, wr, inf) = if let Some((l, t, w, i)) = maybe {
+            if !seen.insert(l.task_id.clone()) {
+                bail!("duplicate task")
+            };
+            known_task = known_task
+                .checked_add(t)
+                .ok_or_else(|| anyhow!("overflow"))?;
+            known_wire = known_wire
+                .checked_add(w)
+                .ok_or_else(|| anyhow!("overflow"))?;
+            (Some(l.task_id), Some(t), Some(w), Some(i))
+        } else {
+            (None, None, None, None)
+        };
+        let _ = rel;
+        pending = Some(OutputPending {
+            directory: d,
+            task_id: tid,
+            task_requests: tr,
+            wire_requests: wr,
+            in_flight_requests: inf,
+        });
+    }
+    if m.completed != (m.stop_reason.as_deref() == Some("completed"))
+        || (m.completed
+            && (m.iterations.last().map(|r| !r.completed).unwrap_or(true) || pending.is_some()))
+    {
+        bail!("invalid completion")
+    }
+    let interrupted = m.stop_reason.as_deref() == Some("interrupted");
+    let (tu, wu) = if interrupted
+        && pending
+            .as_ref()
+            .map(|p| p.task_requests.is_none())
+            .unwrap_or(false)
+    {
+        (None, None)
+    } else {
+        (Some(known_task), Some(known_wire))
+    };
+    if !interrupted && (m.task_requests != Some(task_total) || m.wire_requests != Some(wire_total))
+    {
+        bail!("aggregate mismatch")
+    }
+    if interrupted && (m.task_requests != tu || m.wire_requests != wu) {
+        bail!("aggregate mismatch")
+    }
+    let out = Output {
+        version: 1,
+        status: if m.completed {
+            "completed".into()
+        } else if m.stop_reason.is_some() {
+            "stopped".into()
+        } else {
+            "running".into()
+        },
+        stop_reason: m.stop_reason,
+        iterations: rows,
+        pending,
+        requests: Requests {
+            task_used: tu,
+            wire_used: wu,
+            task_limit: m.max_task_requests,
+            wire_limit: m.max_wire_requests,
+            task_remaining: tu.map(|x| m.max_task_requests - x),
+            wire_remaining: wu.map(|x| m.max_wire_requests - x),
+        },
+    };
+    println!("{}", serde_json::to_string(&out)?);
+    Ok(())
+}
