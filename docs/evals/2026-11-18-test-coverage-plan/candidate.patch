diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..1f13442
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,50 @@
+use std::{env, fs, path::PathBuf, process::Command};
+
+fn make_fixture(root: &PathBuf, state: &str) {
+    let result = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(root)
+        .arg(state)
+        .status()
+        .expect("invoke protected fixture");
+    assert!(result.success(), "fixture generation failed");
+}
+
+fn binary() -> PathBuf {
+    PathBuf::from(env::var("CARGO_BIN_EXE_spiral-coder").expect("cargo binary path"))
+}
+
+#[test]
+fn public_cli_reports_fixture_and_rejects_mismatched_totals() {
+    let temp = tempfile::tempdir().expect("temporary directory");
+    let root = temp.path().join("completed");
+    make_fixture(&root, "completed");
+
+    let valid = Command::new(binary())
+        .args(["coupled-status", "--run-dir"])
+        .arg(&root)
+        .output()
+        .expect("run coupled-status");
+    assert!(
+        valid.status.success(),
+        "{}",
+        String::from_utf8_lossy(&valid.stderr)
+    );
+    assert!(!valid.stdout.is_empty());
+
+    let manifest_path = root.join("iterations.json");
+    let mut manifest: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&manifest_path).expect("read manifest"))
+            .expect("parse manifest");
+    manifest["task_requests"] = serde_json::json!(999);
+    fs::write(&manifest_path, serde_json::to_vec(&manifest).unwrap()).expect("write manifest");
+
+    let invalid = Command::new(binary())
+        .args(["coupled-status", "--run-dir"])
+        .arg(&root)
+        .output()
+        .expect("run invalid coupled-status");
+    assert!(!invalid.status.success());
+    assert!(invalid.stdout.is_empty());
+    assert!(!invalid.stderr.is_empty());
+}
