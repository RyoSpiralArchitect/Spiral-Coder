+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, resolve_path, validate_case, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub fn select_cases<'a>(spec: &'a TuiReplaySpec, filter: Option<&str>, max_cases: Option<usize>) -> Vec<&'a TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec.cases.iter().filter(|case| {
+        filter.as_deref().is_none_or(|needle| {
+            case.id.to_ascii_lowercase().contains(needle)
+                || case.tags.iter().any(|tag| tag.to_ascii_lowercase().contains(needle))
+        })
+    }).collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
+pub fn list(
+    tool_root: Option<String>,
+    spec: String,
+    filter: Option<String>,
+    max_cases: Option<usize>,
+) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let root = PathBuf::from(tool_root.unwrap_or_else(|| cwd.to_string_lossy().into_owned()));
+    let spec_path = resolve_path(&root, PathBuf::from(spec));
+    let loaded = load_spec(&spec_path)?;
+    let selected = select_cases(&loaded, filter.as_deref(), max_cases);
+    if selected.is_empty() {
+        anyhow::bail!("no replay cases selected from {}", spec_path.display());
+    }
+    for case in &loaded.cases {
+        if case.checks.is_empty() {
+            anyhow::bail!("replay case '{}' has empty checks", case.id);
+        }
+    }
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected.into_iter().map(|case| CatalogCase { id: case.id.clone(), tags: case.tags.clone() }).collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+#[allow(dead_code)]
+fn validate_selected(spec_path: &Path, cases: &[&TuiReplayCase]) -> Result<()> {
+    for case in cases {
+        validate_case(case).with_context(|| format!("invalid case '{}' in {}", case.id, spec_path.display()))?;
+    }
+    Ok(())
+}
