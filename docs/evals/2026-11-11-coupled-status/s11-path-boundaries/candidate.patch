diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..087b566
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,122 @@
+use anyhow::{bail, Context, Result};
+use serde_json::{json, Map, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+pub fn run(run_dir: &Path) -> Result<()> {
+    let manifest_path = checked_path(run_dir, Path::new("iterations.json"))?;
+    let manifest: Value = serde_json::from_str(&fs::read_to_string(&manifest_path)?)?;
+    let out = summarize(run_dir, &manifest)?;
+    println!("{}", serde_json::to_string(&out)?);
+    Ok(())
+}
+
+fn checked_path(root: &Path, rel: &Path) -> Result<PathBuf> {
+    if rel.components().any(|c| matches!(c, Component::ParentDir | Component::RootDir | Component::Prefix(_))) { bail!("invalid path") }
+    let mut cur = root.to_path_buf();
+    for c in rel.components() {
+        cur.push(c.as_os_str());
+        if cur.exists() && fs::symlink_metadata(&cur)?.file_type().is_symlink() { bail!("symlink path") }
+    }
+    Ok(cur)
+}
+
+fn summarize(root: &Path, m: &Value) -> Result<Value> {
+    let o = m.as_object().context("manifest object")?;
+    if o.get("version").and_then(Value::as_u64) != Some(1) { bail!("unsupported version") }
+    let max_i = pos(o, "max_iterations")?;
+    let per = pos(o, "max_task_requests_per_iteration")?;
+    let max_task = pos(o, "max_task_requests")?;
+    let max_wire = pos(o, "max_wire_requests")?;
+    if max_i.checked_mul(per) != Some(max_task) || max_wire < max_task { bail!("invalid limits") }
+    let rows = o.get("iterations").and_then(Value::as_array).context("iterations")?;
+    if rows.len() as u64 > max_i { bail!("too many iterations") }
+    let mut ids = HashSet::new();
+    let mut finalized = Vec::new();
+    let mut task_total = 0u64; let mut wire_total = 0u64;
+    for (ix, row) in rows.iter().enumerate() {
+        let r = row.as_object().context("iteration row")?;
+        let n = ix as u64 + 1;
+        let expected_dir = format!("iteration-{n:02}");
+        if r.get("iteration").and_then(Value::as_u64) != Some(n) || r.get("directory").and_then(Value::as_str) != Some(expected_dir.as_str()) { bail!("invalid row order") }
+        let task_id = r.get("task_id").and_then(Value::as_str).filter(|s| !s.is_empty()).context("task id")?;
+        if !ids.insert(task_id.to_string()) { bail!("duplicate task id") }
+        let parent = r.get("parent_task_id");
+        if n == 1 { if !parent.map(Value::is_null).unwrap_or(false) { bail!("parent linkage") } }
+        else if parent.and_then(Value::as_str) != rows[(ix-1) as usize].get("task_id").and_then(Value::as_str) { bail!("parent linkage") }
+        let ledger = ledger(root, r.get("directory").and_then(Value::as_str).unwrap())?;
+        let counts = ledger_counts(&ledger)?;
+        if counts.0 > per { bail!("per iteration cap") }
+        if r.get("task_requests").and_then(Value::as_u64) != Some(counts.0) || r.get("wire_requests").and_then(Value::as_u64) != Some(counts.1) { bail!("row counts") }
+        task_total = task_total.checked_add(counts.0).context("overflow")?;
+        wire_total = wire_total.checked_add(counts.1).context("overflow")?;
+        let progress = r.get("progress").and_then(Value::as_object);
+        finalized.push(json!({"iteration":n,"task_id":task_id,"termination":r.get("termination").context("termination")?,"task_requests":counts.0,"wire_requests":counts.1,"changed_files":progress.and_then(|p| p.get("changed_files")).cloned().unwrap_or_else(|| json!([])),"newly_verified":progress.and_then(|p| p.get("newly_verified")).cloned().unwrap_or_else(|| json!([]))}));
+    }
+    let interrupted_manifest = o.get("stop_reason").and_then(Value::as_str) == Some("interrupted");
+    if !interrupted_manifest && (o.get("task_requests").and_then(Value::as_u64) != Some(task_total) || o.get("wire_requests").and_then(Value::as_u64) != Some(wire_total)) { bail!("manifest counts") }
+    if task_total > max_task || wire_total > max_wire { bail!("aggregate cap") }
+    let stop = o.get("stop_reason").cloned().unwrap_or(Value::Null);
+    let completed = o.get("completed").and_then(Value::as_bool).context("completed")?;
+    if completed != (stop.as_str() == Some("completed")) { bail!("completed mismatch") }
+    let active = o.get("active_iteration").and_then(Value::as_str).filter(|s| !s.is_empty());
+    let interrupted = o.get("interrupted_iteration").and_then(Value::as_object);
+    if active.is_some() && interrupted.is_some() { bail!("multiple pending") }
+    let pending = if let Some(dir) = active {
+        let v = pending_ledger(root, dir)?;
+        v.map(|v| -> Result<(Value, u64, u64)> {
+            let (task, wire, inflight) = ledger_counts(&v)?;
+            let task_id = v.get("task_id").and_then(Value::as_str).filter(|s| !s.is_empty()).map(Value::from).unwrap_or(Value::Null);
+            Ok((json!({"directory":dir,"task_id":task_id,"task_requests":task,"wire_requests":wire,"in_flight_requests":inflight}), task, wire))
+        }).transpose()?
+    } else if let Some(i) = interrupted {
+        let dir = i.get("directory").and_then(Value::as_str).context("pending directory")?;
+        let v = pending_ledger(root, dir)?;
+        v.map(|v| -> Result<(Value, u64, u64)> {
+            let (task, wire, inflight) = ledger_counts(&v)?;
+            let task_id = v.get("task_id").and_then(Value::as_str).filter(|s| !s.is_empty()).map(Value::from).unwrap_or(Value::Null);
+            Ok((json!({"directory":dir,"task_id":task_id,"task_requests":task,"wire_requests":wire,"in_flight_requests":inflight}), task, wire))
+        }).transpose()?
+    } else { None };
+    let has_pending = active.is_some() || interrupted.is_some();
+    let (pending_value, output_task, output_wire) = match pending {
+        Some((value, task, wire)) => (
+            value,
+            Some(task_total.checked_add(task).context("overflow")?),
+            Some(wire_total.checked_add(wire).context("overflow")?),
+        ),
+        None if has_pending => (
+            json!({"directory": active.or_else(|| interrupted.and_then(|i| i.get("directory").and_then(Value::as_str))), "task_id": null, "task_requests": null, "wire_requests": null, "in_flight_requests": null}),
+            None,
+            None,
+        ),
+        None => (Value::Null, Some(task_total), Some(wire_total)),
+    };
+    let status = if completed { "completed" } else if !stop.is_null() { "stopped" } else { "running" };
+    let requests = match (output_task, output_wire) {
+        (Some(task), Some(wire)) => json!({"task_used":task,"wire_used":wire,"task_limit":max_task,"wire_limit":max_wire,"task_remaining":max_task.checked_sub(task),"wire_remaining":max_wire.checked_sub(wire)}),
+        _ => json!({"task_used":null,"wire_used":null,"task_limit":max_task,"wire_limit":max_wire,"task_remaining":null,"wire_remaining":null}),
+    };
+    Ok(json!({"version":1,"status":status,"stop_reason":stop,"iterations":finalized,"pending":pending_value,"requests":requests}))
+}
+
+fn pos(o: &Map<String, Value>, k: &str) -> Result<u64> {
+    let n = o.get(k).and_then(Value::as_u64).ok_or_else(|| anyhow::anyhow!("missing limit {k}"))?;
+    if n == 0 {
+        bail!("nonpositive limit");
+    }
+    Ok(n)
+}
+fn ledger(root: &Path, dir: &str) -> Result<Value> { if !dir.starts_with("iteration-") { bail!("invalid directory") } let p = checked_path(root, &Path::new(dir).join("state/tui-work.json"))?; Ok(serde_json::from_str(&fs::read_to_string(p)?)?) }
+fn pending_ledger(root: &Path, dir: &str) -> Result<Option<Value>> {
+    if !dir.starts_with("iteration-") { bail!("invalid directory") }
+    let rel = Path::new(dir).join("state/tui-work.json");
+    let p = checked_path(root, &rel)?;
+    match fs::read_to_string(p) {
+        Ok(text) => Ok(Some(serde_json::from_str(&text)?)),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+fn ledger_counts(v: &Value) -> Result<(u64,u64,u64)> { let req = v.get("requests").and_then(Value::as_array).context("requests")?; let mut ids=HashSet::new(); let mut task: u64=0; let mut inflight: u64=0; for r in req { let o=r.as_object().context("request")?; let id=o.get("id").filter(|value| !value.is_null()).context("request id")?.to_string(); if !ids.insert(id) { bail!("duplicate request id") } if o.get("charge").and_then(Value::as_str).unwrap_or("task")=="task" { task=task.checked_add(1).context("overflow")?; } if o.get("status").and_then(Value::as_str)==Some("in_flight_or_interrupted") { inflight=inflight.checked_add(1).context("overflow")?; } } Ok((task, req.len() as u64, inflight)) }
