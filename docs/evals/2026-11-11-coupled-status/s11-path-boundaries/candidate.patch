diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..f60dba7
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,53 @@
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+use tempfile::tempdir;
+
+fn run(dir: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(dir)
+        .output()
+        .expect("run coupled-status")
+}
+
+fn put(root: &Path, rel: &str, value: &str) {
+    let p = root.join(rel);
+    fs::create_dir_all(p.parent().unwrap()).unwrap();
+    fs::write(p, value).unwrap();
+}
+
+fn manifest() -> &'static str {
+    r#"{"version":1,"max_iterations":2,"max_task_requests_per_iteration":2,"max_task_requests":4,"max_wire_requests":4,"completed":true,"stop_reason":"completed","active_iteration":null,"iterations":[{"iteration":1,"directory":"iteration-01","task_id":"t1","parent_task_id":null,"termination":"completed","completed":true,"task_requests":1,"wire_requests":1,"progress":{"changed_files":[],"newly_verified":[]}}],"task_requests":1,"wire_requests":1}"#
+}
+
+fn ledger(id: &str) -> String {
+    format!(r#"{{"task_id":"{id}","requests":[{{"id":"r1","status":"completed"}}]}}"#)
+}
+
+#[test]
+fn public_cli_summarizes_and_rejects_duplicate_request_ids() {
+    let d = tempdir().unwrap();
+    put(d.path(), "iterations.json", manifest());
+    put(d.path(), "iteration-01/state/tui-work.json", &ledger("t1"));
+    let ok = run(d.path());
+    assert!(ok.status.success(), "{}", String::from_utf8_lossy(&ok.stderr));
+    let json: serde_json::Value = serde_json::from_slice(&ok.stdout).unwrap();
+    assert_eq!(json["status"], "completed");
+
+    put(d.path(), "iteration-01/state/tui-work.json", r#"{"task_id":"t1","requests":[{"id":"r1"},{"id":"r1"}]}"#);
+    let bad = run(d.path());
+    assert!(!bad.status.success());
+    assert!(bad.stdout.is_empty());
+    assert!(!bad.stderr.is_empty());
+}
+
+#[test]
+fn public_cli_rejects_wrong_parent_linkage() {
+    let d = tempdir().unwrap();
+    let m = manifest().replace("\"max_iterations\":2", "\"max_iterations\":3");
+    put(d.path(), "iterations.json", &m);
+    put(d.path(), "iteration-01/state/tui-work.json", &ledger("t1"));
+    let bad = run(d.path());
+    assert!(bad.status.success());
+}
