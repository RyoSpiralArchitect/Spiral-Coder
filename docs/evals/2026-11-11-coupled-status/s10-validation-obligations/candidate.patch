diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..7f8d8c2
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,56 @@
+use std::fs;
+use std::process::Command;
+use tempfile::tempdir;
+
+fn base() -> (tempfile::TempDir, serde_json::Value) {
+    let root = tempdir().unwrap();
+    let work = serde_json::json!({"task_id":"t1","requests":[{"id":0,"charge":"task","status":"completed"},{"id":1,"charge":"task","status":"completed"},{"id":2,"charge":"transport","status":"completed"}]});
+    fs::create_dir_all(root.path().join("iteration-01/state")).unwrap();
+    fs::write(
+        root.path().join("iteration-01/state/tui-work.json"),
+        serde_json::to_vec(&work).unwrap(),
+    )
+    .unwrap();
+    let manifest = serde_json::json!({"version":1,"max_iterations":6,"max_task_requests_per_iteration":32,"max_task_requests":192,"max_wire_requests":216,"completed":true,"stop_reason":"completed","active_iteration":null,"iterations":[{"iteration":1,"directory":"iteration-01","task_id":"t1","parent_task_id":null,"termination":"completed","completed":true,"task_requests":2,"wire_requests":3,"progress":{"changed_files":[],"newly_verified":[]}}],"task_requests":2,"wire_requests":3});
+    fs::write(
+        root.path().join("iterations.json"),
+        serde_json::to_vec(&manifest).unwrap(),
+    )
+    .unwrap();
+    (root, manifest)
+}
+
+#[test]
+fn completed_record_is_read_only_summary() {
+    let (root, _) = base();
+    let out = Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root.path())
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&out.stdout).unwrap();
+    assert_eq!(value["status"], "completed");
+    assert_eq!(value["requests"]["task_used"], 2);
+}
+
+#[test]
+fn duplicate_request_ids_reject() {
+    let (root, _) = base();
+    let path = root.path().join("iteration-01/state/tui-work.json");
+    let mut work: serde_json::Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+    work["requests"][1]["id"] = serde_json::json!(0);
+    fs::write(path, serde_json::to_vec(&work).unwrap()).unwrap();
+    let out = Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root.path())
+        .output()
+        .unwrap();
+    assert!(!out.status.success());
+    assert!(out.stdout.is_empty());
+    assert!(!out.stderr.is_empty());
+}
