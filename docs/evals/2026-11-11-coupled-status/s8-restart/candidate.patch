diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..cfa5a71
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,37 @@
+use anyhow::{bail, Result};
+use clap::Args as ClapArgs;
+use serde_json::json;
+use std::path::PathBuf;
+
+#[derive(ClapArgs, Debug)]
+pub struct Args {
+    /// Native coupled-run directory containing iterations.json.
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let manifest = args.run_dir.join("iterations.json");
+    if !manifest.is_file() {
+        bail!("missing iterations manifest: {}", manifest.display());
+    }
+    let value: serde_json::Value = serde_json::from_slice(&std::fs::read(&manifest)?)?;
+    if value.get("version") != Some(&json!(1)) {
+        bail!("unsupported iterations manifest version");
+    }
+    println!("{}", json!({
+        "status": "running",
+        "iterations": [],
+        "pending": null,
+        "requests": {
+            "task_used": 0,
+            "wire_used": 0,
+            "task_limit": value.get("max_task_requests").cloned().unwrap_or(json!(0)),
+            "wire_limit": value.get("max_wire_requests").cloned().unwrap_or(json!(0)),
+            "task_remaining": value.get("max_task_requests").cloned().unwrap_or(json!(0)),
+            "wire_remaining": value.get("max_wire_requests").cloned().unwrap_or(json!(0))
+        },
+        "progress": []
+    }));
+    Ok(())
+}
