diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..c6a49ff
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,119 @@
+use serde_json::Value;
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+use tempfile::TempDir;
+
+fn fixture(root: &Path, state: &str) {
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(root)
+        .arg(state)
+        .status()
+        .expect("run fixture");
+    assert!(status.success(), "fixture failed for {state}");
+}
+
+fn run(root: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .expect("run coupled-status")
+}
+
+fn expected(state: &str) -> Value {
+    let output = Command::new("python3")
+        .args(["-S", "-c", "import json; from scripts.status_fixture import expected; print(json.dumps(expected(__import__('sys').argv[1])))"])
+        .arg(state)
+        .output()
+        .expect("read expected fixture");
+    assert!(output.status.success());
+    serde_json::from_slice(&output.stdout).expect("expected JSON")
+}
+
+#[test]
+fn public_cli_matches_native_fixture_states() {
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let temp = TempDir::new().unwrap();
+        let root = temp.path().join(state);
+        fixture(&root, state);
+        let output = run(&root);
+        assert!(
+            output.status.success(),
+            "{state}: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let actual: Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert_eq!(actual, expected(state), "{state}");
+    }
+}
+
+#[test]
+fn duplicate_request_ids_are_rejected_after_valid_baseline() {
+    let temp = TempDir::new().unwrap();
+    fixture(temp.path(), "completed");
+    let baseline = run(temp.path());
+    assert!(baseline.status.success());
+    let ledger = temp.path().join("iteration-01/state/tui-work.json");
+    let mut value: Value = serde_json::from_str(&fs::read_to_string(&ledger).unwrap()).unwrap();
+    let requests = value["requests"].as_array_mut().unwrap();
+    if requests.len() < 2 {
+        let first = requests[0].clone();
+        requests.push(first);
+    }
+    let id = requests[0]["id"].clone();
+    requests[1]["id"] = id;
+    fs::write(&ledger, serde_json::to_vec_pretty(&value).unwrap()).unwrap();
+    let output = run(temp.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn wrong_parent_linkage_is_rejected_after_valid_baseline() {
+    let temp = TempDir::new().unwrap();
+    fixture(temp.path(), "completed");
+    let baseline = run(temp.path());
+    assert!(baseline.status.success());
+    let manifest = temp.path().join("iterations.json");
+    let mut value: Value = serde_json::from_str(&fs::read_to_string(&manifest).unwrap()).unwrap();
+    let rows = value["iterations"].as_array_mut().unwrap();
+    if rows.len() < 2 {
+        panic!("fixture must contain two rows");
+    }
+    rows[1]["parent_task_id"] = Value::String("wrong-parent".into());
+    fs::write(&manifest, serde_json::to_vec_pretty(&value).unwrap()).unwrap();
+    let output = run(temp.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn missing_pending_components_are_unknown() {
+    for missing in [
+        "iteration-02",
+        "iteration-02/state",
+        "iteration-02/state/tui-work.json",
+    ] {
+        let temp = TempDir::new().unwrap();
+        fixture(temp.path(), "running");
+        let target = temp.path().join(missing);
+        if target.is_dir() {
+            fs::remove_dir_all(target).unwrap();
+        } else {
+            fs::remove_file(target).unwrap();
+        }
+        let output = run(temp.path());
+        assert!(
+            output.status.success(),
+            "{missing}: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let actual: Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert!(actual["pending"]["task_requests"].is_null());
+        assert!(actual["requests"]["task_used"].is_null());
+    }
+}
