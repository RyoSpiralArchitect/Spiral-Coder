diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..5ecfed2
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,40 @@
+use anyhow::{Context, Result};
+use std::path::Path;
+
+/// Read-only coupled-run status entry point.
+pub fn run(run_dir: &Path) -> Result<()> {
+    let path = run_dir.join("iterations.json");
+    let bytes = std::fs::read(&path).with_context(|| format!("failed to read {}", path.display()))?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes)
+        .with_context(|| format!("invalid JSON in {}", path.display()))?;
+    let object = value
+        .as_object()
+        .ok_or_else(|| anyhow::anyhow!("iterations manifest must be an object"))?;
+    if object.get("version").and_then(serde_json::Value::as_u64) != Some(1) {
+        anyhow::bail!("unsupported iterations manifest version");
+    }
+    let summary = serde_json::json!({
+        "version": 1,
+        "status": if object.get("completed").and_then(serde_json::Value::as_bool).unwrap_or(false) {
+            "completed"
+        } else if object.get("stop_reason").is_some_and(|v| !v.is_null()) {
+            "stopped"
+        } else {
+            "running"
+        },
+        "stop_reason": object.get("stop_reason").cloned().unwrap_or(serde_json::Value::Null),
+        "completed": object.get("completed").cloned().unwrap_or(serde_json::Value::Bool(false)),
+        "iterations": object.get("iterations").cloned().unwrap_or_else(|| serde_json::json!([])),
+        "pending": serde_json::Value::Null,
+        "requests": serde_json::json!({
+            "task_used": object.get("task_requests").cloned().unwrap_or(serde_json::Value::Null),
+            "wire_used": object.get("wire_requests").cloned().unwrap_or(serde_json::Value::Null),
+            "task_limit": object.get("max_task_requests").cloned().unwrap_or(serde_json::Value::Null),
+            "wire_limit": object.get("max_wire_requests").cloned().unwrap_or(serde_json::Value::Null),
+            "task_remaining": serde_json::Value::Null,
+            "wire_remaining": serde_json::Value::Null
+        })
+    });
+    println!("{}", serde_json::to_string(&summary)?);
+    Ok(())
+}
