diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..476960e
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,107 @@
+use anyhow::{anyhow, Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+#[derive(ClapArgs, Debug, Clone)]
+pub struct Args {
+    /// Native coupled-run directory.
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+fn reject_symlink(path: &Path, root: &Path) -> Result<()> {
+    let rel = path.strip_prefix(root).unwrap_or(path);
+    let mut cur = root.to_path_buf();
+    for component in rel.components() {
+        cur.push(component);
+        if let Ok(meta) = fs::symlink_metadata(&cur) {
+            if meta.file_type().is_symlink() {
+                return Err(anyhow!("symlink is not allowed: {}", cur.display()));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn read_json(path: &Path, root: &Path, required: bool) -> Result<Option<Value>> {
+    reject_symlink(path, root)?;
+    match fs::read_to_string(path) {
+        Ok(s) => Ok(Some(serde_json::from_str(&s).with_context(|| format!("invalid JSON: {}", path.display()))?)),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound && !required => Ok(None),
+        Err(e) => Err(anyhow!("cannot read {}: {e}", path.display())),
+    }
+}
+
+fn u64v(v: &Value, key: &str) -> Result<u64> {
+    v.get(key).and_then(Value::as_u64).ok_or_else(|| anyhow!("missing or invalid {key}"))
+}
+fn strv<'a>(v: &'a Value, key: &str) -> Result<&'a str> {
+    v.get(key).and_then(Value::as_str).ok_or_else(|| anyhow!("missing or invalid {key}"))
+}
+fn opt_str(v: &Value, key: &str) -> Option<String> { v.get(key).and_then(Value::as_str).map(str::to_owned) }
+
+fn ledger(root: &Path, directory: &str) -> Result<Value> {
+    if directory.contains('/') || directory.contains('\\') || directory == "." || directory == ".." {
+        return Err(anyhow!("invalid iteration directory"));
+    }
+    read_json(&root.join(directory).join("state/tui-work.json"), root, true)?.ok_or_else(|| anyhow!("missing ledger"))
+}
+
+fn counts(work: &Value) -> Result<(u64, u64, u64)> {
+    let requests = work.get("requests").and_then(Value::as_array).ok_or_else(|| anyhow!("ledger requests must be an array"))?;
+    let mut ids = HashSet::new(); let mut task = 0u64; let mut inflight = 0u64;
+    for r in requests {
+        let id = r.get("id").ok_or_else(|| anyhow!("request missing id"))?;
+        if !ids.insert(id.to_string()) { return Err(anyhow!("duplicate request id")); }
+        if r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task" { task = task.checked_add(1).ok_or_else(|| anyhow!("overflow"))?; }
+        if r.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") { inflight += 1; }
+    }
+    Ok((task, requests.len() as u64, inflight))
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let root = if args.run_dir.is_absolute() { args.run_dir } else { std::env::current_dir()?.join(args.run_dir) };
+    let manifest_path = root.join("iterations.json");
+    let m = read_json(&manifest_path, &root, true)?.ok_or_else(|| anyhow!("missing manifest"))?;
+    if u64v(&m, "version")? != 1 { return Err(anyhow!("unsupported manifest version")); }
+    let max_iter = u64v(&m, "max_iterations")?; let per = u64v(&m, "max_task_requests_per_iteration")?;
+    if max_iter == 0 || per == 0 { return Err(anyhow!("limits must be positive")); }
+    let max_task = u64v(&m, "max_task_requests")?; let max_wire = u64v(&m, "max_wire_requests")?;
+    if max_task != max_iter.checked_mul(per).ok_or_else(|| anyhow!("overflow"))? || max_wire < max_task { return Err(anyhow!("invalid limits")); }
+    let rows = m.get("iterations").and_then(Value::as_array).ok_or_else(|| anyhow!("iterations must be an array"))?;
+    if rows.len() as u64 > max_iter { return Err(anyhow!("too many iterations")); }
+    let mut seen = HashSet::new(); let mut output_rows = Vec::new(); let mut final_task=0u64; let mut final_wire=0u64; let mut last_task: Option<String>=None;
+    for (i,row) in rows.iter().enumerate() {
+        let n=(i+1) as u64; if u64v(row,"iteration")? != n { return Err(anyhow!("iteration order mismatch")); }
+        let dir=strv(row,"directory")?; if dir != format!("iteration-{n:02}") { return Err(anyhow!("directory mismatch")); }
+        let task_id=strv(row,"task_id")?; if task_id.is_empty() || !seen.insert(task_id.to_owned()) { return Err(anyhow!("duplicate task id")); }
+        let parent=row.get("parent_task_id"); if n==1 { if parent != Some(&Value::Null) { return Err(anyhow!("first parent must be null")); } } else if parent.and_then(Value::as_str) != last_task.as_deref() { return Err(anyhow!("parent linkage mismatch")); }
+        let work=ledger(&root,dir)?; if strv(&work,"task_id")? != task_id { return Err(anyhow!("task id mismatch")); }
+        let (task,wire,_)=counts(&work)?; if task != u64v(row,"task_requests")? || wire != u64v(row,"wire_requests")? || task > per { return Err(anyhow!("ledger counts mismatch")); }
+        let term=strv(row,"termination")?; if row.get("completed").and_then(Value::as_bool) != Some(term=="completed") { return Err(anyhow!("completion mismatch")); }
+        if term=="completed" && i+1 != rows.len() { return Err(anyhow!("nonfinal completed row")); }
+        let progress=row.get("progress").ok_or_else(|| anyhow!("missing progress"))?;
+        output_rows.push(json!({"iteration":n,"task_id":task_id,"termination":term,"task_requests":task,"wire_requests":wire,"changed_files":progress.get("changed_files").cloned().unwrap_or(json!([])),"newly_verified":progress.get("newly_verified").cloned().unwrap_or(json!([]))}));
+        final_task=final_task.checked_add(task).ok_or_else(|| anyhow!("overflow"))?; final_wire=final_wire.checked_add(wire).ok_or_else(|| anyhow!("overflow"))?; last_task=Some(task_id.to_owned());
+    }
+    let active=m.get("active_iteration").and_then(Value::as_str); let interrupted=m.get("interrupted_iteration");
+    if active.is_some() && interrupted.is_some() { return Err(anyhow!("two pending iterations")); }
+    let pending_dir=active.map(str::to_owned).or_else(|| interrupted.and_then(|v| v.get("directory")).and_then(Value::as_str).map(str::to_owned));
+    let mut pending=None; let mut task_used=final_task; let mut wire_used=final_wire;
+    if let Some(dir)=pending_dir { let expected=format!("iteration-{:02}",rows.len()+1); if dir != expected { return Err(anyhow!("pending directory mismatch")); }
+        let p=read_json(&root.join(&dir).join("state/tui-work.json"),&root,false)?; if let Some(w)=p { let id=strv(&w,"task_id")?; if seen.contains(id) { return Err(anyhow!("pending task reused")); } let (t,wr,inf)=counts(&w)?; pending=Some(json!({"directory":dir,"task_id":id,"task_requests":t,"wire_requests":wr,"in_flight_requests":inf})); if let Some(meta)=interrupted { if meta.get("task_requests") != Some(&json!(t)) || meta.get("wire_requests") != Some(&json!(wr)) { return Err(anyhow!("pending counts mismatch")); } } task_used=task_used.checked_add(t).ok_or_else(|| anyhow!("overflow"))?; wire_used=wire_used.checked_add(wr).ok_or_else(|| anyhow!("overflow"))?; } else { pending=Some(json!({"directory":dir,"task_id":null,"task_requests":null,"wire_requests":null,"in_flight_requests":null})); }
+    }
+    if let Some(meta)=interrupted { if pending.as_ref().is_some_and(|p| p.get("task_requests").is_some_and(Value::is_null)) { if !meta.get("task_requests").is_some_and(Value::is_null) || !meta.get("wire_requests").is_some_and(Value::is_null) { return Err(anyhow!("unknown pending counts mismatch")); } } }
+    if m.get("task_requests").and_then(Value::as_u64) != Some(task_used) || m.get("wire_requests").and_then(Value::as_u64) != Some(wire_used) { return Err(anyhow!("manifest totals mismatch")); }
+    let stop=m.get("stop_reason").cloned().unwrap_or(Value::Null); let completed=m.get("completed").and_then(Value::as_bool).unwrap_or(false);
+    if completed != (stop.as_str()==Some("completed")) { return Err(anyhow!("manifest completion mismatch")); }
+    if completed && (pending.is_some() || output_rows.last().and_then(|r|r.get("termination")).and_then(Value::as_str)!=Some("completed")) { return Err(anyhow!("invalid completed manifest")); }
+    let unknown=pending.as_ref().is_some_and(|p| p.get("task_requests").is_some_and(Value::is_null));
+    let task_used_out=if unknown {Value::Null}else{json!(task_used)}; let wire_used_out=if unknown {Value::Null}else{json!(wire_used)};
+    let status=if completed {"completed"} else if !stop.is_null() {"stopped"} else {"running"};
+    let out=json!({"version":1,"status":status,"stop_reason":stop,"iterations":output_rows,"pending":pending,"requests":{"task_used":task_used_out,"wire_used":wire_used_out,"task_limit":max_task,"wire_limit":max_wire,"task_remaining":if unknown {Value::Null}else{json!(max_task-task_used)},"wire_remaining":if unknown {Value::Null}else{json!(max_wire-wire_used)}}});
+    println!("{}",serde_json::to_string(&out)?); Ok(())
+}
