diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..2a35734
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,139 @@
+use anyhow::{bail, Context, Result};
+use clap::Args;
+use serde_json::{json, Value};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+#[derive(Args, Debug, Clone)]
+pub struct CoupledStatusArgs {
+    #[arg(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+pub fn run(args: CoupledStatusArgs) -> Result<()> {
+    let root = args.run_dir;
+    let manifest: Value = read_json(&root.join("iterations.json"))?;
+    if manifest.get("version").and_then(Value::as_u64) != Some(1) {
+        bail!("unsupported iterations manifest version");
+    }
+    let rows = manifest
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations missing")?;
+    let mut out_rows = Vec::new();
+    let mut task_used = 0u64;
+    let mut wire_used = 0u64;
+    for row in rows {
+        let dir = row
+            .get("directory")
+            .and_then(Value::as_str)
+            .context("row directory missing")?;
+        let work = read_json(&root.join(dir).join("state/tui-work.json"))?;
+        let requests = work
+            .get("requests")
+            .and_then(Value::as_array)
+            .context("requests missing")?;
+        let (task, wire) = counts(requests)?;
+        if row.get("task_requests").and_then(Value::as_u64) != Some(task)
+            || row.get("wire_requests").and_then(Value::as_u64) != Some(wire)
+        {
+            bail!("row counts do not match ledger");
+        }
+        task_used = task_used.checked_add(task).context("task overflow")?;
+        wire_used = wire_used.checked_add(wire).context("wire overflow")?;
+        let progress = row.get("progress").context("progress missing")?;
+        out_rows.push(json!({"iteration": row.get("iteration"), "task_id": row.get("task_id"), "termination": row.get("termination"), "task_requests": task, "wire_requests": wire, "changed_files": progress.get("changed_files").cloned().unwrap_or(json!([])), "newly_verified": progress.get("newly_verified").cloned().unwrap_or(json!([]))}));
+    }
+    if manifest.get("active_iteration").is_none() && manifest.get("interrupted_iteration").is_none()
+    {
+        if manifest.get("task_requests").and_then(Value::as_u64) != Some(task_used)
+            || manifest.get("wire_requests").and_then(Value::as_u64) != Some(wire_used)
+        {
+            bail!("manifest totals do not match finalized ledgers");
+        }
+    }
+    let pending_dir = manifest
+        .get("active_iteration")
+        .and_then(Value::as_str)
+        .or_else(|| {
+            manifest
+                .get("interrupted_iteration")
+                .and_then(|x| x.get("directory"))
+                .and_then(Value::as_str)
+        });
+    let pending = if let Some(dir) = pending_dir {
+        let p = root.join(dir).join("state/tui-work.json");
+        if p.exists() {
+            let w = read_json(&p)?;
+            let r = w
+                .get("requests")
+                .and_then(Value::as_array)
+                .context("pending requests missing")?;
+            let (t, wire) = counts(r)?;
+            let task_id = w.get("task_id").cloned().unwrap_or(Value::Null);
+            task_used = task_used.checked_add(t).context("task overflow")?;
+            wire_used = wire_used.checked_add(wire).context("wire overflow")?;
+            Some(
+                json!({"directory":dir,"task_id":task_id,"task_requests":t,"wire_requests":wire,"in_flight_requests":r.iter().filter(|x| x.get("status").and_then(Value::as_str)==Some("in_flight_or_interrupted")).count()}),
+            )
+        } else {
+            Some(
+                json!({"directory":dir,"task_id":null,"task_requests":null,"wire_requests":null,"in_flight_requests":null}),
+            )
+        }
+    } else {
+        None
+    };
+    let stop = manifest.get("stop_reason").cloned().unwrap_or(Value::Null);
+    let declared_task = manifest.get("task_requests").and_then(Value::as_u64);
+    let declared_wire = manifest.get("wire_requests").and_then(Value::as_u64);
+    if pending.is_none() && (declared_task != Some(task_used) || declared_wire != Some(wire_used)) {
+        bail!("manifest totals do not match ledgers");
+    }
+    let status = if manifest.get("completed").and_then(Value::as_bool) == Some(true) {
+        "completed"
+    } else if !stop.is_null() {
+        "stopped"
+    } else {
+        "running"
+    };
+    let tl = manifest
+        .get("max_task_requests")
+        .and_then(Value::as_u64)
+        .context("task limit missing")?;
+    let wl = manifest
+        .get("max_wire_requests")
+        .and_then(Value::as_u64)
+        .context("wire limit missing")?;
+    println!(
+        "{}",
+        json!({"version":1,"status":status,"stop_reason":stop,"iterations":out_rows,"pending":pending,"requests":{"task_used": if pending.as_ref().is_some_and(|p|p.get("task_requests").is_some_and(Value::is_null)){Value::Null}else{json!(task_used)},"wire_used":if pending.as_ref().is_some_and(|p|p.get("wire_requests").is_some_and(Value::is_null)){Value::Null}else{json!(wire_used)},"task_limit":tl,"wire_limit":wl,"task_remaining":if pending.as_ref().is_some_and(|p|p.get("task_requests").is_some_and(Value::is_null)){Value::Null}else{json!(tl-task_used)},"wire_remaining":if pending.as_ref().is_some_and(|p|p.get("wire_requests").is_some_and(Value::is_null)){Value::Null}else{json!(wl-wire_used)}}})
+    );
+    Ok(())
+}
+
+fn read_json(path: &Path) -> Result<Value> {
+    Ok(
+        serde_json::from_slice(
+            &fs::read(path).with_context(|| format!("read {}", path.display()))?,
+        )
+        .context("malformed JSON")?,
+    )
+}
+fn counts(requests: &[Value]) -> Result<(u64, u64)> {
+    let mut ids = std::collections::HashSet::new();
+    let mut t = 0u64;
+    for r in requests {
+        let id = r.get("id").context("request id missing")?;
+        if id.is_null() || !ids.insert(id.to_string()) {
+            bail!("duplicate request id")
+        }
+        if r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task" {
+            t = t.checked_add(1).context("task overflow")?;
+        }
+    }
+    let wire = u64::try_from(requests.len()).context("wire overflow")?;
+    Ok((t, wire))
+}
