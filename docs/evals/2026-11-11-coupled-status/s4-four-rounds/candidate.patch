diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..0895547
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,254 @@
+use anyhow::{Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::Value;
+use std::path::PathBuf;
+
+#[derive(ClapArgs, Debug)]
+pub struct Args {
+    #[arg(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let root = args
+        .run_dir
+        .canonicalize()
+        .context("resolve run directory")?;
+    let manifest_path = root.join("iterations.json");
+    let bytes = std::fs::read(&manifest_path)
+        .with_context(|| format!("read {}", manifest_path.display()))?;
+    let value: Value = serde_json::from_slice(&bytes).context("parse iterations.json")?;
+    let manifest = value.as_object().context("manifest must be an object")?;
+    anyhow::ensure!(
+        manifest.get("version").and_then(Value::as_u64) == Some(1),
+        "unsupported manifest version"
+    );
+    let max_iterations = manifest
+        .get("max_iterations")
+        .and_then(Value::as_u64)
+        .context("max_iterations")?;
+    let per_iteration = manifest
+        .get("max_task_requests_per_iteration")
+        .and_then(Value::as_u64)
+        .context("max_task_requests_per_iteration")?;
+    let max_task = manifest
+        .get("max_task_requests")
+        .and_then(Value::as_u64)
+        .context("max_task_requests")?;
+    let max_wire = manifest
+        .get("max_wire_requests")
+        .and_then(Value::as_u64)
+        .context("max_wire_requests")?;
+    anyhow::ensure!(
+        max_iterations > 0
+            && per_iteration > 0
+            && max_task
+                == max_iterations
+                    .checked_mul(per_iteration)
+                    .context("limit overflow")?
+            && max_wire >= max_task,
+        "invalid request limits"
+    );
+    let rows = manifest
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations must be an array")?;
+    anyhow::ensure!(rows.len() as u64 <= max_iterations, "too many iterations");
+    let mut ids = std::collections::HashSet::new();
+    let mut parent = None::<String>;
+    let mut task_used = 0u64;
+    let mut wire_used = 0u64;
+    let mut iterations = Vec::new();
+    for (index, row_value) in rows.iter().enumerate() {
+        let row = row_value
+            .as_object()
+            .context("iteration row must be an object")?;
+        let number = row
+            .get("iteration")
+            .and_then(Value::as_u64)
+            .context("iteration number")?;
+        let directory = row
+            .get("directory")
+            .and_then(Value::as_str)
+            .context("iteration directory")?;
+        anyhow::ensure!(
+            number == index as u64 + 1 && directory == format!("iteration-{number:02}"),
+            "invalid iteration ordering"
+        );
+        let task_id = row
+            .get("task_id")
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+            .context("task_id")?;
+        anyhow::ensure!(ids.insert(task_id.to_owned()), "duplicate task_id");
+        let expected_parent = row.get("parent_task_id").cloned().unwrap_or(Value::Null);
+        anyhow::ensure!(
+            expected_parent == parent.clone().map(Value::String).unwrap_or(Value::Null),
+            "invalid parent linkage"
+        );
+        let ledger_path = root.join(directory).join("state/tui-work.json");
+        let ledger_bytes = std::fs::read(&ledger_path)
+            .with_context(|| format!("read {}", ledger_path.display()))?;
+        let ledger: Value = serde_json::from_slice(&ledger_bytes).context("parse ledger")?;
+        let ledger_obj = ledger.as_object().context("ledger must be an object")?;
+        anyhow::ensure!(
+            ledger_obj.get("task_id").and_then(Value::as_str) == Some(task_id),
+            "task id does not match ledger"
+        );
+        let requests = ledger_obj
+            .get("requests")
+            .and_then(Value::as_array)
+            .context("ledger requests")?;
+        let wire = requests.len() as u64;
+        let task = requests
+            .iter()
+            .filter(|r| r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task")
+            .count() as u64;
+        anyhow::ensure!(
+            row.get("task_requests").and_then(Value::as_u64) == Some(task)
+                && row.get("wire_requests").and_then(Value::as_u64) == Some(wire)
+                && task <= per_iteration,
+            "ledger counts mismatch"
+        );
+        task_used = task_used.checked_add(task).context("task usage overflow")?;
+        wire_used = wire_used.checked_add(wire).context("wire usage overflow")?;
+        let progress = row.get("progress").and_then(Value::as_object);
+        iterations.push(serde_json::json!({"iteration":number,"task_id":task_id,"termination":row.get("termination").cloned().unwrap_or(Value::Null),"task_requests":task,"wire_requests":wire,"changed_files":progress.and_then(|p| p.get("changed_files")).cloned().unwrap_or_else(|| Value::Array(vec![])),"newly_verified":progress.and_then(|p| p.get("newly_verified")).cloned().unwrap_or_else(|| Value::Array(vec![]))}));
+        parent = Some(task_id.to_owned());
+    }
+    let pending_name = manifest
+        .get("active_iteration")
+        .and_then(Value::as_str)
+        .or_else(|| {
+            manifest
+                .get("interrupted_iteration")
+                .and_then(Value::as_object)
+                .and_then(|x| x.get("directory"))
+                .and_then(Value::as_str)
+        });
+    let pending = if let Some(directory) = pending_name {
+        let path = root.join(directory).join("state/tui-work.json");
+        match std::fs::read(&path) {
+            Ok(data) => {
+                let ledger: Value =
+                    serde_json::from_slice(&data).context("parse pending ledger")?;
+                let obj = ledger.as_object().context("pending ledger object")?;
+                let req = obj
+                    .get("requests")
+                    .and_then(Value::as_array)
+                    .context("pending requests")?;
+                let task = req
+                    .iter()
+                    .filter(|r| r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task")
+                    .count() as u64;
+                let wire = req.len() as u64;
+                let inflight = req
+                    .iter()
+                    .filter(|r| {
+                        r.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted")
+                    })
+                    .count() as u64;
+                task_used = task_used.checked_add(task).context("task usage overflow")?;
+                wire_used = wire_used.checked_add(wire).context("wire usage overflow")?;
+                Some(
+                    serde_json::json!({"directory": directory, "task_id": obj.get("task_id").cloned().unwrap_or(Value::Null), "task_requests": task, "wire_requests": wire, "in_flight_requests": inflight}),
+                )
+            }
+            Err(_) => Some(
+                serde_json::json!({"directory": directory, "task_id": null, "task_requests": null, "wire_requests": null, "in_flight_requests": null}),
+            ),
+        }
+    } else {
+        None
+    };
+    let stop_reason = manifest.get("stop_reason").cloned().unwrap_or(Value::Null);
+    let manifest_task = manifest
+        .get("task_requests")
+        .cloned()
+        .unwrap_or(Value::Null);
+    let manifest_wire = manifest
+        .get("wire_requests")
+        .cloned()
+        .unwrap_or(Value::Null);
+    let interrupted = stop_reason.as_str() == Some("interrupted");
+    if interrupted {
+        if let (Some(task), Some(wire)) = (manifest_task.as_u64(), manifest_wire.as_u64()) {
+            anyhow::ensure!(
+                task == task_used && wire == wire_used,
+                "manifest totals mismatch"
+            );
+        } else {
+            anyhow::ensure!(
+                manifest_task.is_null() && manifest_wire.is_null(),
+                "manifest totals must both be known or unknown"
+            );
+        }
+    } else {
+        anyhow::ensure!(
+            manifest_task.as_u64()
+                == Some(
+                    task_used
+                        - pending
+                            .as_ref()
+                            .and_then(|p| p.get("task_requests"))
+                            .and_then(Value::as_u64)
+                            .unwrap_or(0)
+                ),
+            "manifest totals mismatch"
+        );
+        anyhow::ensure!(
+            manifest_wire.as_u64()
+                == Some(
+                    wire_used
+                        - pending
+                            .as_ref()
+                            .and_then(|p| p.get("wire_requests"))
+                            .and_then(Value::as_u64)
+                            .unwrap_or(0)
+                ),
+            "manifest totals mismatch"
+        );
+    }
+    if let Some(task) = manifest_task.as_u64() {
+        anyhow::ensure!(task <= max_task, "aggregate usage exceeds limits");
+    }
+    if let Some(wire) = manifest_wire.as_u64() {
+        anyhow::ensure!(wire <= max_wire, "aggregate usage exceeds limits");
+    }
+    let status = if manifest.get("completed").and_then(Value::as_bool) == Some(true) {
+        "completed"
+    } else if manifest
+        .get("active_iteration")
+        .and_then(Value::as_str)
+        .is_some()
+    {
+        "running"
+    } else {
+        "stopped"
+    };
+    let task_unknown = pending
+        .as_ref()
+        .and_then(|p| p.get("task_requests"))
+        .map(|v| v.is_null())
+        .unwrap_or(false);
+    let wire_unknown = pending
+        .as_ref()
+        .and_then(|p| p.get("wire_requests"))
+        .map(|v| v.is_null())
+        .unwrap_or(false);
+    let task_value = if task_unknown {
+        Value::Null
+    } else {
+        Value::from(task_used)
+    };
+    let wire_value = if wire_unknown {
+        Value::Null
+    } else {
+        Value::from(wire_used)
+    };
+    println!(
+        "{}",
+        serde_json::json!({"version":1,"status":status,"stop_reason":stop_reason,"iterations":iterations,"pending":pending.unwrap_or(Value::Null),"requests":{"task_used":task_value,"wire_used":wire_value,"task_limit":max_task,"wire_limit":max_wire,"task_remaining":task_value.as_u64().map(|v| Value::from(max_task-v)).unwrap_or(Value::Null),"wire_remaining":wire_value.as_u64().map(|v| Value::from(max_wire-v)).unwrap_or(Value::Null)}})
+    );
+    Ok(())
+}
