@@ -0,0 +1,58 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{diagnostics, load_spec, resolve_path, TuiReplayCase};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub fn run(args: crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let base_root = args
+        .tool_root
+        .clone()
+        .or_else(|| cwd.to_str().map(str::to_owned))
+        .unwrap_or_else(|| ".".to_string());
+    let base_root_path = PathBuf::from(&base_root);
+    let spec_path = resolve_path(&base_root_path, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = super::select_cases(
+        &spec.cases,
+        args.filter.as_deref(),
+        args.max_cases,
+        &spec_path,
+        &base_root_path,
+    )?;
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+#[allow(dead_code)]
+fn _case_shape(case: &TuiReplayCase) -> CatalogCase {
+    CatalogCase {
+        id: case.id.clone(),
+        tags: case.tags.clone(),
+    }
+}
