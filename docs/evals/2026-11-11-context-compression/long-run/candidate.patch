+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,79 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{load_spec, resolve_path, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub(crate) fn run(args: crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let root = args
+        .tool_root
+        .clone()
+        .or_else(|| cwd.to_str().map(str::to_owned))
+        .unwrap_or_else(|| ".".to_owned());
+    let root_path = PathBuf::from(root);
+    let spec_path = resolve_path(&root_path, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select(&spec, args.filter.as_deref(), args.max_cases);
+    if selected.is_empty() {
+        return Err(super::diagnostics::empty_selection(
+            &spec_path,
+            &root_path,
+            args.filter.as_deref(),
+            &spec.cases,
+        ));
+    }
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+fn select(
+    spec: &TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<TuiReplayCase> {
+    let filter = filter.map(|value| value.to_ascii_lowercase());
+    let mut selected = spec
+        .cases
+        .iter()
+        .filter(|case| match filter.as_deref() {
+            Some(filter) => {
+                case.id.to_ascii_lowercase().contains(filter)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(filter))
+            }
+            None => true,
+        })
+        .cloned()
+        .collect::<Vec<_>>();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
