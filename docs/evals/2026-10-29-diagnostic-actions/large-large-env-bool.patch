--- a/settings.py
+++ b/settings.py
@@ -4,4 +4,11 @@
 def parse_bool(value, default=False):
     if value is None:
         return default
-    return bool(value)
+    normalized = value.strip().lower()
+    if not normalized:
+        return default
+    if normalized in ("true", "1", "yes", "on"):
+        return True
+    if normalized in ("false", "0", "no", "off"):
+        return False
+    raise ValueError(f"invalid boolean setting: {value!r}")
