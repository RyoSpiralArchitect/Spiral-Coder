@@ -0,0 +1,221 @@
+use anyhow::{bail, Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::path::Path;
+use std::path::PathBuf;
+
+#[derive(ClapArgs, Debug, Clone)]
+pub struct Args {
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+fn read_json(path: &Path) -> Result<Value> {
+    let data = std::fs::read(path).with_context(|| format!("read {}", path.display()))?;
+    serde_json::from_slice(&data).with_context(|| format!("parse {}", path.display()))
+}
+
+fn valid_directory(directory: &str) -> bool {
+    directory.starts_with("iteration-")
+        && directory.len() == 12
+        && directory[10..].chars().all(|c| c.is_ascii_digit())
+}
+
+fn reject_symlink_components(root: &Path, path: &Path) -> Result<()> {
+    let relative = path
+        .strip_prefix(root)
+        .context("path outside run directory")?;
+    let mut current = root.to_path_buf();
+    for component in relative.components() {
+        current.push(component.as_os_str());
+        if std::fs::symlink_metadata(&current)
+            .map(|metadata| metadata.file_type().is_symlink())
+            .unwrap_or(false)
+        {
+            bail!("symlink in status path")
+        }
+        if !current.exists() {
+            break;
+        }
+    }
+    Ok(())
+}
+
+fn work(root: &Path, directory: &str) -> Result<Value> {
+    if !valid_directory(directory) || directory.contains("..") {
+        bail!("invalid iteration directory")
+    }
+    let path = root.join(directory).join("state/tui-work.json");
+    reject_symlink_components(root, &path)?;
+    read_json(&path)
+}
+
+fn counts(state: &Value) -> Result<(u64, u64, u64)> {
+    let requests = state
+        .get("requests")
+        .and_then(Value::as_array)
+        .context("requests")?;
+    let mut ids = HashSet::new();
+    let mut task = 0u64;
+    let mut inflight = 0u64;
+    for request in requests {
+        let id = request
+            .get("id")
+            .and_then(Value::as_u64)
+            .context("request id")?;
+        if !ids.insert(id) {
+            bail!("duplicate request id")
+        }
+        if request
+            .get("charge")
+            .and_then(Value::as_str)
+            .unwrap_or("task")
+            == "task"
+        {
+            task = task.checked_add(1).context("task request overflow")?;
+        }
+        if request.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") {
+            inflight = inflight.checked_add(1).context("in-flight overflow")?;
+        }
+    }
+    Ok((task, requests.len() as u64, inflight))
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let root = if args.run_dir.is_absolute() {
+        args.run_dir
+    } else {
+        std::env::current_dir()?.join(args.run_dir)
+    };
+    let manifest = read_json(&root.join("iterations.json"))?;
+    if manifest.get("version").and_then(Value::as_u64) != Some(1) {
+        anyhow::bail!("unsupported iterations manifest version");
+    }
+    let rows = manifest
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations")?;
+    let mut task_total = 0u64;
+    let mut wire_total = 0u64;
+    let mut task_ids: HashSet<String> = HashSet::new();
+    let mut output_rows: Vec<Value> = Vec::new();
+    for (index, row) in rows.iter().enumerate() {
+        let directory = row
+            .get("directory")
+            .and_then(Value::as_str)
+            .context("directory")?;
+        if directory != format!("iteration-{:02}", index + 1) {
+            bail!("iteration order")
+        }
+        let task_id = row
+            .get("task_id")
+            .and_then(Value::as_str)
+            .context("task_id")?;
+        if task_id.is_empty() || !task_ids.insert(task_id.to_owned()) {
+            bail!("duplicate task id")
+        }
+        let parent = row.get("parent_task_id");
+        let expected_parent = if index == 0 {
+            None
+        } else {
+            Some(
+                output_rows[index - 1]["task_id"]
+                    .as_str()
+                    .context("previous task id")?,
+            )
+        };
+        if parent != Some(&Value::Null) && parent.and_then(Value::as_str) != expected_parent {
+            bail!("parent task linkage")
+        }
+        let state = work(&root, directory)?;
+        if state.get("task_id").and_then(Value::as_str) != Some(task_id) {
+            bail!("task identity")
+        }
+        let (task, wire, _) = counts(&state)?;
+        if row.get("task_requests").and_then(Value::as_u64) != Some(task)
+            || row.get("wire_requests").and_then(Value::as_u64) != Some(wire)
+        {
+            bail!("row counts")
+        }
+        task_total = task_total.checked_add(task).context("task overflow")?;
+        wire_total = wire_total.checked_add(wire).context("wire overflow")?;
+        let progress = row.get("progress").cloned().unwrap_or_else(|| json!({}));
+        output_rows.push(
+            json!({"iteration": row.get("iteration"), "task_id": task_id,
+            "termination": row.get("termination"), "task_requests": task, "wire_requests": wire,
+            "changed_files": progress.get("changed_files").cloned().unwrap_or(json!([])),
+            "newly_verified": progress.get("newly_verified").cloned().unwrap_or(json!([]))}),
+        );
+    }
+    let active = manifest.get("active_iteration").and_then(Value::as_str);
+    let interrupted = manifest.get("interrupted_iteration");
+    if active.is_some() && interrupted.is_some() {
+        bail!("active and interrupted both present")
+    }
+    let pending = active.or_else(|| interrupted.and_then(|v| v.get("directory").and_then(Value::as_str))).map(|directory| {
+        let path = root.join(directory).join("state/tui-work.json");
+        reject_symlink_components(&root, &path)?;
+        if !path.exists() { return Ok(json!({"directory": directory, "task_id": null, "task_requests": null, "wire_requests": null, "in_flight_requests": null})); }
+        let state = read_json(&path)?;
+        let (task, wire, inflight) = counts(&state)?;
+        let id = state.get("task_id").and_then(Value::as_str).context("pending task_id")?.to_owned();
+        if !task_ids.insert(id.clone()) { bail!("duplicate pending task id") }
+        Ok(json!({"directory": directory, "task_id": id, "task_requests": task, "wire_requests": wire, "in_flight_requests": inflight}))
+    }).transpose()?;
+    let pending_task = pending
+        .as_ref()
+        .and_then(|v| v.get("task_requests").and_then(Value::as_u64));
+    let pending_wire = pending
+        .as_ref()
+        .and_then(|v| v.get("wire_requests").and_then(Value::as_u64));
+    let task_used = if pending.is_some() {
+        pending_task.map(|v| task_total + v)
+    } else {
+        Some(task_total)
+    };
+    let wire_used = if pending.is_some() {
+        pending_wire.map(|v| wire_total + v)
+    } else {
+        Some(wire_total)
+    };
+    let manifest_task = manifest.get("task_requests").and_then(Value::as_u64);
+    let manifest_wire = manifest.get("wire_requests").and_then(Value::as_u64);
+    let interrupted_run = interrupted.is_some();
+    let expected_task = if interrupted_run {
+        task_used
+    } else {
+        Some(task_total)
+    };
+    let expected_wire = if interrupted_run {
+        wire_used
+    } else {
+        Some(wire_total)
+    };
+    if manifest_task != expected_task || manifest_wire != expected_wire {
+        bail!("manifest counts")
+    }
+    let stop = manifest.get("stop_reason").cloned().unwrap_or(Value::Null);
+    let status = if manifest.get("completed").and_then(Value::as_bool) == Some(true) {
+        "completed"
+    } else if !stop.is_null() {
+        "stopped"
+    } else {
+        "running"
+    };
+    let task_limit = manifest
+        .get("max_task_requests")
+        .and_then(Value::as_u64)
+        .context("task limit")?;
+    let wire_limit = manifest
+        .get("max_wire_requests")
+        .and_then(Value::as_u64)
+        .context("wire limit")?;
+    let output = json!({"version": 1, "status": status, "stop_reason": stop, "iterations": output_rows,
+        "pending": pending, "requests": {"task_used": task_used, "wire_used": wire_used,
+        "task_limit": task_limit, "wire_limit": wire_limit,
+        "task_remaining": task_used.map(|v| task_limit.saturating_sub(v)),
+        "wire_remaining": wire_used.map(|v| wire_limit.saturating_sub(v))}});
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
