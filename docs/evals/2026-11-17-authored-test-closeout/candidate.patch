diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..c9fd24d
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,128 @@
+use serde_json::Value;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+fn fixture(state: &str) -> Result<(tempfile::TempDir, Value), Box<dyn std::error::Error>> {
+    let dir = tempfile::tempdir()?;
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(dir.path())
+        .arg(state)
+        .status()?;
+    assert!(status.success());
+    let manifest: Value = serde_json::from_slice(&fs::read(dir.path().join("iterations.json"))?)?;
+    Ok((dir, manifest))
+}
+
+fn cli(root: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .expect("run coupled-status")
+}
+
+fn assert_success(root: &Path) -> Value {
+    let output = cli(root);
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(!output.stdout.is_empty());
+    serde_json::from_slice(&output.stdout).expect("status JSON")
+}
+
+fn assert_failure(root: &Path) {
+    let output = cli(root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn fixture_states_are_read_only_and_have_expected_pending_usage() -> TestResult {
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let (dir, expected) = fixture(state)?;
+        let before = fs::read(dir.path().join("iterations.json"))?;
+        let actual = assert_success(dir.path());
+        let expected_status = Command::new("python3")
+            .args(["-S", "-c", "import json,sys; from scripts.status_fixture import expected; print(json.dumps(expected(sys.argv[1])))", state])
+            .output()?;
+        assert!(expected_status.status.success());
+        let expected_output: Value = serde_json::from_slice(&expected_status.stdout)?;
+        assert_eq!(actual, expected_output);
+        assert_eq!(before, fs::read(dir.path().join("iterations.json"))?);
+        assert_eq!(expected["version"], 1);
+    }
+    Ok(())
+}
+
+#[test]
+fn duplicate_request_id_is_rejected_after_unchanged_control() -> TestResult {
+    let (dir, _) = fixture("completed")?;
+    assert_success(dir.path());
+    let path = dir.path().join("iteration-01/state/tui-work.json");
+    let mut state: Value = serde_json::from_slice(&fs::read(&path)?)?;
+    let id = state["requests"][0]["id"].clone();
+    state["requests"][1]["id"] = id;
+    fs::write(&path, serde_json::to_vec_pretty(&state)?)?;
+    assert_failure(dir.path());
+    Ok(())
+}
+
+#[test]
+fn wrong_parent_linkage_is_rejected_after_unchanged_control() -> TestResult {
+    let (dir, _) = fixture("completed")?;
+    assert_success(dir.path());
+    let path = dir.path().join("iterations.json");
+    let mut manifest: Value = serde_json::from_slice(&fs::read(&path)?)?;
+    manifest["iterations"][0]["parent_task_id"] = Value::String("wrong-parent".into());
+    fs::write(&path, serde_json::to_vec_pretty(&manifest)?)?;
+    assert_failure(dir.path());
+    Ok(())
+}
+
+#[test]
+fn absent_pending_components_are_unknown_but_malformed_existing_data_fails() -> TestResult {
+    let (dir, _) = fixture("unknown")?;
+    assert_success(dir.path());
+    let output = assert_success(dir.path());
+    assert!(output["pending"]["task_requests"].is_null());
+    fs::create_dir_all(dir.path().join("iteration-02/state"))?;
+    fs::write(dir.path().join("iteration-02/state/tui-work.json"), b"{")?;
+    assert_failure(dir.path());
+    Ok(())
+}
+
+#[cfg(unix)]
+#[test]
+fn dangling_symlink_in_finalized_ledger_is_rejected() -> TestResult {
+    let (dir, _) = fixture("completed")?;
+    assert_success(dir.path());
+    let ledger = dir.path().join("iteration-01/state/tui-work.json");
+    let saved = dir.path().join("saved-ledger.json");
+    fs::rename(&ledger, &saved)?;
+    std::os::unix::fs::symlink("missing-ledger.json", &ledger)?;
+    assert_failure(dir.path());
+    Ok(())
+}
+
+#[cfg(unix)]
+#[test]
+fn symlink_component_in_pending_path_is_rejected() -> TestResult {
+    let (dir, _) = fixture("running")?;
+    assert_success(dir.path());
+    let state = dir.path().join("iteration-02/state");
+    let saved = dir.path().join("saved-state");
+    fs::rename(&state, &saved)?;
+    std::os::unix::fs::symlink("saved-state", &state)?;
+    assert_failure(dir.path());
+    Ok(())
+}
+
+#[allow(dead_code)]
+fn _path(_: PathBuf) {}
