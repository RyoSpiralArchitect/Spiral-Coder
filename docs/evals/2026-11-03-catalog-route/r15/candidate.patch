@@ -0,0 +1,72 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, resolve_path, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub(crate) fn select_cases<'a>(
+    spec: &'a TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<&'a TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec.cases.iter().filter(|case| {
+        filter.as_deref().is_none_or(|needle| {
+            case.id.to_ascii_lowercase().contains(needle)
+                || case.tags.iter().any(|tag| tag.to_ascii_lowercase().contains(needle))
+        })
+    }).collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
+pub(crate) fn validate_selected(
+    spec_path: &Path,
+    root: &Path,
+    selected: &[&TuiReplayCase],
+) -> Result<()> {
+    if selected.is_empty() {
+        anyhow::bail!("no replay cases selected from {}", spec_path.display());
+    }
+    for case in selected {
+        if case.checks.is_empty() {
+            anyhow::bail!("replay case '{}' has no checks", case.id);
+        }
+    }
+    let _ = root;
+    Ok(())
+}
+
+pub(crate) async fn run(args: crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let root = PathBuf::from(args.tool_root.unwrap_or_else(|| cwd.display().to_string()));
+    let spec_path = resolve_path(&root, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, args.filter.as_deref(), args.max_cases);
+    validate_selected(&spec_path, &root, &selected)?;
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected.into_iter().map(|case| CatalogCase {
+            id: case.id.clone(),
+            tags: case.tags.clone(),
+        }).collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
