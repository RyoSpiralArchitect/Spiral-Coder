+use anyhow::{bail, Context, Result};
+use clap::Args;
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, resolve_path, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Clone, Args)]
+pub struct TuiReplayListArgs {
+    #[arg(short = 'C', long = "tool-root", default_value = ".")]
+    pub tool_root: PathBuf,
+    #[arg(long, default_value = ".spiral-coder/tui_replay.json")]
+    pub spec: PathBuf,
+    #[arg(long)]
+    pub filter: Option<String>,
+    #[arg(long)]
+    pub max_cases: Option<usize>,
+}
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub fn run(args: TuiReplayListArgs) -> Result<()> {
+    let root = if args.tool_root.is_absolute() {
+        args.tool_root
+    } else {
+        std::env::current_dir()
+            .context("failed to get current directory")?
+            .join(args.tool_root)
+    };
+    let spec_path = resolve_path(&root, args.spec);
+    let spec = load_spec(&spec_path)?;
+    validate_spec(&spec)?;
+    let selected = select_cases(&spec, args.filter.as_deref(), args.max_cases);
+    if selected.is_empty() {
+        bail!("no replay cases selected from {}", spec_path.display());
+    }
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id.clone(),
+                tags: case.tags.clone(),
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+fn select_cases<'a>(
+    spec: &'a TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<&'a TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter.as_deref().is_none_or(|needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
+fn validate_spec(spec: &TuiReplaySpec) -> Result<()> {
+    if spec.version != 1 {
+        bail!("unsupported replay spec version {}", spec.version);
+    }
+    for case in &spec.cases {
+        if case.id.trim().is_empty() {
+            bail!("replay case id must not be empty");
+        }
+        if case.checks.is_empty() {
+            bail!("replay case '{}' has no checks", case.id);
+        }
+    }
+    Ok(())
+}
+
