@@ -0,0 +1,69 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+#[derive(Debug, Serialize)]
+struct CatalogOutput {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub async fn run(args: crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let root = PathBuf::from(
+        args.tool_root
+            .clone()
+            .unwrap_or_else(|| cwd.display().to_string()),
+    );
+    let spec_path = super::resolve_path(&root, args.spec);
+    let spec = super::load_spec(&spec_path)?;
+    let filter = args.filter.as_deref().map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec
+        .cases
+        .iter()
+        .filter(|case| match filter.as_deref() {
+            Some(filter) => {
+                case.id.to_ascii_lowercase().contains(filter)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(filter))
+            }
+            None => true,
+        })
+        .collect();
+    if let Some(limit) = args.max_cases {
+        selected.truncate(limit.max(1));
+    }
+    if selected.is_empty() {
+        return Err(super::diagnostics::empty_selection(
+            &spec_path,
+            &root,
+            args.filter.as_deref(),
+            &spec.cases,
+        ));
+    }
+    if let Some(case) = selected.iter().find(|case| case.checks.is_empty()) {
+        anyhow::bail!("replay case '{}' has no checks", case.id);
+    }
+    let output = CatalogOutput {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id.clone(),
+                tags: case.tags.clone(),
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
