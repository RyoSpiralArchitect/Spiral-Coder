+//! Read-only replay catalog selection and rendering.
+
+use super::{select_cases, TuiReplaySpec};
+use anyhow::{bail, Result};
+use serde::Serialize;
+use std::path::Path;
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u8,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub(crate) fn list(
+    spec: &TuiReplaySpec,
+    spec_path: &Path,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Result<String> {
+    let selected = select_cases(spec, filter, max_cases);
+    if selected.is_empty() {
+        bail!("no replay cases matched selection in {}", spec_path.display());
+    }
+    for case in &selected {
+        super::validate_case(case)
+            .map_err(|error| anyhow::anyhow!("invalid replay case '{}': {}", case.id, error))?;
+    }
+    Ok(serde_json::to_string(&Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    })?)
+}
