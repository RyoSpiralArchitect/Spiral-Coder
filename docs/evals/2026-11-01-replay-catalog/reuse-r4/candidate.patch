+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, resolve_path, validate_case, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub(crate) fn run(args: &crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let base_root = args
+        .tool_root
+        .as_deref()
+        .map(PathBuf::from)
+        .unwrap_or(cwd);
+    let spec_path = resolve_path(&base_root, args.spec.clone());
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, args.filter.as_deref(), args.max_cases);
+    if selected.is_empty() {
+        anyhow::bail!("no replay cases matched selection in {}", spec_path.display());
+    }
+    for case in &selected {
+        validate_case(case).with_context(|| {
+            format!("invalid replay case '{}' in {}", case.id, spec_path.display())
+        })?;
+    }
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+pub(crate) fn select_cases(
+    spec: &TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter.as_deref().is_none_or(|needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .cloned()
+        .collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
+#[allow(dead_code)]
+fn _path_is_relative(path: &Path) -> bool {
+    path.is_relative()
+}
