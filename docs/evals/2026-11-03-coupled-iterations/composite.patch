diff --git a/src/tui_replay/catalog.rs b/src/tui_replay/catalog.rs
new file mode 100644
index 0000000..b4b9b22
--- /dev/null
+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,60 @@
+use anyhow::{bail, Context, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct Catalog<'a> {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase<'a>>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase<'a> {
+    id: &'a str,
+    tags: &'a [String],
+}
+
+pub fn list(
+    tool_root: Option<String>,
+    spec: PathBuf,
+    filter: Option<String>,
+    max_cases: Option<usize>,
+) -> Result<()> {
+    let root = PathBuf::from(tool_root.unwrap_or_else(|| ".".to_string()));
+    let spec_path = if spec.is_absolute() { spec } else { root.join(spec) };
+    let text = std::fs::read_to_string(&spec_path)
+        .with_context(|| format!("failed to read replay spec: {}", spec_path.display()))?;
+    let spec: TuiReplaySpec = serde_json::from_str(&text)
+        .with_context(|| format!("failed to parse replay spec: {}", spec_path.display()))?;
+    if spec.version != 1 {
+        bail!("unsupported replay spec version {}", spec.version);
+    }
+    for case in &spec.cases {
+        if case.id.is_empty() || case.checks.is_empty() {
+            bail!("invalid replay case '{}': id and checks are required", case.id);
+        }
+    }
+    let needle = filter.map(|value| value.to_ascii_lowercase());
+    let mut cases: Vec<&TuiReplayCase> = spec.cases.iter().filter(|case| {
+        needle.as_deref().map_or(true, |needle| {
+            case.id.to_ascii_lowercase().contains(needle)
+                || case.tags.iter().any(|tag| tag.to_ascii_lowercase().contains(needle))
+        })
+    }).collect();
+    if let Some(limit) = max_cases { cases.truncate(limit.max(1)); }
+    if cases.is_empty() { bail!("no replay cases selected"); }
+    let output = Catalog {
+        version: 1,
+        total: cases.len(),
+        cases: cases.into_iter().map(|case| CatalogCase { id: &case.id, tags: &case.tags }).collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+pub fn resolve_spec(root: &Path, spec: PathBuf) -> PathBuf {
+    if spec.is_absolute() { spec } else { root.join(spec) }
+}
