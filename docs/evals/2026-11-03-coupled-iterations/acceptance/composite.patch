diff --git a/src/tui_replay/catalog.rs b/src/tui_replay/catalog.rs
new file mode 100644
index 0000000..c0f6920
--- /dev/null
+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,58 @@
+use anyhow::{bail, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, select_cases, TuiReplayCase};
+
+#[derive(Debug, Serialize)]
+struct Catalog<'a> {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase<'a>>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase<'a> {
+    id: &'a str,
+    tags: &'a [String],
+}
+
+pub fn list(
+    tool_root: Option<String>,
+    spec: PathBuf,
+    filter: Option<String>,
+    max_cases: Option<usize>,
+) -> Result<()> {
+    let root = PathBuf::from(tool_root.unwrap_or_else(|| ".".to_string()));
+    let spec_path = if spec.is_absolute() {
+        spec
+    } else {
+        root.join(spec)
+    };
+    let spec = load_spec(&spec_path)?;
+    let cases = select_cases(&spec, filter.as_deref(), max_cases);
+    if cases.is_empty() {
+        bail!("no replay cases selected");
+    }
+    let output = Catalog {
+        version: 1,
+        total: cases.len(),
+        cases: cases
+            .iter()
+            .map(|case: &TuiReplayCase| CatalogCase {
+                id: &case.id,
+                tags: &case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+pub fn resolve_spec(root: &Path, spec: PathBuf) -> PathBuf {
+    if spec.is_absolute() {
+        spec
+    } else {
+        root.join(spec)
+    }
+}
