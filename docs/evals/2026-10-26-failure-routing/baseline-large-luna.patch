--- a/src/tui/agent/edit_failure.rs
+++ b/src/tui/agent/edit_failure.rs
@@ -137,6 +137,17 @@ impl EditFailureMemory {
         {
             self.read_since_failure = true;
         }
+        if name == "exec"
+            && self.read_since_failure
+            && super::parse_exec_command_from_args(arguments).is_some_and(|command| {
+                context.classify(&command).kind == ExecKind::Verify
+            })
+            && !ExecProofResult::from_history(output).succeeded
+        {
+            // A newer failed verification starts a new failure boundary. It must
+            // not inherit a completed diagnosis from an earlier failed edit.
+            self.read_since_failure = false;
+        }
         if !matches!(name, "patch_file" | "apply_diff" | "write_file") {
             return;
         }
