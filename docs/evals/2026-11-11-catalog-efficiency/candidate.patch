+fn select_cases(
+    spec: &TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+    spec_path: &PathBuf,
+    base_root: &PathBuf,
+) -> Result<Vec<TuiReplayCase>> {
+    let filter_lc = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<TuiReplayCase> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter_lc.as_deref().is_none_or(|needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .cloned()
+        .collect();
+    if let Some(limit) = max_cases.map(|value| value.max(1)) {
+        selected.truncate(limit);
+    }
+    if selected.is_empty() {
+        return Err(diagnostics::empty_selection(
+            spec_path,
+            base_root,
+            filter,
+            &spec.cases,
+        ));
+    }
+    Ok(selected)
+}
