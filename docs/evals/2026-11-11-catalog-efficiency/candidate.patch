@@ -0,0 +1,44 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{load_spec, resolve_path, select_cases};
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub async fn list(args: crate::TuiReplayListArgs, _common: crate::CommonArgs) -> Result<()> {
+    let root = args
+        .tool_root
+        .map(PathBuf::from)
+        .unwrap_or(std::env::current_dir().context("failed to get current directory")?);
+    let path = resolve_path(&root, args.spec);
+    let spec = load_spec(&path)?;
+    let cases = select_cases(&spec, args.filter.as_deref(), args.max_cases, &path, &root)?;
+    // Emit one compact JSON object; listing never executes replay cases.
+    println!(
+        "{}",
+        serde_json::to_string(&Catalog {
+            version: 1,
+            total: cases.len(),
+            cases: cases
+                .into_iter()
+                .map(|case| CatalogCase {
+                    id: case.id.clone(),
+                    tags: case.tags.clone()
+                })
+                .collect(),
+        })?
+    );
+    Ok(())
+}
