@@ -0,0 +1,24 @@
+use anyhow::{Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::Value;
+use std::fs;
+use std::path::PathBuf;
+
+#[derive(Debug, ClapArgs)]
+pub struct Args {
+    /// Existing coupled-run directory
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let path = args.run_dir.join("iterations.json");
+    let text = fs::read_to_string(&path).with_context(|| format!("read {}", path.display()))?;
+    let manifest: Value = serde_json::from_str(&text)
+        .with_context(|| format!("parse {}", path.display()))?;
+    if manifest.get("version").and_then(Value::as_u64) != Some(1) {
+        anyhow::bail!("unsupported iterations manifest version");
+    }
+    // Implement the validated fixture-shaped summary here.
+    anyhow::bail!("coupled-status summary construction is not implemented")
+}
