diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..db8c070
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,18 @@
+use std::process::Command;
+
+fn run_status(run_dir: &std::path::Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(run_dir)
+        .output()
+        .expect("run coupled-status")
+}
+
+#[test]
+fn missing_run_directory_fails_without_stdout() {
+    let dir = std::env::temp_dir().join(format!("spiral-status-missing-{}", std::process::id()));
+    let output = run_status(&dir);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
