@@ -0,0 +1,298 @@
+use anyhow::{bail, Context, Result};
+use clap::Args;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+#[derive(Args, Debug)]
+pub struct CoupledStatusArgs {
+    /// Native coupled-run directory
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+fn read_json(root: &Path, path: &Path) -> Result<Value> {
+    let lexical_root = if root.is_absolute() {
+        root.to_path_buf()
+    } else {
+        std::env::current_dir()?.join(root)
+    };
+    let root = root.canonicalize()?;
+    let absolute = if path.is_absolute() {
+        if path.starts_with(&lexical_root) {
+            root.join(path.strip_prefix(&lexical_root)?)
+        } else {
+            path.to_path_buf()
+        }
+    } else {
+        root.join(path)
+    };
+    anyhow::ensure!(absolute.starts_with(&root), "path escapes run directory");
+    let mut current = PathBuf::new();
+    for component in absolute.components() {
+        current.push(component.as_os_str());
+        match fs::symlink_metadata(&current) {
+            Ok(metadata) if metadata.file_type().is_symlink() => {
+                bail!("symlink path component: {}", current.display());
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => break,
+            Err(error) => {
+                return Err(error).with_context(|| format!("inspect {}", current.display()))
+            }
+        }
+    }
+    Ok(serde_json::from_slice(
+        &fs::read(&absolute).with_context(|| format!("read {}", absolute.display()))?,
+    )?)
+}
+
+fn u(v: &Value, key: &str) -> Result<u64> {
+    v.get(key)
+        .and_then(Value::as_u64)
+        .with_context(|| format!("missing positive integer {key}"))
+}
+fn opt_str(v: &Value, key: &str) -> Option<String> {
+    v.get(key).and_then(Value::as_str).map(str::to_owned)
+}
+
+pub fn run(run_dir: PathBuf) -> Result<()> {
+    let dir = if run_dir.is_absolute() {
+        run_dir
+    } else {
+        std::env::current_dir()?.join(run_dir)
+    };
+    let manifest = read_json(&dir, &dir.join("iterations.json"))?;
+    anyhow::ensure!(
+        manifest.get("version") == Some(&json!(1)),
+        "unsupported manifest version"
+    );
+    let max_iterations = u(&manifest, "max_iterations")?;
+    let per_iteration = u(&manifest, "max_task_requests_per_iteration")?;
+    let max_task = u(&manifest, "max_task_requests")?;
+    let max_wire = u(&manifest, "max_wire_requests")?;
+    anyhow::ensure!(
+        max_iterations > 0 && per_iteration > 0,
+        "limits must be positive"
+    );
+    anyhow::ensure!(
+        max_iterations.checked_mul(per_iteration) == Some(max_task),
+        "task cap product mismatch"
+    );
+    anyhow::ensure!(max_wire >= max_task, "wire cap below task cap");
+    let rows = manifest
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations must be array")?;
+    anyhow::ensure!(rows.len() as u64 <= max_iterations, "too many iterations");
+    let mut ids = HashSet::new();
+    let mut previous: Option<String> = None;
+    let mut output_rows = Vec::new();
+    let mut task_total = 0u64;
+    let mut wire_total = 0u64;
+    for (idx, row) in rows.iter().enumerate() {
+        let n = u(row, "iteration")?;
+        let expected_dir = format!("iteration-{n:02}");
+        anyhow::ensure!(
+            n == idx as u64 + 1
+                && row.get("directory").and_then(Value::as_str) == Some(expected_dir.as_str()),
+            "invalid iteration order or directory"
+        );
+        let task_id = row
+            .get("task_id")
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+            .context("invalid task id")?
+            .to_owned();
+        anyhow::ensure!(ids.insert(task_id.clone()), "duplicate task id");
+        let parent = row
+            .get("parent_task_id")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        anyhow::ensure!(parent == previous, "invalid parent task linkage");
+        previous = Some(task_id.clone());
+        let ledger = read_json(&dir, &dir.join(&expected_dir).join("state/tui-work.json"))?;
+        anyhow::ensure!(
+            ledger.get("task_id").and_then(Value::as_str) == Some(task_id.as_str()),
+            "ledger task mismatch"
+        );
+        let requests = ledger
+            .get("requests")
+            .and_then(Value::as_array)
+            .context("ledger requests missing")?;
+        let mut request_ids = HashSet::new();
+        let mut task_count = 0u64;
+        for request in requests {
+            let id = u(request, "id")?;
+            anyhow::ensure!(request_ids.insert(id), "duplicate request id");
+            if request
+                .get("charge")
+                .and_then(Value::as_str)
+                .unwrap_or("task")
+                == "task"
+            {
+                task_count += 1;
+            }
+        }
+        let wire_count = requests.len() as u64;
+        anyhow::ensure!(task_count <= per_iteration, "iteration task cap exceeded");
+        anyhow::ensure!(
+            u(row, "task_requests")? == task_count && u(row, "wire_requests")? == wire_count,
+            "row counts mismatch"
+        );
+        let completed = row
+            .get("completed")
+            .and_then(Value::as_bool)
+            .context("completed missing")?;
+        let termination = row
+            .get("termination")
+            .and_then(Value::as_str)
+            .context("termination missing")?;
+        anyhow::ensure!(
+            completed == (termination == "completed"),
+            "row completion mismatch"
+        );
+        if completed {
+            anyhow::ensure!(idx + 1 == rows.len(), "only last row can complete");
+        }
+        task_total = task_total
+            .checked_add(task_count)
+            .context("task overflow")?;
+        wire_total = wire_total
+            .checked_add(wire_count)
+            .context("wire overflow")?;
+        let progress = row.get("progress").unwrap_or(&Value::Null);
+        output_rows.push(json!({"iteration": n, "task_id": task_id, "termination": termination, "task_requests": task_count, "wire_requests": wire_count, "changed_files": progress.get("changed_files").cloned().unwrap_or(json!([])), "newly_verified": progress.get("newly_verified").cloned().unwrap_or(json!([]))}));
+    }
+    let stop_reason = manifest
+        .get("stop_reason")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+    let completed_manifest = manifest
+        .get("completed")
+        .and_then(Value::as_bool)
+        .context("completed missing")?;
+    anyhow::ensure!(
+        completed_manifest == (stop_reason.as_deref() == Some("completed")),
+        "manifest completion mismatch"
+    );
+    if completed_manifest {
+        anyhow::ensure!(
+            !rows.is_empty()
+                && rows
+                    .last()
+                    .unwrap()
+                    .get("termination")
+                    .and_then(Value::as_str)
+                    == Some("completed"),
+            "completed manifest lacks completed last row"
+        );
+    }
+    let active = manifest.get("active_iteration").and_then(Value::as_str);
+    let interrupted = manifest.get("interrupted_iteration");
+    anyhow::ensure!(
+        active.is_none() || interrupted.is_none() || interrupted == Some(&Value::Null),
+        "multiple pending iterations"
+    );
+    let pending_dir = active.or_else(|| {
+        interrupted
+            .and_then(|v| v.get("directory"))
+            .and_then(Value::as_str)
+    });
+    let pending = if let Some(p) = pending_dir {
+        let n = p
+            .strip_prefix("iteration-")
+            .and_then(|s| s.parse::<u64>().ok())
+            .context("invalid pending directory")?;
+        anyhow::ensure!(
+            n == rows.len() as u64 + 1 && n <= max_iterations,
+            "invalid pending iteration"
+        );
+        let path = dir.join(p).join("state/tui-work.json");
+        if !path.exists() {
+            json!({"directory": p, "task_id": Value::Null, "task_requests": Value::Null, "wire_requests": Value::Null, "in_flight_requests": Value::Null})
+        } else {
+            let ledger = read_json(&dir, &path)?;
+            let task_id = opt_str(&ledger, "task_id");
+            anyhow::ensure!(
+                task_id.as_ref().map(|x| !ids.contains(x)).unwrap_or(false),
+                "pending task id invalid"
+            );
+            let req = ledger
+                .get("requests")
+                .and_then(Value::as_array)
+                .context("pending requests missing")?;
+            let mut task = 0u64;
+            let mut seen = HashSet::new();
+            let mut inflight = 0u64;
+            for r in req {
+                anyhow::ensure!(seen.insert(u(r, "id")?), "duplicate request id");
+                if r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task" {
+                    task += 1;
+                }
+                if r.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") {
+                    inflight += 1;
+                }
+            }
+            json!({"directory":p,"task_id":task_id,"task_requests":task,"wire_requests":req.len(),"in_flight_requests":inflight})
+        }
+    } else {
+        Value::Null
+    };
+    let unknown = pending
+        .get("task_requests")
+        .map(Value::is_null)
+        .unwrap_or(false);
+    let pending_task = pending
+        .get("task_requests")
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    let pending_wire = pending
+        .get("wire_requests")
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    if active.is_some() {
+        anyhow::ensure!(stop_reason.is_none(), "active run has stop reason");
+    }
+    if interrupted.is_some() {
+        anyhow::ensure!(
+            stop_reason.as_deref() == Some("interrupted"),
+            "interrupted run stop reason mismatch"
+        );
+    }
+    let out_task = if unknown {
+        None
+    } else {
+        Some(task_total + pending_task)
+    };
+    let out_wire = if unknown {
+        None
+    } else {
+        Some(wire_total + pending_wire)
+    };
+    if interrupted.is_some() && !unknown {
+        anyhow::ensure!(
+            manifest.get("task_requests").and_then(Value::as_u64) == out_task
+                && manifest.get("wire_requests").and_then(Value::as_u64) == out_wire,
+            "manifest totals mismatch"
+        );
+    }
+    if interrupted.is_none() {
+        anyhow::ensure!(
+            manifest.get("task_requests").and_then(Value::as_u64) == Some(task_total)
+                && manifest.get("wire_requests").and_then(Value::as_u64) == Some(wire_total),
+            "manifest totals mismatch"
+        );
+    }
+    let status = if completed_manifest {
+        "completed"
+    } else if stop_reason.is_some() {
+        "stopped"
+    } else {
+        "running"
+    };
+    let result = json!({"version":1,"status":status,"stop_reason":stop_reason,"iterations":output_rows,"pending":if pending.is_null(){Value::Null}else{pending},"requests":{"task_used":out_task,"wire_used":out_wire,"task_limit":max_task,"wire_limit":max_wire,"task_remaining":out_task.map(|x| max_task-x),"wire_remaining":out_wire.map(|x| max_wire-x)}});
+    println!("{}", serde_json::to_string(&result)?);
+    Ok(())
+}
