+++ b/src/coupled_status.rs
@@ -0,0 +1,376 @@
+use anyhow::{anyhow, Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(Debug, Clone, clap::Args)]
+pub struct Args {
+    #[arg(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+#[derive(Deserialize)]
+struct Manifest {
+    version: u64,
+    max_iterations: u64,
+    max_task_requests_per_iteration: u64,
+    max_task_requests: u64,
+    max_wire_requests: u64,
+    completed: bool,
+    stop_reason: Option<String>,
+    active_iteration: Option<String>,
+    interrupted_iteration: Option<PendingManifest>,
+    iterations: Vec<Row>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+
+#[derive(Deserialize)]
+struct PendingManifest {
+    directory: String,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+
+#[derive(Deserialize)]
+struct Row {
+    iteration: u64,
+    directory: String,
+    task_id: String,
+    parent_task_id: Option<String>,
+    termination: String,
+    completed: bool,
+    task_requests: u64,
+    wire_requests: u64,
+    progress: Progress,
+}
+
+#[derive(Deserialize)]
+struct Progress {
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Deserialize)]
+struct Ledger {
+    task_id: String,
+    #[serde(default)]
+    requests: Vec<Request>,
+}
+
+#[derive(Deserialize)]
+struct Request {
+    id: Value,
+    #[serde(default)]
+    charge: Option<String>,
+    #[serde(default)]
+    status: Option<String>,
+}
+
+#[derive(Serialize)]
+struct Output {
+    version: u64,
+    status: String,
+    stop_reason: Option<String>,
+    iterations: Vec<OutputRow>,
+    pending: Option<OutputPending>,
+    requests: Usage,
+}
+
+#[derive(Serialize)]
+struct OutputRow {
+    iteration: u64,
+    task_id: String,
+    termination: String,
+    task_requests: u64,
+    wire_requests: u64,
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Serialize)]
+struct OutputPending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+    in_flight_requests: Option<u64>,
+}
+
+#[derive(Serialize)]
+struct Usage {
+    task_used: Option<u64>,
+    wire_used: Option<u64>,
+    task_limit: u64,
+    wire_limit: u64,
+    task_remaining: Option<u64>,
+    wire_remaining: Option<u64>,
+}
+
+fn safe_path(root: &Path, relative: &str) -> Result<PathBuf> {
+    let path = Path::new(relative);
+    if path.is_absolute()
+        || path.components().any(|c| {
+            matches!(
+                c,
+                Component::ParentDir | Component::RootDir | Component::Prefix(_)
+            )
+        })
+    {
+        return Err(anyhow!("unsafe path"));
+    }
+    let mut current = root.to_path_buf();
+    for component in path.components() {
+        current.push(component.as_os_str());
+        match current.symlink_metadata() {
+            Ok(meta) if meta.file_type().is_symlink() => return Err(anyhow!("symlink path")),
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => break,
+            Err(error) => return Err(error).context("inspect path"),
+        }
+    }
+    Ok(current)
+}
+
+fn read_json<T: for<'a> Deserialize<'a>>(path: &Path) -> Result<T> {
+    let meta = fs::symlink_metadata(path).context("missing record")?;
+    if meta.file_type().is_symlink() {
+        return Err(anyhow!("symlink record"));
+    }
+    Ok(
+        serde_json::from_slice(&fs::read(path).context("read record")?)
+            .context("malformed JSON")?,
+    )
+}
+
+fn ledger(root: &Path, directory: &str) -> Result<Ledger> {
+    let rel = format!("{directory}/state/tui-work.json");
+    read_json(&safe_path(root, &rel)?)
+}
+
+fn counts(record: &Ledger) -> Result<(u64, u64, u64)> {
+    let mut ids = HashSet::new();
+    let mut task = 0u64;
+    let mut inflight = 0u64;
+    for request in &record.requests {
+        let id = serde_json::to_string(&request.id)?;
+        if !ids.insert(id) {
+            return Err(anyhow!("duplicate request id"));
+        }
+        if request.charge.as_deref().unwrap_or("task") == "task" {
+            task = task.checked_add(1).ok_or_else(|| anyhow!("overflow"))?;
+        }
+        if request.status.as_deref() == Some("in_flight_or_interrupted") {
+            inflight = inflight.checked_add(1).ok_or_else(|| anyhow!("overflow"))?;
+        }
+    }
+    Ok((task, record.requests.len() as u64, inflight))
+}
+
+pub fn run(args: Args) -> Result<()> {
+    let root = fs::canonicalize(&args.run_dir).context("resolve run directory")?;
+    let manifest_path = safe_path(&root, "iterations.json")?;
+    let manifest: Manifest = read_json(&manifest_path)?;
+    if manifest.version != 1 {
+        return Err(anyhow!("unsupported version"));
+    }
+    if manifest.max_iterations == 0 || manifest.max_task_requests_per_iteration == 0 {
+        return Err(anyhow!("invalid limits"));
+    }
+    if manifest.max_task_requests
+        != manifest
+            .max_iterations
+            .checked_mul(manifest.max_task_requests_per_iteration)
+            .ok_or_else(|| anyhow!("overflow"))?
+        || manifest.max_wire_requests < manifest.max_task_requests
+    {
+        return Err(anyhow!("invalid caps"));
+    }
+    if manifest.iterations.len() as u64 > manifest.max_iterations {
+        return Err(anyhow!("too many rows"));
+    }
+    let mut ids = HashSet::new();
+    let mut finalized_task = 0u64;
+    let mut finalized_wire = 0u64;
+    let mut output_rows = Vec::new();
+    for (index, row) in manifest.iterations.iter().enumerate() {
+        let expected = index as u64 + 1;
+        if row.iteration != expected
+            || row.directory != format!("iteration-{expected:02}")
+            || row.task_id.is_empty()
+            || !ids.insert(row.task_id.clone())
+            || row.parent_task_id
+                != if index == 0 {
+                    None
+                } else {
+                    Some(manifest.iterations[index - 1].task_id.clone())
+                }
+        {
+            return Err(anyhow!("invalid row linkage"));
+        }
+        if row.completed != (row.termination == "completed")
+            || (row.completed && index + 1 != manifest.iterations.len())
+            || row.task_requests > manifest.max_task_requests_per_iteration
+        {
+            return Err(anyhow!("invalid row"));
+        }
+        let record = ledger(&root, &row.directory)?;
+        let (task, wire, _) = counts(&record)?;
+        if record.task_id != row.task_id || task != row.task_requests || wire != row.wire_requests {
+            return Err(anyhow!("ledger mismatch"));
+        }
+        finalized_task = finalized_task
+            .checked_add(task)
+            .ok_or_else(|| anyhow!("overflow"))?;
+        finalized_wire = finalized_wire
+            .checked_add(wire)
+            .ok_or_else(|| anyhow!("overflow"))?;
+        output_rows.push(OutputRow {
+            iteration: row.iteration,
+            task_id: row.task_id.clone(),
+            termination: row.termination.clone(),
+            task_requests: task,
+            wire_requests: wire,
+            changed_files: row.progress.changed_files.clone(),
+            newly_verified: row.progress.newly_verified.clone(),
+        });
+    }
+    let active = manifest.active_iteration.clone();
+    if active.is_some() && manifest.interrupted_iteration.is_some() {
+        return Err(anyhow!("multiple pending iterations"));
+    }
+    let pending_dir = active.clone().or_else(|| {
+        manifest
+            .interrupted_iteration
+            .as_ref()
+            .map(|p| p.directory.clone())
+    });
+    let mut pending_output = None;
+    let mut unknown_pending_usage = false;
+    let mut task_used = finalized_task;
+    let mut wire_used = finalized_wire;
+    if let Some(dir) = pending_dir {
+        let next = manifest.iterations.len() as u64 + 1;
+        if dir != format!("iteration-{next:02}") || next > manifest.max_iterations {
+            return Err(anyhow!("invalid pending directory"));
+        }
+        let pending_meta = manifest.interrupted_iteration.as_ref();
+        if pending_meta.is_some() && manifest.stop_reason.as_deref() != Some("interrupted") {
+            return Err(anyhow!("invalid interruption"));
+        }
+        if active.is_some() && manifest.stop_reason.is_some() {
+            return Err(anyhow!("invalid active record"));
+        }
+        let path = safe_path(&root, &format!("{dir}/state/tui-work.json"))?;
+        let mut missing = false;
+        let mut current = root.clone();
+        for component in Path::new(&format!("{dir}/state/tui-work.json")).components() {
+            current.push(component.as_os_str());
+            match fs::symlink_metadata(&current) {
+                Ok(meta) if meta.file_type().is_symlink() => return Err(anyhow!("symlink path")),
+                Ok(_) => {}
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                    missing = true;
+                    break;
+                }
+                Err(e) => return Err(e.into()),
+            }
+        }
+        if missing {
+            unknown_pending_usage = true;
+        }
+        let known = if missing {
+            None
+        } else {
+            Some(ledger(&root, &dir)?)
+        };
+        let (task, wire, inflight, task_id) = if let Some(record) = known {
+            let (t, w, i) = counts(&record)?;
+            if ids.contains(&record.task_id) {
+                return Err(anyhow!("duplicate task id"));
+            }
+            (Some(t), Some(w), Some(i), Some(record.task_id))
+        } else {
+            (None, None, None, None)
+        };
+        if let Some(p) = pending_meta {
+            if p.task_requests != task || p.wire_requests != wire {
+                return Err(anyhow!("pending counts mismatch"));
+            }
+        }
+        if task.is_some() {
+            task_used = task_used
+                .checked_add(task.unwrap())
+                .ok_or_else(|| anyhow!("overflow"))?;
+            wire_used = wire_used
+                .checked_add(wire.unwrap())
+                .ok_or_else(|| anyhow!("overflow"))?;
+        }
+        pending_output = Some(OutputPending {
+            directory: dir,
+            task_id,
+            task_requests: task,
+            wire_requests: wire,
+            in_flight_requests: inflight,
+        });
+    }
+    if manifest.stop_reason.as_deref() == Some("completed") {
+        if manifest.iterations.last().map(|r| r.completed) != Some(true) || pending_output.is_some()
+        {
+            return Err(anyhow!("invalid completion"));
+        }
+    }
+    if manifest.completed != (manifest.stop_reason.as_deref() == Some("completed")) {
+        return Err(anyhow!("completion mismatch"));
+    }
+    if manifest.interrupted_iteration.is_some() {
+        let pending_known = pending_output
+            .as_ref()
+            .and_then(|p| p.task_requests)
+            .is_some();
+        let expected_task = if pending_known { Some(task_used) } else { None };
+        let expected_wire = if pending_known { Some(wire_used) } else { None };
+        if manifest.task_requests != expected_task || manifest.wire_requests != expected_wire {
+            return Err(anyhow!("aggregate mismatch"));
+        }
+    } else if manifest.task_requests != Some(finalized_task)
+        || manifest.wire_requests != Some(finalized_wire)
+    {
+        return Err(anyhow!("aggregate mismatch"));
+    }
+    if task_used > manifest.max_task_requests || wire_used > manifest.max_wire_requests {
+        return Err(anyhow!("usage exceeds cap"));
+    }
+    let unknown_pending = manifest.interrupted_iteration.is_some()
+        && pending_output
+            .as_ref()
+            .and_then(|p| p.task_requests)
+            .is_none();
+    let output = Output {
+        version: 1,
+        status: if manifest.completed {
+            "completed".into()
+        } else if manifest.stop_reason.is_some() {
+            "stopped".into()
+        } else {
+            "running".into()
+        },
+        stop_reason: manifest.stop_reason,
+        iterations: output_rows,
+        pending: pending_output,
+        requests: Usage {
+            task_used: (!unknown_pending_usage).then_some(task_used),
+            wire_used: (!unknown_pending_usage).then_some(wire_used),
+            task_limit: manifest.max_task_requests,
+            wire_limit: manifest.max_wire_requests,
+            task_remaining: (!unknown_pending_usage)
+                .then_some(manifest.max_task_requests - task_used),
+            wire_remaining: (!unknown_pending_usage)
+                .then_some(manifest.max_wire_requests - wire_used),
+        },
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
