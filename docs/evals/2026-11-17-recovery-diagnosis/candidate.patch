diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..3642e46
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,51 @@
+use std::process::Command;
+
+fn fixture(kind: &str) -> tempfile::TempDir {
+    let dir = tempfile::tempdir().expect("temporary fixture directory");
+    let status = Command::new("python3")
+        .args([
+            "-S",
+            "scripts/status_fixture.py",
+            dir.path().to_str().unwrap(),
+            kind,
+        ])
+        .status()
+        .expect("fixture helper");
+    assert!(status.success(), "fixture helper failed: {status}");
+    dir
+}
+
+fn run_status(dir: &std::path::Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(dir)
+        .output()
+        .expect("coupled-status command")
+}
+
+#[test]
+fn completed_fixture_is_read_without_provider_calls() {
+    let dir = fixture("completed");
+    let output = run_status(dir.path());
+    assert!(
+        output.status.success(),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(!output.stdout.is_empty());
+    assert!(serde_json::from_slice::<serde_json::Value>(&output.stdout).is_ok());
+}
+
+#[test]
+fn interrupted_unknown_fixture_reports_null_usage() {
+    let dir = fixture("unknown");
+    let output = run_status(dir.path());
+    assert!(
+        output.status.success(),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("status JSON");
+    assert!(value["requests"]["task_used"].is_null());
+    assert!(value["requests"]["wire_used"].is_null());
+}
