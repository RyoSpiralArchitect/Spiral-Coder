diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..0e50dc0
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,141 @@
+use std::path::Path;
+use std::process::{Command, Output};
+
+fn make_fixture(mode: &str) -> tempfile::TempDir {
+    let dir = tempfile::tempdir().expect("temporary fixture directory");
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(dir.path())
+        .arg(mode)
+        .status()
+        .expect("run status_fixture.py");
+    assert!(status.success(), "fixture generation failed for {mode}");
+    dir
+}
+
+fn run_status(path: &Path) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(path)
+        .output()
+        .expect("run coupled-status")
+}
+
+fn read_json(path: &Path) -> serde_json::Value {
+    serde_json::from_slice(&std::fs::read(path).expect("read JSON")).expect("valid JSON")
+}
+
+fn write_json(path: &Path, value: &serde_json::Value) {
+    std::fs::write(path, serde_json::to_vec(value).expect("serialize JSON")).expect("write JSON");
+}
+
+fn assert_success(path: &Path) -> serde_json::Value {
+    let output = run_status(path);
+    assert!(
+        output.status.success(),
+        "status failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(!output.stdout.is_empty());
+    serde_json::from_slice(&output.stdout).expect("status JSON")
+}
+
+fn assert_rejected(path: &Path) {
+    let output = run_status(path);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn completed_fixture_reports_recorded_status_without_mutating_manifest() {
+    let fixture = make_fixture("completed");
+    let manifest = fixture.path().join("iterations.json");
+    let before = std::fs::read(&manifest).unwrap();
+    let status = assert_success(fixture.path());
+    assert_eq!(status["status"], "completed");
+    assert_eq!(status["iterations"].as_array().unwrap().len(), 1);
+    assert_eq!(before, std::fs::read(manifest).unwrap());
+}
+
+#[test]
+fn supported_pending_modes_are_publicly_readable() {
+    for mode in ["running", "interrupted", "unknown", "stopped"] {
+        let fixture = make_fixture(mode);
+        let status = assert_success(fixture.path());
+        assert!(
+            status.get("requests").is_some(),
+            "missing requests for {mode}"
+        );
+    }
+}
+
+#[test]
+fn contradictory_completed_manifest_is_rejected() {
+    let fixture = make_fixture("completed");
+    assert_success(fixture.path());
+    let path = fixture.path().join("iterations.json");
+    let mut manifest = read_json(&path);
+    manifest["completed"] = serde_json::Value::Bool(false);
+    write_json(&path, &manifest);
+    assert_rejected(fixture.path());
+}
+
+#[test]
+fn wrong_parent_linkage_is_rejected_after_valid_baseline() {
+    let fixture = make_fixture("completed");
+    assert_success(fixture.path());
+    let path = fixture.path().join("iterations.json");
+    let mut manifest = read_json(&path);
+    let rows = manifest["iterations"]
+        .as_array_mut()
+        .expect("iterations array");
+    assert!(!rows.is_empty());
+    rows[0]["parent_task_id"] = serde_json::Value::String("wrong-parent".into());
+    write_json(&path, &manifest);
+    assert_rejected(fixture.path());
+}
+
+#[test]
+fn duplicate_numeric_request_id_is_rejected_without_adding_records() {
+    let fixture = make_fixture("completed");
+    assert_success(fixture.path());
+    let path = fixture.path().join("iteration-01/state/tui-work.json");
+    let mut ledger = read_json(&path);
+    let requests = ledger["requests"].as_array_mut().expect("requests array");
+    if requests.len() < 2 {
+        return;
+    }
+    let first_id = requests[0]["id"].clone();
+    requests[1]["id"] = first_id;
+    write_json(&path, &ledger);
+    assert_rejected(fixture.path());
+}
+
+#[test]
+fn missing_pending_components_remain_unknown_when_absent() {
+    let fixture = make_fixture("unknown");
+    let status = assert_success(fixture.path());
+    assert!(status["pending"].is_object() || status["pending"].is_null());
+    if let Some(pending) = status["pending"].as_object() {
+        assert!(pending["task_requests"].is_null());
+        assert!(pending["wire_requests"].is_null());
+    }
+}
+
+#[test]
+#[cfg(unix)]
+fn dangling_pending_ledger_symlink_is_rejected() {
+    let fixture = make_fixture("interrupted");
+    let baseline = run_status(fixture.path());
+    if !baseline.status.success() {
+        return;
+    }
+    let path = fixture.path().join("iteration-02/state/tui-work.json");
+    if !path.exists() {
+        return;
+    }
+    std::fs::remove_file(&path).unwrap();
+    std::os::unix::fs::symlink("missing-ledger.json", &path).unwrap();
+    assert_rejected(fixture.path());
+}
