diff --git a/src/coupled_status.rs b/src/coupled_status.rs
new file mode 100644
index 0000000..d09ea61
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,323 @@
+use anyhow::{bail, Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(clap::Args, Debug)]
+pub(crate) struct Args {
+    /// Native coupled-run directory containing iterations.json.
+    #[clap(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+pub(crate) fn run(args: Args) -> Result<()> {
+    let root = args.run_dir;
+    let manifest_path = checked_path(&root, Path::new("iterations.json"), false)?;
+    let manifest: Value = read_json(&manifest_path)?;
+    let out = summarize(&root, &manifest)?;
+    println!("{}", serde_json::to_string(&out)?);
+    Ok(())
+}
+
+fn checked_path(root: &Path, relative: &Path, allow_missing: bool) -> Result<PathBuf> {
+    if relative.components().any(|c| {
+        matches!(
+            c,
+            Component::ParentDir | Component::RootDir | Component::Prefix(_)
+        )
+    }) {
+        bail!("path escapes run directory");
+    }
+    let mut current = root.to_path_buf();
+    for component in relative.components() {
+        let name = component.as_os_str();
+        current.push(name);
+        match fs::symlink_metadata(&current) {
+            Ok(meta) => {
+                if meta.file_type().is_symlink() {
+                    bail!("symlink in run record path: {}", current.display());
+                }
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound && allow_missing => {
+                return Ok(current)
+            }
+            Err(e) => return Err(e).with_context(|| format!("checking {}", current.display())),
+        }
+    }
+    Ok(current)
+}
+
+fn read_json(path: &Path) -> Result<Value> {
+    let bytes = fs::read(path).with_context(|| format!("reading {}", path.display()))?;
+    let value: Value =
+        serde_json::from_slice(&bytes).with_context(|| format!("parsing {}", path.display()))?;
+    anyhow::ensure!(value.is_object(), "JSON record must be an object");
+    Ok(value)
+}
+
+fn uint(v: &Value, key: &str) -> Result<u64> {
+    v.get(key)
+        .and_then(Value::as_u64)
+        .with_context(|| format!("missing positive integer {key}"))
+}
+fn opt_str(v: &Value, key: &str) -> Result<Option<String>> {
+    Ok(v.get(key)
+        .map(|x| {
+            if x.is_null() {
+                Ok(None)
+            } else {
+                x.as_str()
+                    .map(str::to_owned)
+                    .map(Some)
+                    .with_context(|| format!("invalid {key}"))
+            }
+        })
+        .transpose()?
+        .flatten())
+}
+fn strv(v: &Value, key: &str) -> Result<String> {
+    v.get(key)
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .with_context(|| format!("missing string {key}"))
+}
+
+fn ledger(root: &Path, directory: &str) -> Result<Value> {
+    let rel = Path::new(directory).join("state/tui-work.json");
+    let path = checked_path(root, &rel, false)?;
+    read_json(&path)
+}
+
+fn pending_ledger(root: &Path, directory: &str) -> Result<Option<Value>> {
+    let rel = Path::new(directory).join("state/tui-work.json");
+    let path = checked_path(root, &rel, true)?;
+    if !path.exists() {
+        return Ok(None);
+    }
+    let meta =
+        fs::symlink_metadata(&path).with_context(|| format!("checking {}", path.display()))?;
+    anyhow::ensure!(
+        !meta.file_type().is_symlink(),
+        "symlink in pending ledger path"
+    );
+    Ok(Some(read_json(&path)?))
+}
+
+fn counts(state: &Value) -> Result<(String, u64, u64, u64, Vec<Value>)> {
+    let task = strv(state, "task_id")?;
+    let requests = state
+        .get("requests")
+        .and_then(Value::as_array)
+        .context("requests must be an array")?;
+    let mut ids = HashSet::new();
+    let mut task_count = 0u64;
+    let mut inflight = 0u64;
+    for request in requests {
+        let id = uint(request, "id")?;
+        if !ids.insert(id) {
+            bail!("duplicate request id");
+        }
+        let charge = request
+            .get("charge")
+            .and_then(Value::as_str)
+            .unwrap_or("task");
+        if charge == "task" {
+            task_count = task_count.checked_add(1).context("task count overflow")?;
+        }
+        if request.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") {
+            inflight = inflight
+                .checked_add(1)
+                .context("in-flight count overflow")?;
+        }
+    }
+    Ok((
+        task,
+        task_count,
+        requests.len() as u64,
+        inflight,
+        requests.clone(),
+    ))
+}
+
+fn summarize(root: &Path, m: &Value) -> Result<Value> {
+    anyhow::ensure!(
+        m.get("version") == Some(&json!(1)),
+        "unsupported manifest version"
+    );
+    let max_iterations = uint(m, "max_iterations")?;
+    let per = uint(m, "max_task_requests_per_iteration")?;
+    let max_task = uint(m, "max_task_requests")?;
+    let max_wire = uint(m, "max_wire_requests")?;
+    anyhow::ensure!(max_iterations > 0 && per > 0, "limits must be positive");
+    anyhow::ensure!(
+        per.checked_mul(max_iterations) == Some(max_task),
+        "task limits inconsistent"
+    );
+    anyhow::ensure!(max_wire >= max_task, "wire limit below task limit");
+    let rows = m
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations must be an array")?;
+    anyhow::ensure!(rows.len() as u64 <= max_iterations, "too many iterations");
+    let mut ids = HashSet::new();
+    let mut finalized_task = 0u64;
+    let mut finalized_wire = 0u64;
+    let mut output_rows = Vec::new();
+    let mut previous: Option<String> = None;
+    for (index, row) in rows.iter().enumerate() {
+        let iteration = uint(row, "iteration")?;
+        anyhow::ensure!(iteration == index as u64 + 1, "iteration order mismatch");
+        let directory = strv(row, "directory")?;
+        anyhow::ensure!(
+            directory == format!("iteration-{iteration:02}"),
+            "invalid iteration directory"
+        );
+        let task_id = strv(row, "task_id")?;
+        anyhow::ensure!(
+            !task_id.is_empty() && ids.insert(task_id.clone()),
+            "duplicate or empty task id"
+        );
+        let parent = opt_str(row, "parent_task_id")?;
+        anyhow::ensure!(parent == previous, "parent task linkage mismatch");
+        let state = ledger(root, &directory)?;
+        let (ledger_task, task_count, wire_count, _, _) = counts(&state)?;
+        anyhow::ensure!(ledger_task == task_id, "task id mismatch");
+        anyhow::ensure!(task_count <= per, "iteration task cap exceeded");
+        anyhow::ensure!(
+            row.get("task_requests").and_then(Value::as_u64) == Some(task_count),
+            "task count mismatch"
+        );
+        anyhow::ensure!(
+            row.get("wire_requests").and_then(Value::as_u64) == Some(wire_count),
+            "wire count mismatch"
+        );
+        let termination = strv(row, "termination")?;
+        anyhow::ensure!(
+            row.get("completed").and_then(Value::as_bool) == Some(termination == "completed"),
+            "completed mismatch"
+        );
+        if termination == "completed" {
+            anyhow::ensure!(index + 1 == rows.len(), "only last iteration may complete");
+        }
+        finalized_task = finalized_task
+            .checked_add(task_count)
+            .context("task aggregate overflow")?;
+        finalized_wire = finalized_wire
+            .checked_add(wire_count)
+            .context("wire aggregate overflow")?;
+        let progress = row.get("progress").context("missing progress")?;
+        output_rows.push(json!({"iteration": iteration, "task_id": task_id, "termination": termination, "task_requests": task_count, "wire_requests": wire_count, "changed_files": progress.get("changed_files").cloned().unwrap_or_else(|| json!([])), "newly_verified": progress.get("newly_verified").cloned().unwrap_or_else(|| json!([]))}));
+        previous = Some(task_id);
+    }
+    let active = opt_str(m, "active_iteration")?;
+    let interrupted = m.get("interrupted_iteration");
+    anyhow::ensure!(
+        !(active.is_some() && interrupted.is_some() && !interrupted.unwrap().is_null()),
+        "multiple pending iterations"
+    );
+    let pending_dir = active.clone().or_else(|| {
+        interrupted.and_then(|v| {
+            v.get("directory")
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+        })
+    });
+    let pending = if let Some(directory) = pending_dir {
+        let expected = format!("iteration-{:02}", rows.len() + 1);
+        anyhow::ensure!(
+            directory == expected && (rows.len() as u64) < max_iterations,
+            "invalid pending directory"
+        );
+        match pending_ledger(root, &directory)? {
+            Some(state) => {
+                let (task_id, task_count, wire_count, inflight, _) = counts(&state)?;
+                anyhow::ensure!(ids.insert(task_id.clone()), "pending task id already used");
+                if interrupted.is_some() {
+                    anyhow::ensure!(
+                        opt_str(m, "stop_reason")? == Some("interrupted".into()),
+                        "interrupted stop reason mismatch"
+                    );
+                }
+                json!({"directory": directory, "task_id": task_id, "task_requests": task_count, "wire_requests": wire_count, "in_flight_requests": inflight})
+            }
+            None => {
+                json!({"directory": directory, "task_id": null, "task_requests": null, "wire_requests": null, "in_flight_requests": null})
+            }
+        }
+    } else {
+        Value::Null
+    };
+    let pending_task = pending.get("task_requests").and_then(Value::as_u64);
+    let pending_wire = pending.get("wire_requests").and_then(Value::as_u64);
+    let has_interrupted = interrupted.is_some() && !interrupted.unwrap().is_null();
+    if has_interrupted {
+        anyhow::ensure!(
+            m.get("task_requests").and_then(Value::as_u64)
+                == pending_task.map(|x| finalized_task + x),
+            "manifest task total mismatch"
+        );
+        anyhow::ensure!(
+            m.get("wire_requests").and_then(Value::as_u64)
+                == pending_wire.map(|x| finalized_wire + x),
+            "manifest wire total mismatch"
+        );
+    } else {
+        anyhow::ensure!(
+            m.get("task_requests").and_then(Value::as_u64) == Some(finalized_task)
+                && m.get("wire_requests").and_then(Value::as_u64) == Some(finalized_wire),
+            "manifest totals mismatch"
+        );
+    }
+    let stop = opt_str(m, "stop_reason")?;
+    let completed = m
+        .get("completed")
+        .and_then(Value::as_bool)
+        .context("completed missing")?;
+    anyhow::ensure!(
+        completed == (stop.as_deref() == Some("completed")),
+        "manifest completion mismatch"
+    );
+    if completed {
+        anyhow::ensure!(
+            active.is_none()
+                && interrupted.is_none()
+                && rows
+                    .last()
+                    .and_then(|r| r.get("completed"))
+                    .and_then(Value::as_bool)
+                    == Some(true),
+            "completed manifest inconsistent"
+        );
+    }
+    let task_used = if has_interrupted && pending_task.is_none() {
+        None
+    } else {
+        Some(finalized_task + pending_task.unwrap_or(0))
+    };
+    let wire_used = if has_interrupted && pending_wire.is_none() {
+        None
+    } else {
+        Some(finalized_wire + pending_wire.unwrap_or(0))
+    };
+    let task_remaining = match task_used {
+        Some(used) => Some(
+            max_task
+                .checked_sub(used)
+                .context("task usage exceeds limit")?,
+        ),
+        None => None,
+    };
+    let wire_remaining = match wire_used {
+        Some(used) => Some(
+            max_wire
+                .checked_sub(used)
+                .context("wire usage exceeds limit")?,
+        ),
+        None => None,
+    };
+    Ok(
+        json!({"version": 1, "status": if completed {"completed"} else if stop.is_some() {"stopped"} else {"running"}, "stop_reason": stop, "iterations": output_rows, "pending": pending, "requests": {"task_used": task_used, "wire_used": wire_used, "task_limit": max_task, "wire_limit": max_wire, "task_remaining": task_remaining, "wire_remaining": wire_remaining}}),
+    )
+}
