diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..a5fd66e
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,115 @@
+use serde_json::{json, Value};
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn fixture(state: &str) -> TempDir {
+    let root = tempfile::tempdir().unwrap();
+    let script = Path::new(env!("CARGO_MANIFEST_DIR")).join("scripts/status_fixture.py");
+    let status = Command::new("python3")
+        .args([
+            "-S",
+            script.to_str().unwrap(),
+            root.path().to_str().unwrap(),
+            state,
+        ])
+        .status()
+        .unwrap();
+    assert!(status.success());
+    root
+}
+
+fn binary() -> PathBuf {
+    let path = PathBuf::from(env!("CARGO_TARGET_DIR")).join("debug/spiral-coder");
+    if !path.exists() {
+        assert!(Command::new("cargo")
+            .args(["build", "--locked", "--quiet", "--bin", "spiral-coder"])
+            .status()
+            .unwrap()
+            .success());
+    }
+    path
+}
+
+fn run(root: &Path) -> Output {
+    Command::new(binary())
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .unwrap()
+}
+
+fn succeeds(root: &Path) -> Value {
+    let output = run(root);
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(!output.stdout.is_empty());
+    serde_json::from_slice(&output.stdout).unwrap()
+}
+
+fn fails(root: &Path) {
+    let output = run(root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn native_fixture_states_are_read_only_and_unknown_is_null() {
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let root = fixture(state);
+        let value = succeeds(root.path());
+        assert_eq!(value["version"], 1);
+        if state == "unknown" {
+            assert!(value["pending"]["task_requests"].is_null());
+            assert!(value["pending"]["wire_requests"].is_null());
+            assert!(value["requests"]["task_used"].is_null());
+            assert!(value["requests"]["wire_used"].is_null());
+            assert!(value["requests"]["task_remaining"].is_null());
+            assert!(value["requests"]["wire_remaining"].is_null());
+        }
+    }
+}
+
+#[test]
+fn duplicate_request_id_is_rejected() {
+    let root = fixture("completed");
+    let path = root.path().join("iteration-01/state/tui-work.json");
+    let mut ledger: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    let first = ledger["requests"][0]["id"].clone();
+    ledger["requests"][1]["id"] = first;
+    fs::write(path, serde_json::to_vec(&ledger).unwrap()).unwrap();
+    fails(root.path());
+}
+
+#[test]
+fn wrong_parent_and_contradictory_completion_are_rejected() {
+    let root = fixture("completed");
+    let path = root.path().join("iterations.json");
+    let mut manifest: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    manifest["iterations"][0]["parent_task_id"] = json!("wrong");
+    fs::write(&path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+    fails(root.path());
+
+    let root = fixture("completed");
+    let path = root.path().join("iterations.json");
+    let mut manifest: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    manifest["iterations"][0]["completed"] = json!(false);
+    fs::write(path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+    fails(root.path());
+}
+
+#[cfg(unix)]
+#[test]
+fn symlinked_finalized_ledger_path_is_rejected() {
+    let root = fixture("completed");
+    let state = root.path().join("iteration-01/state");
+    let target = root.path().join("real-state");
+    fs::rename(&state, &target).unwrap();
+    std::os::unix::fs::symlink(&target, &state).unwrap();
+    fails(root.path());
+}
