index 0000000..15ac69d
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,205 @@
+use anyhow::{bail, Context, Result};
+use clap::Args as ClapArgs;
+use serde_json::{json, Value};
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(ClapArgs, Debug, Clone)]
+pub struct Args {
+    #[arg(long)]
+    pub run_dir: PathBuf,
+}
+
+fn json_file(path: &Path) -> Result<Value> {
+    let bytes = fs::read(path).with_context(|| format!("read {}", path.display()))?;
+    serde_json::from_slice(&bytes).with_context(|| format!("parse {}", path.display()))
+}
+fn relative(root: &Path, name: &str) -> Result<PathBuf> {
+    let p = Path::new(name);
+    if p.is_absolute()
+        || p.components().any(|c| {
+            matches!(
+                c,
+                Component::ParentDir | Component::RootDir | Component::Prefix(_)
+            )
+        })
+    {
+        bail!("unsafe directory");
+    }
+    let mut cur = root.to_path_buf();
+    for c in p.components() {
+        cur.push(c.as_os_str());
+        match cur.symlink_metadata() {
+            Ok(meta) if meta.file_type().is_symlink() => bail!("symlink path"),
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => break,
+            Err(error) => return Err(error.into()),
+        }
+    }
+    Ok(cur)
+}
+fn num(v: &Value, key: &str) -> Result<u64> {
+    v.get(key)
+        .and_then(Value::as_u64)
+        .with_context(|| format!("missing {key}"))
+}
+fn ledger(path: &Path) -> Result<(String, u64, u64, u64)> {
+    let v = json_file(path)?;
+    let task = v
+        .get("task_id")
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty())
+        .context("task_id")?
+        .to_owned();
+    let requests = v
+        .get("requests")
+        .and_then(Value::as_array)
+        .context("requests")?;
+    let mut ids = HashSet::new();
+    let mut task_n = 0;
+    let mut in_flight = 0;
+    for r in requests {
+        let id = num(r, "id")?;
+        if !ids.insert(id) {
+            bail!("duplicate request id");
+        }
+        if r.get("charge").and_then(Value::as_str).unwrap_or("task") == "task" {
+            task_n += 1;
+        }
+        if r.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") {
+            in_flight += 1;
+        }
+    }
+    Ok((task, task_n, requests.len() as u64, in_flight))
+}
+pub fn run(args: Args) -> Result<()> {
+    let root = fs::canonicalize(&args.run_dir).context("run directory")?;
+    let m = json_file(&root.join("iterations.json"))?;
+    if num(&m, "version")? != 1 {
+        bail!("unsupported version");
+    }
+    let max_i = num(&m, "max_iterations")?;
+    let per = num(&m, "max_task_requests_per_iteration")?;
+    let max_t = num(&m, "max_task_requests")?;
+    let max_w = num(&m, "max_wire_requests")?;
+    if max_i == 0 || per == 0 || max_i.checked_mul(per) != Some(max_t) || max_w < max_t {
+        bail!("invalid limits");
+    }
+    let rows = m
+        .get("iterations")
+        .and_then(Value::as_array)
+        .context("iterations")?;
+    if rows.len() as u64 > max_i {
+        bail!("too many iterations");
+    }
+    let mut seen = HashSet::new();
+    let mut prior: Option<String> = None;
+    let mut total_t = 0;
+    let mut total_w = 0;
+    let mut output = Vec::new();
+    for (idx, row) in rows.iter().enumerate() {
+        let n = num(row, "iteration")?;
+        let dir = row
+            .get("directory")
+            .and_then(Value::as_str)
+            .context("directory")?;
+        if n != (idx + 1) as u64 || dir != format!("iteration-{:02}", n) {
+            bail!("row order");
+        }
+        let (task, t, w, _) = ledger(&relative(&root, &format!("{dir}/state/tui-work.json"))?)?;
+        if !seen.insert(task.clone()) || row.get("task_id").and_then(Value::as_str) != Some(&task) {
+            bail!("task identity");
+        }
+        let parent = row.get("parent_task_id");
+        if idx == 0 {
+            if !parent.is_some_and(Value::is_null) {
+                bail!("parent linkage");
+            }
+        } else if parent.and_then(Value::as_str) != prior.as_deref() {
+            bail!("parent linkage");
+        }
+        if t != num(row, "task_requests")? || w != num(row, "wire_requests")? || t > per {
+            bail!("ledger counts");
+        }
+        let term = row
+            .get("termination")
+            .and_then(Value::as_str)
+            .context("termination")?;
+        if row.get("completed").and_then(Value::as_bool) != Some(term == "completed") {
+            bail!("completed mismatch");
+        }
+        total_t += t;
+        total_w += w;
+        prior = Some(task.clone());
+        output.push(json!({"iteration":n,"task_id":task,"termination":term,"task_requests":t,"wire_requests":w,"changed_files":row["progress"]["changed_files"],"newly_verified":row["progress"]["newly_verified"]}));
+    }
+    let active = m.get("active_iteration").and_then(Value::as_str);
+    let interrupted = m.get("interrupted_iteration");
+    let manifest_t = m.get("task_requests").and_then(Value::as_u64);
+    let manifest_w = m.get("wire_requests").and_then(Value::as_u64);
+    if active.is_none() && interrupted.is_none() {
+        if manifest_t != Some(total_t) || manifest_w != Some(total_w) {
+            bail!("manifest totals");
+        }
+    }
+    if active.is_some() && interrupted.is_some() {
+        bail!("multiple pending iterations");
+    }
+    let mut pending = Value::Null;
+    let mut used_t = total_t;
+    let mut used_w = total_w;
+    let mut usage_unknown = false;
+    if let Some(dir) =
+        active.or_else(|| interrupted.and_then(|v| v.get("directory").and_then(Value::as_str)))
+    {
+        let path = relative(&root, &format!("{dir}/state/tui-work.json"))?;
+        if path.exists() {
+            let (task, t, w, inf) = ledger(&path)?;
+            if seen.contains(&task) {
+                bail!("duplicate task");
+            }
+            pending = json!({"directory":dir,"task_id":task,"task_requests":t,"wire_requests":w,"in_flight_requests":inf});
+            if active.is_some() || interrupted.is_some() {
+                used_t += t;
+                used_w += w;
+            }
+        } else {
+            pending = json!({"directory":dir,"task_id":null,"task_requests":null,"wire_requests":null,"in_flight_requests":null});
+            if interrupted.is_some() {
+                usage_unknown = true;
+            }
+        }
+    }
+    let stop = m.get("stop_reason").and_then(Value::as_str);
+    let status = if m.get("completed").and_then(Value::as_bool) == Some(true) {
+        "completed"
+    } else if stop.is_some() {
+        "stopped"
+    } else {
+        "running"
+    };
+    let task_used = if usage_unknown {
+        Value::Null
+    } else {
+        json!(used_t)
+    };
+    let wire_used = if usage_unknown {
+        Value::Null
+    } else {
+        json!(used_w)
+    };
+    let task_remaining = if usage_unknown {
+        Value::Null
+    } else {
+        json!(max_t.checked_sub(used_t))
+    };
+    let wire_remaining = if usage_unknown {
+        Value::Null
+    } else {
+        json!(max_w.checked_sub(used_w))
+    };
+    let result = json!({"version":1,"status":status,"stop_reason":stop,"iterations":output,"pending":pending,"requests":{"task_used":task_used,"wire_used":wire_used,"task_limit":max_t,"wire_limit":max_w,"task_remaining":task_remaining,"wire_remaining":wire_remaining}});
+    println!("{}", serde_json::to_string(&result)?);
+    Ok(())
+}
