+use anyhow::{bail, Context, Result};
+use clap::Args as ClapArgs;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{
+    collections::HashSet,
+    fs,
+    path::{Component, Path, PathBuf},
+};
+
+#[derive(ClapArgs, Debug, Clone)]
+pub struct Args {
+    #[arg(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+#[derive(Deserialize)]
+struct Manifest {
+    version: u64,
+    max_iterations: u64,
+    max_task_requests_per_iteration: u64,
+    max_task_requests: u64,
+    max_wire_requests: u64,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+    completed: bool,
+    stop_reason: Option<String>,
+    iterations: Vec<Row>,
+    active_iteration: Option<String>,
+    interrupted_iteration: Option<Pending>,
+}
+#[derive(Deserialize)]
+struct Row {
+    iteration: u64,
+    directory: String,
+    task_id: String,
+    parent_task_id: Option<String>,
+    termination: String,
+    completed: bool,
+    task_requests: u64,
+    wire_requests: u64,
+    progress: Progress,
+}
+#[derive(Deserialize)]
+struct Progress {
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+#[derive(Deserialize, Clone)]
+struct Pending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+#[derive(Deserialize)]
+struct Ledger {
+    task_id: Option<String>,
+    requests: Vec<Request>,
+}
+#[derive(Deserialize)]
+struct Request {
+    id: Value,
+    charge: Option<String>,
+    status: Option<String>,
+}
+#[derive(Serialize)]
+struct Output {
+    version: u64,
+    status: String,
+    stop_reason: Option<String>,
+    iterations: Vec<OutRow>,
+    pending: Option<OutPending>,
+    requests: Usage,
+}
+#[derive(Serialize)]
+struct OutRow {
+    iteration: u64,
+    task_id: String,
+    termination: String,
+    task_requests: u64,
+    wire_requests: u64,
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+#[derive(Serialize)]
+struct OutPending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+    in_flight_requests: Option<u64>,
+}
+#[derive(Serialize)]
+struct Usage {
+    task_used: Option<u64>,
+    wire_used: Option<u64>,
+    task_limit: u64,
+    wire_limit: u64,
+    task_remaining: Option<u64>,
+    wire_remaining: Option<u64>,
+}
+
+fn read_json<T: for<'a> Deserialize<'a>>(root: &Path, rel: &Path) -> Result<T> {
+    if rel.components().any(|c| {
+        matches!(
+            c,
+            Component::ParentDir | Component::RootDir | Component::Prefix(_)
+        )
+    }) {
+        bail!("unsafe path")
+    }
+    let mut p = root.to_path_buf();
+    for c in rel.components() {
+        p.push(c.as_os_str());
+        let m = fs::symlink_metadata(&p).with_context(|| format!("missing {}", p.display()))?;
+        if m.file_type().is_symlink() {
+            bail!("symlink path")
+        }
+    }
+    serde_json::from_slice(&fs::read(&p).with_context(|| format!("read {}", p.display()))?)
+        .with_context(|| format!("malformed {}", p.display()))
+}
+fn ledger(root: &Path, dir: &str) -> Result<Ledger> {
+    read_json(root, &Path::new(dir).join("state/tui-work.json"))
+}
+fn pending_ledger(root: &Path, dir: &str) -> Result<Option<Ledger>> {
+    let rel = Path::new(dir).join("state/tui-work.json");
+    let mut path = root.to_path_buf();
+    for component in rel.components() {
+        path.push(component.as_os_str());
+        match fs::symlink_metadata(&path) {
+            Ok(metadata) => {
+                if metadata.file_type().is_symlink() {
+                    bail!("symlink path")
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error).with_context(|| format!("inspect {}", path.display())),
+        }
+    }
+    Ok(Some(read_json(root, &rel)?))
+}
+fn count(l: &Ledger) -> Result<(u64, u64, u64)> {
+    let mut seen = HashSet::new();
+    let mut task = 0u64;
+    let mut flight = 0u64;
+    for r in &l.requests {
+        let id = serde_json::to_string(&r.id)?;
+        if !seen.insert(id) {
+            bail!("duplicate request ID")
+        };
+        if r.charge.as_deref().unwrap_or("task") == "task" {
+            task = task.checked_add(1).context("overflow")?;
+        }
+        if r.status.as_deref() == Some("in_flight_or_interrupted") {
+            flight = flight.checked_add(1).context("overflow")?;
+        }
+    }
+    Ok((
+        task,
+        l.requests.len().try_into().context("overflow")?,
+        flight,
+    ))
+}
+pub fn run(args: Args) -> Result<()> {
+    let root = if args.run_dir.is_absolute() {
+        args.run_dir
+    } else {
+        std::env::current_dir()?.join(args.run_dir)
+    };
+    let m: Manifest = read_json(&root, Path::new("iterations.json"))?;
+    if m.version != 1 {
+        bail!("unsupported version")
+    }
+    if m.max_iterations == 0
+        || m.max_task_requests_per_iteration == 0
+        || m.max_task_requests
+            != m.max_iterations
+                .checked_mul(m.max_task_requests_per_iteration)
+                .context("overflow")?
+        || m.max_wire_requests < m.max_task_requests
+        || m.iterations.len() as u64 > m.max_iterations
+    {
+        bail!("invalid limits")
+    }
+    let mut tasks = HashSet::new();
+    let mut parent = None;
+    let mut ft: u64 = 0;
+    let mut fw: u64 = 0;
+    let mut rows = Vec::new();
+    for (i, r) in m.iterations.iter().enumerate() {
+        if r.iteration != i as u64 + 1
+            || r.directory != format!("iteration-{:02}", r.iteration)
+            || r.task_id.trim().is_empty()
+            || !tasks.insert(r.task_id.clone())
+            || r.parent_task_id != parent
+        {
+            bail!("invalid row")
+        };
+        let l = ledger(&root, &r.directory)?;
+        if l.task_id.as_deref() != Some(&r.task_id) {
+            bail!("task mismatch")
+        };
+        let (t, w, _) = count(&l)?;
+        if t != r.task_requests
+            || w != r.wire_requests
+            || t > m.max_task_requests_per_iteration
+            || r.completed != (r.termination == "completed")
+        {
+            bail!("ledger mismatch")
+        };
+        if r.completed && (!m.completed || i + 1 != m.iterations.len()) {
+            bail!("completion mismatch")
+        };
+        ft = ft.checked_add(t).context("overflow")?;
+        fw = fw.checked_add(w).context("overflow")?;
+        parent = Some(r.task_id.clone());
+        rows.push(OutRow {
+            iteration: r.iteration,
+            task_id: r.task_id.clone(),
+            termination: r.termination.clone(),
+            task_requests: t,
+            wire_requests: w,
+            changed_files: r.progress.changed_files.clone(),
+            newly_verified: r.progress.newly_verified.clone(),
+        });
+    }
+    if m.active_iteration.is_some() && m.interrupted_iteration.is_some() {
+        bail!("both pending records")
+    };
+    let interrupted = m.interrupted_iteration.is_some();
+    if m.completed != (m.stop_reason.as_deref() == Some("completed")) {
+        bail!("completed mismatch")
+    };
+    if interrupted && m.stop_reason.as_deref() != Some("interrupted") {
+        bail!("interrupted stop mismatch")
+    };
+    if !interrupted && m.active_iteration.is_some() && m.stop_reason.is_some() {
+        bail!("active stop mismatch")
+    }
+    let pending_dir = m.active_iteration.clone().or_else(|| {
+        m.interrupted_iteration
+            .as_ref()
+            .map(|p| p.directory.clone())
+    });
+    let mut po = None;
+    let mut total = (ft, fw);
+    if let Some(directory) = pending_dir {
+        if directory != format!("iteration-{:02}", m.iterations.len() + 1)
+            || m.iterations.len() as u64 + 1 > m.max_iterations
+        {
+            bail!("invalid pending")
+        };
+        match pending_ledger(&root, &directory)? {
+            Some(l) => {
+                let task_id = l.task_id.clone().context("pending task missing")?;
+                if task_id.trim().is_empty() || !tasks.insert(task_id.clone()) {
+                    bail!("invalid pending")
+                };
+                let (t, w, f) = count(&l)?;
+                if t > m.max_task_requests_per_iteration {
+                    bail!("pending limit")
+                };
+                total.0 = total.0.checked_add(t).context("overflow")?;
+                total.1 = total.1.checked_add(w).context("overflow")?;
+                po = Some(OutPending {
+                    directory,
+                    task_id: Some(task_id),
+                    task_requests: Some(t),
+                    wire_requests: Some(w),
+                    in_flight_requests: Some(f),
+                })
+            }
+            None => {
+                if interrupted {
+                    let p = m
+                        .interrupted_iteration
+                        .as_ref()
+                        .context("pending missing")?;
+                    let task_id = p.task_id.clone().filter(|id| !id.trim().is_empty());
+                    po = Some(OutPending {
+                        directory,
+                        task_id,
+                        task_requests: None,
+                        wire_requests: None,
+                        in_flight_requests: None,
+                    })
+                } else {
+                    po = Some(OutPending {
+                        directory,
+                        task_id: None,
+                        task_requests: None,
+                        wire_requests: None,
+                        in_flight_requests: None,
+                    })
+                }
+            }
+        }
+    }
+    if !interrupted && (m.task_requests != Some(ft) || m.wire_requests != Some(fw)) {
+        bail!("aggregate mismatch")
+    };
+    if interrupted
+        && po.as_ref().is_some_and(|p| p.task_requests.is_some())
+        && (m.task_requests != Some(total.0) || m.wire_requests != Some(total.1))
+    {
+        bail!("aggregate mismatch")
+    };
+    if m.completed
+        && (po.is_some()
+            || m.iterations.last().map(|r| r.termination.as_str()) != Some("completed"))
+    {
+        bail!("completed pending")
+    };
+    if total.0 > m.max_task_requests || total.1 > m.max_wire_requests {
+        bail!("cap exceeded")
+    }
+    let unknown = po.as_ref().is_some_and(|p| p.task_requests.is_none());
+    let (task_used, wire_used, task_remaining, wire_remaining) = if unknown {
+        (None, None, None, None)
+    } else {
+        (
+            Some(total.0),
+            Some(total.1),
+            Some(m.max_task_requests - total.0),
+            Some(m.max_wire_requests - total.1),
+        )
+    };
+    let status = if m.completed {
+        "completed"
+    } else if m.stop_reason.is_some() {
+        "stopped"
+    } else {
+        "running"
+    };
+    println!(
+        "{}",
+        serde_json::to_string(&Output {
+            version: 1,
+            status: status.into(),
+            stop_reason: m.stop_reason,
+            iterations: rows,
+            pending: po,
+            requests: Usage {
+                task_used,
+                wire_used,
+                task_limit: m.max_task_requests,
+                wire_limit: m.max_wire_requests,
+                task_remaining,
+                wire_remaining
+            }
+        })?
+    );
+    Ok(())
+}
