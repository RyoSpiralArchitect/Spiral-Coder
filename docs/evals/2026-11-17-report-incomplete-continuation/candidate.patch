index 0000000..b27101e
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,78 @@
+use std::process::Command;
+use tempfile::tempdir;
+
+fn fixture(mode: &str) -> tempfile::TempDir {
+    let dir = tempdir().expect("temporary fixture directory");
+    let status = Command::new("python3")
+        .args([
+            "-S",
+            "scripts/status_fixture.py",
+            dir.path().to_str().unwrap(),
+            mode,
+        ])
+        .status()
+        .expect("run protected fixture helper");
+    assert!(status.success(), "fixture helper failed: {status}");
+    dir
+}
+
+fn run_status(dir: &std::path::Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(dir)
+        .output()
+        .expect("run coupled-status")
+}
+
+#[test]
+fn completed_fixture_is_reported_by_public_cli() {
+    let dir = fixture("completed");
+    let output = run_status(dir.path());
+    assert!(
+        output.status.success(),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("status JSON");
+    assert_eq!(value["status"], "completed");
+    assert_eq!(value["iterations"].as_array().map(Vec::len), Some(1));
+    assert!(value["pending"].is_null());
+}
+
+#[test]
+fn interrupted_fixture_preserves_pending_summary() {
+    let dir = fixture("interrupted");
+    let output = run_status(dir.path());
+    assert!(
+        output.status.success(),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("status JSON");
+    assert_eq!(value["status"], "stopped");
+    assert!(value["pending"].is_object());
+}
+
+#[test]
+fn unknown_fixture_reports_null_usage() {
+    let dir = fixture("unknown");
+    let output = run_status(dir.path());
+    assert!(
+        output.status.success(),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("status JSON");
+    assert!(value["requests"]["task_used"].is_null());
+    assert!(value["requests"]["wire_used"].is_null());
+}
+
+#[test]
+fn malformed_manifest_fails_without_stdout() {
+    let dir = fixture("completed");
+    std::fs::write(dir.path().join("iterations.json"), b"{").expect("mutate manifest");
+    let output = run_status(dir.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
