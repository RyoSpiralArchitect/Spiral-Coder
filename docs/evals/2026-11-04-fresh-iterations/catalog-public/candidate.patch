diff --git a/src/tui_replay/catalog.rs b/src/tui_replay/catalog.rs
new file mode 100644
index 0000000..84ddeb6
--- /dev/null
+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,53 @@
+use anyhow::{bail, Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{load_spec, resolve_path, select_cases};
+
+#[derive(Debug, Clone, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+pub async fn run(args: crate::TuiReplayListArgs, _common: crate::CommonArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let root = args
+        .tool_root
+        .clone()
+        .or_else(|| cwd.to_str().map(str::to_owned))
+        .unwrap_or_else(|| ".".to_owned());
+    let root_path = PathBuf::from(root);
+    let spec_path = resolve_path(&root_path, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, args.filter.as_deref(), args.max_cases);
+    if selected.is_empty() {
+        bail!("no replay cases selected")
+    }
+    if selected.iter().any(|case| case.checks.is_empty()) {
+        bail!("selected replay case has no checks")
+    }
+    let cases = selected
+        .into_iter()
+        .map(|case| CatalogCase {
+            id: case.id,
+            tags: case.tags,
+        })
+        .collect::<Vec<_>>();
+    println!(
+        "{}",
+        serde_json::to_string(&Catalog {
+            version: 1,
+            total: cases.len(),
+            cases,
+        })?
+    );
+    Ok(())
+}
