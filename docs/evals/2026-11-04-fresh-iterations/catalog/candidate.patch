+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::{Path, PathBuf};
+
+use super::{load_spec, resolve_path, validate_case, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+pub(crate) struct CatalogOutput {
+    pub version: u32,
+    pub total: usize,
+    pub cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+pub(crate) struct CatalogCase {
+    pub id: String,
+    pub tags: Vec<String>,
+}
+
+pub(crate) fn list(
+    tool_root: Option<String>,
+    spec: PathBuf,
+    filter: Option<String>,
+    max_cases: Option<usize>,
+) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let base_root = tool_root.map(PathBuf::from).unwrap_or(cwd);
+    let spec_path = resolve_path(&base_root, spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, filter.as_deref(), max_cases);
+    if selected.is_empty() {
+        anyhow::bail!("no tui replay cases selected from {}", spec_path.display());
+    }
+    for case in &selected {
+        validate_case(case).with_context(|| format!("invalid tui replay case '{}'", case.id))?;
+    }
+    let output = CatalogOutput {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id.clone(),
+                tags: case.tags.clone(),
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+pub(crate) fn select_cases<'a>(
+    spec: &'a TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<&'a TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec
+        .cases
+        .iter()
+        .filter(|case| match filter.as_deref() {
+            Some(filter) => {
+                case.id.to_ascii_lowercase().contains(filter)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(filter))
+            }
+            None => true,
+        })
+        .collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
