diff --git a/src/tui_replay/catalog.rs b/src/tui_replay/catalog.rs
new file mode 100644
index 0000000..f120ec5
--- /dev/null
+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,93 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{diagnostics, load_spec, resolve_path, TuiReplayCase};
+
+#[derive(Debug, Clone)]
+pub struct Args {
+    pub tool_root: Option<String>,
+    pub spec: PathBuf,
+    pub filter: Option<String>,
+    pub max_cases: Option<usize>,
+}
+
+#[derive(Debug, Serialize)]
+struct Catalog {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub fn select(
+    spec: &super::TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+    spec_path: &std::path::Path,
+    base_root: &std::path::Path,
+) -> Result<Vec<TuiReplayCase>> {
+    let filter_lc = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<TuiReplayCase> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter_lc.as_deref().is_none_or(|needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .cloned()
+        .collect();
+    if let Some(limit) = max_cases.map(|n| n.max(1)) {
+        selected.truncate(limit);
+    }
+    if selected.is_empty() {
+        return Err(diagnostics::empty_selection(
+            spec_path,
+            base_root,
+            filter,
+            &spec.cases,
+        ));
+    }
+    Ok(selected)
+}
+
+pub async fn run(args: Args) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let base_root = args
+        .tool_root
+        .as_deref()
+        .map(PathBuf::from)
+        .unwrap_or(cwd);
+    let spec_path = resolve_path(&base_root, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select(
+        &spec,
+        args.filter.as_deref(),
+        args.max_cases,
+        &spec_path,
+        &base_root,
+    )?;
+    let output = Catalog {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
