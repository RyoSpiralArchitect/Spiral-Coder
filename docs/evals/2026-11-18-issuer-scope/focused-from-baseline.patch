new file mode 100644
index 0000000000000000000000000000000000000000..7f2437740c812353faa0f3a44b30785a90412c5d
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,195 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn fixture(state: &str) -> (tempfile::TempDir, PathBuf) {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path().to_path_buf();
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(&root)
+        .arg(state)
+        .status()
+        .unwrap();
+    assert!(status.success());
+    (dir, root)
+}
+
+fn cli(root: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn native_states_are_reported() {
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let (_tmp, root) = fixture(state);
+        let output = cli(&root);
+        assert!(
+            output.status.success(),
+            "{}: {}",
+            state,
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(!output.stdout.is_empty());
+    }
+}
+
+#[test]
+fn duplicate_request_ids_and_wrong_parent_are_rejected() {
+    let (_tmp, root) = fixture("completed");
+    assert!(cli(&root).status.success());
+    let path = root.join("iteration-01/state/tui-work.json");
+    let mut ledger: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    ledger["requests"][1]["id"] = ledger["requests"][0]["id"].clone();
+    fs::write(&path, serde_json::to_vec_pretty(&ledger).unwrap()).unwrap();
+    let output = cli(&root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+
+    let (_tmp, root) = fixture("completed");
+    assert!(cli(&root).status.success());
+    let path = root.join("iterations.json");
+    let mut manifest: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    manifest["iterations"][0]["parent_task_id"] = serde_json::Value::String("wrong".into());
+    fs::write(&path, serde_json::to_vec_pretty(&manifest).unwrap()).unwrap();
+    let output = cli(&root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn missing_pending_ledger_is_unknown_and_symlink_is_rejected() {
+    let (_tmp, root) = fixture("unknown");
+    let output = cli(&root);
+    assert!(output.status.success());
+    let (_tmp, root) = fixture("completed");
+    let original = root.join("iteration-01");
+    let moved = root.join("real-iteration-01");
+    fs::rename(&original, &moved).unwrap();
+    std::os::unix::fs::symlink(&moved, &original).unwrap();
+    let output = cli(&root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn owner_local_request_ids_are_valid_across_two_iterations() {
+    let (_tmp, root) = fixture("completed");
+    let manifest_path = root.join("iterations.json");
+    let mut manifest: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&manifest_path).unwrap()).unwrap();
+    let mut first = manifest["iterations"][0].clone();
+    first["termination"] = serde_json::Value::String("blocked".into());
+    first["completed"] = serde_json::Value::Bool(false);
+    let mut second = first.clone();
+    second["iteration"] = serde_json::Value::Number(2.into());
+    second["directory"] = serde_json::Value::String("iteration-02".into());
+    second["task_id"] = serde_json::Value::String("t2".into());
+    second["parent_task_id"] = serde_json::Value::String("t1".into());
+    second["termination"] = serde_json::Value::String("completed".into());
+    second["completed"] = serde_json::Value::Bool(true);
+    second["task_requests"] = serde_json::Value::Number(2.into());
+    second["wire_requests"] = serde_json::Value::Number(3.into());
+    manifest["iterations"] = serde_json::Value::Array(vec![first, second]);
+    manifest["task_requests"] = serde_json::Value::Number(4.into());
+    manifest["wire_requests"] = serde_json::Value::Number(6.into());
+    manifest["completed"] = serde_json::Value::Bool(true);
+    fs::create_dir_all(root.join("iteration-02/state")).unwrap();
+    let first_ledger = root.join("iteration-01/state/tui-work.json");
+    let mut ledger: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&first_ledger).unwrap()).unwrap();
+    ledger["task_id"] = serde_json::Value::String("t2".into());
+    fs::write(
+        root.join("iteration-02/state/tui-work.json"),
+        serde_json::to_vec_pretty(&ledger).unwrap(),
+    )
+    .unwrap();
+    fs::write(
+        &manifest_path,
+        serde_json::to_vec_pretty(&manifest).unwrap(),
+    )
+    .unwrap();
+    let output = cli(&root);
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(stdout.contains("\"iteration\":1"));
+    assert!(stdout.contains("\"iteration\":2"));
+}
+
+fn assert_rejected(root: &Path) {
+    let output = cli(root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
