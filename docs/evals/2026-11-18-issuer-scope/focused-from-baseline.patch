index 0000000000000000000000000000000000000000..2d1bcf7234e42dd01996605d1647216fd9822fb0
--- /dev/null
+++ b/src/coupled_status.rs
@@ -0,0 +1,390 @@
+use anyhow::{bail, Context, Result};
+use serde::Serialize;
+use serde_json::Value;
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct Manifest {
+    version: u64,
+    max_iterations: usize,
+    max_task_requests_per_iteration: usize,
+    max_task_requests: usize,
+    max_wire_requests: usize,
+    completed: bool,
+    stop_reason: Option<String>,
+    active_iteration: Option<String>,
+    interrupted_iteration: Option<PendingManifest>,
+    iterations: Vec<Row>,
+    task_requests: Option<usize>,
+    wire_requests: Option<usize>,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct PendingManifest {
+    directory: String,
+    task_requests: Option<usize>,
+    wire_requests: Option<usize>,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct Row {
+    iteration: usize,
+    directory: String,
+    task_id: String,
+    parent_task_id: Option<String>,
+    termination: String,
+    completed: bool,
+    task_requests: usize,
+    wire_requests: usize,
+    progress: Progress,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct Progress {
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct Ledger {
+    task_id: String,
+    requests: Vec<Request>,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+struct Request {
+    id: usize,
+    #[serde(default = "default_charge")]
+    charge: String,
+    status: String,
+}
+
+fn default_charge() -> String {
+    "task".to_string()
+}
+
+#[derive(Debug, Serialize)]
+struct Output {
+    version: u64,
+    status: String,
+    stop_reason: Option<String>,
+    iterations: Vec<OutputRow>,
+    pending: Option<OutputPending>,
+    requests: Usage,
+}
+
+#[derive(Debug, Serialize)]
+struct OutputRow {
+    iteration: usize,
+    task_id: String,
+    termination: String,
+    task_requests: usize,
+    wire_requests: usize,
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct OutputPending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<usize>,
+    wire_requests: Option<usize>,
+    in_flight_requests: Option<usize>,
+}
+
+#[derive(Debug, Serialize)]
+struct Usage {
+    task_used: Option<usize>,
+    wire_used: Option<usize>,
+    task_limit: usize,
+    wire_limit: usize,
+    task_remaining: Option<usize>,
+    wire_remaining: Option<usize>,
+}
+
+pub fn run(run_dir: PathBuf) -> Result<()> {
+    let root = if run_dir.is_absolute() {
+        run_dir
+    } else {
+        std::env::current_dir()?.join(run_dir)
+    };
+    let manifest_path = checked_path(&root, Path::new("iterations.json"), false)?;
+    let manifest: Manifest = read_json(&manifest_path)?;
+    validate_manifest(&manifest)?;
+
+    let mut task_ids = HashSet::new();
+    let mut finalized = Vec::new();
+    let mut task_total = 0usize;
+    let mut wire_total = 0usize;
+    for (index, row) in manifest.iterations.iter().enumerate() {
+        if row.iteration != index + 1 || row.directory != format!("iteration-{:02}", index + 1) {
+            bail!("invalid finalized iteration order or directory");
+        }
+        if row.task_id.is_empty() || !task_ids.insert(row.task_id.clone()) {
+            bail!("duplicate or empty task id");
+        }
+        if row.parent_task_id
+            != if index == 0 {
+                None
+            } else {
+                Some(manifest.iterations[index - 1].task_id.clone())
+            }
+        {
+            bail!("invalid parent task linkage");
+        }
+        let ledger = read_ledger(&root, &row.directory)?;
+        if ledger.task_id != row.task_id {
+            bail!("ledger task id mismatch");
+        }
+        let mut request_ids = HashSet::new();
+        let counts = count_requests(&ledger, &mut request_ids)?;
+        if counts.0 != row.task_requests
+            || counts.1 != row.wire_requests
+            || counts.0 > manifest.max_task_requests_per_iteration
+            || row.completed != (row.termination == "completed")
+        {
+            bail!("finalized row does not match ledger");
+        }
+        if row.completed && (index + 1 != manifest.iterations.len() || !manifest.completed) {
+            bail!("invalid completed row");
+        }
+        task_total = task_total
+            .checked_add(counts.0)
+            .context("task request overflow")?;
+        wire_total = wire_total
+            .checked_add(counts.1)
+            .context("wire request overflow")?;
+        finalized.push(OutputRow {
+            iteration: row.iteration,
+            task_id: row.task_id.clone(),
+            termination: row.termination.clone(),
+            task_requests: counts.0,
+            wire_requests: counts.1,
+            changed_files: row.progress.changed_files.clone(),
+            newly_verified: row.progress.newly_verified.clone(),
+        });
+    }
+
+    let pending_name = match (&manifest.active_iteration, &manifest.interrupted_iteration) {
+        (Some(_), Some(_)) => bail!("active and interrupted iterations cannot both exist"),
+        (Some(name), None) => Some((name.clone(), false)),
+        (None, Some(p)) => Some((p.directory.clone(), true)),
+        (None, None) => None,
+    };
+    let mut pending = None;
+    let mut pending_task = None;
+    let mut pending_usage = None;
+    let mut pending_interrupted = false;
+    let mut pending_unknown = false;
+    if let Some((directory, interrupted)) = pending_name {
+        pending_interrupted = interrupted;
+        let expected = format!("iteration-{:02}", manifest.iterations.len() + 1);
+        if directory != expected || manifest.iterations.len() >= manifest.max_iterations {
+            bail!("invalid pending directory");
+        }
+        if interrupted && manifest.stop_reason.as_deref() != Some("interrupted") {
+            bail!("interrupted iteration requires interrupted stop reason");
+        }
+        if !interrupted && manifest.stop_reason.is_some() {
+            bail!("active iteration requires null stop reason");
+        }
+        let ledger_path = checked_path(
+            &root,
+            Path::new(&directory).join("state/tui-work.json").as_path(),
+            true,
+        )?;
+        if ledger_path.exists() {
+            let ledger: Ledger = read_json(&ledger_path)?;
+            if ledger.task_id.is_empty() || task_ids.contains(&ledger.task_id) {
+                bail!("invalid pending task id");
+            }
+            let mut local = HashSet::new();
+            let counts = count_requests(&ledger, &mut local)?;
+            let inflight = ledger
+                .requests
+                .iter()
+                .filter(|r| r.status == "in_flight_or_interrupted")
+                .count();
+            pending_task = Some(ledger.task_id.clone());
+            pending_usage = Some((counts.0, counts.1));
+            if let Some(spec) = manifest.interrupted_iteration.as_ref() {
+                if spec.task_requests != Some(counts.0) || spec.wire_requests != Some(counts.1) {
+                    bail!("pending counts mismatch");
+                }
+            }
+            pending = Some(OutputPending {
+                directory,
+                task_id: pending_task.clone(),
+                task_requests: Some(counts.0),
+                wire_requests: Some(counts.1),
+                in_flight_requests: Some(inflight),
+            });
+        } else {
+            pending_unknown = true;
+            if interrupted
+                && manifest
+                    .interrupted_iteration
+                    .as_ref()
+                    .unwrap()
+                    .task_requests
+                    .is_some()
+            {
+                bail!("missing known pending ledger");
+            }
+            pending = Some(OutputPending {
+                directory,
+                task_id: None,
+                task_requests: None,
+                wire_requests: None,
+                in_flight_requests: None,
+            });
+        }
+    }
+    let (manifest_task, manifest_wire) = if pending_interrupted {
+        match pending_usage {
+            Some((t, w)) => (
+                Some(task_total.checked_add(t).context("task overflow")?),
+                Some(wire_total.checked_add(w).context("wire overflow")?),
+            ),
+            None => (None, None),
+        }
+    } else {
+        (Some(task_total), Some(wire_total))
+    };
+    let (task_used, wire_used) = match (pending_unknown, pending_usage, pending_interrupted) {
+        (true, _, _) => (None, None),
+        (false, Some((t, w)), false) => (
+            Some(task_total.checked_add(t).context("task overflow")?),
+            Some(wire_total.checked_add(w).context("wire overflow")?),
+        ),
+        (false, Some((_t, _w)), true) => (manifest_task, manifest_wire),
+        (false, None, true) => (None, None),
+        (false, None, false) => (Some(task_total), Some(wire_total)),
+    };
+    if manifest.task_requests != manifest_task
+        && !(pending_interrupted && manifest.task_requests.is_none())
+    {
+        bail!("manifest aggregate counts mismatch");
+    }
+    if manifest.wire_requests != manifest_wire
+        && !(pending_interrupted && manifest.wire_requests.is_none())
+    {
+        bail!("manifest aggregate counts mismatch");
+    }
+    if task_used.map_or(false, |v| v > manifest.max_task_requests)
+        || wire_used.map_or(false, |v| v > manifest.max_wire_requests)
+    {
+        bail!("aggregate usage exceeds limits");
+    }
+    if manifest.completed != (manifest.stop_reason.as_deref() == Some("completed")) {
+        bail!("completed flag mismatch");
+    }
+    if manifest.completed
+        && (pending.is_some()
+            || finalized.last().map(|r| r.termination.as_str()) != Some("completed"))
+    {
+        bail!("completed manifest is inconsistent");
+    }
+    if manifest.iterations.is_empty()
+        && (manifest.task_requests != Some(0) || manifest.wire_requests != Some(0))
+    {
+        bail!("empty manifest must have zero totals");
+    }
+
+    let usage = Usage {
+        task_used,
+        wire_used,
+        task_limit: manifest.max_task_requests,
+        wire_limit: manifest.max_wire_requests,
+        task_remaining: task_used.map(|v| manifest.max_task_requests - v),
+        wire_remaining: wire_used.map(|v| manifest.max_wire_requests - v),
+    };
+    let status = if manifest.completed {
+        "completed"
+    } else if manifest.stop_reason.is_some() {
+        "stopped"
+    } else {
+        "running"
+    };
+    let output = Output {
+        version: 1,
+        status: status.to_string(),
+        stop_reason: manifest.stop_reason,
+        iterations: finalized,
+        pending,
+        requests: usage,
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+fn validate_manifest(m: &Manifest) -> Result<()> {
+    if m.version != 1 || m.max_iterations == 0 || m.max_task_requests_per_iteration == 0 {
+        bail!("invalid manifest limits");
+    }
+    if m.max_task_requests
+        != m.max_iterations
+            .checked_mul(m.max_task_requests_per_iteration)
+            .context("limit overflow")?
+        || m.max_wire_requests < m.max_task_requests
+        || m.iterations.len() > m.max_iterations
+    {
+        bail!("invalid manifest caps");
+    }
+    Ok(())
+}
+
+fn read_ledger(root: &Path, directory: &str) -> Result<Ledger> {
+    read_json(&checked_path(
+        root,
+        Path::new(directory).join("state/tui-work.json").as_path(),
+        false,
+    )?)
+}
+
+fn count_requests(ledger: &Ledger, ids: &mut HashSet<usize>) -> Result<(usize, usize)> {
+    let mut task = 0usize;
+    for request in &ledger.requests {
+        if !ids.insert(request.id) {
+            bail!("duplicate request id");
+        }
+        if request.charge == "task" {
+            task = task.checked_add(1).context("task request overflow")?;
+        }
+    }
+    Ok((task, ledger.requests.len()))
+}
+
+fn checked_path(root: &Path, relative: &Path, allow_missing_leaf: bool) -> Result<PathBuf> {
+    if relative.components().any(|c| {
+        matches!(
+            c,
+            Component::ParentDir | Component::RootDir | Component::Prefix(_)
+        )
+    }) {
+        bail!("invalid traversal path");
+    }
+    let mut current = root.to_path_buf();
+    for component in relative.components() {
+        current.push(component.as_os_str());
+        match fs::symlink_metadata(&current) {
+            Ok(meta) if meta.file_type().is_symlink() => {
+                bail!("symlink path component is not allowed")
+            }
+            Ok(_) => {}
+            Err(e) if allow_missing_leaf && e.kind() == std::io::ErrorKind::NotFound => {
+                return Ok(current)
+            }
+            Err(e) => return Err(e.into()),
+        }
+    }
+    Ok(current)
+}
+
+fn read_json<T: serde::de::DeserializeOwned>(path: &Path) -> Result<T> {
+    let bytes = fs::read(path).with_context(|| format!("failed to read {}", path.display()))?;
+    serde_json::from_slice(&bytes).with_context(|| format!("invalid JSON in {}", path.display()))
+}
