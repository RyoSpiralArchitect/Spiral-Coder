diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..cdbec92
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,95 @@
+use serde_json::Value;
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+const BINARY: &str = env!("CARGO_BIN_EXE_spiral-coder");
+
+fn fixture(state: &str) -> (tempfile::TempDir, Value) {
+    let dir = tempfile::tempdir().unwrap();
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(dir.path())
+        .arg(state)
+        .status()
+        .unwrap();
+    assert!(status.success());
+    let manifest: Value =
+        serde_json::from_str(&fs::read_to_string(dir.path().join("iterations.json")).unwrap())
+            .unwrap();
+    (dir, manifest)
+}
+
+fn invoke(root: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn public_cli_matches_protected_fixture_states() {
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let (dir, _) = fixture(state);
+        let output = invoke(dir.path());
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(serde_json::from_slice::<Value>(&output.stdout).is_ok());
+    }
+}
+
+#[test]
+fn duplicate_request_id_is_rejected() {
+    let (dir, _) = fixture("completed");
+    let ledger = dir.path().join("iteration-01/state/tui-work.json");
+    let mut value: Value = serde_json::from_str(&fs::read_to_string(&ledger).unwrap()).unwrap();
+    let requests = value["requests"].as_array_mut().unwrap();
+    assert!(requests.len() > 1);
+    let id = requests[0]["id"].clone();
+    requests[1]["id"] = id;
+    fs::write(&ledger, serde_json::to_vec_pretty(&value).unwrap()).unwrap();
+    let output = invoke(dir.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn contradictory_completed_active_is_rejected() {
+    let (dir, _) = fixture("completed");
+    let manifest_path = dir.path().join("iterations.json");
+    let mut manifest: Value =
+        serde_json::from_str(&fs::read_to_string(&manifest_path).unwrap()).unwrap();
+    manifest["active_iteration"] = Value::String("iteration-02".into());
+    fs::write(
+        &manifest_path,
+        serde_json::to_vec_pretty(&manifest).unwrap(),
+    )
+    .unwrap();
+    let output = invoke(dir.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn wrong_parent_linkage_is_rejected() {
+    let (dir, _) = fixture("completed");
+    let manifest_path = dir.path().join("iterations.json");
+    let mut manifest: Value =
+        serde_json::from_str(&fs::read_to_string(&manifest_path).unwrap()).unwrap();
+    manifest["iterations"][0]["parent_task_id"] = Value::String("wrong".into());
+    fs::write(
+        &manifest_path,
+        serde_json::to_vec_pretty(&manifest).unwrap(),
+    )
+    .unwrap();
+    let output = invoke(dir.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
