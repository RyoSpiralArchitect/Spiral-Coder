+++ b/src/coupled_status.rs
@@ -0,0 +1,364 @@
+use anyhow::{anyhow, Context, Result};
+use clap::Args as ClapArgs;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+#[derive(ClapArgs, Debug, Clone)]
+pub struct Args {
+    /// Existing coupled-run directory.
+    #[arg(long, value_name = "PATH")]
+    pub run_dir: PathBuf,
+}
+
+#[derive(Debug, Deserialize)]
+struct Manifest {
+    version: u64,
+    max_iterations: u64,
+    max_task_requests_per_iteration: u64,
+    max_task_requests: u64,
+    max_wire_requests: u64,
+    completed: bool,
+    stop_reason: Option<String>,
+    active_iteration: Option<String>,
+    interrupted_iteration: Option<Interrupted>,
+    iterations: Vec<Row>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+
+#[derive(Debug, Deserialize)]
+struct Interrupted {
+    directory: String,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+}
+
+#[derive(Debug, Deserialize)]
+struct Row {
+    iteration: u64,
+    directory: String,
+    task_id: String,
+    parent_task_id: Option<String>,
+    termination: String,
+    completed: bool,
+    task_requests: u64,
+    wire_requests: u64,
+    progress: Progress,
+}
+
+#[derive(Debug, Deserialize)]
+struct Progress {
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct Output {
+    version: u64,
+    status: String,
+    stop_reason: Option<String>,
+    iterations: Vec<OutputRow>,
+    pending: Option<Pending>,
+    requests: Requests,
+}
+
+#[derive(Debug, Serialize)]
+struct OutputRow {
+    iteration: u64,
+    task_id: String,
+    termination: String,
+    task_requests: u64,
+    wire_requests: u64,
+    changed_files: Vec<String>,
+    newly_verified: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct Pending {
+    directory: String,
+    task_id: Option<String>,
+    task_requests: Option<u64>,
+    wire_requests: Option<u64>,
+    in_flight_requests: Option<u64>,
+}
+
+#[derive(Debug, Serialize)]
+struct Requests {
+    task_used: Option<u64>,
+    wire_used: Option<u64>,
+    task_limit: u64,
+    wire_limit: u64,
+    task_remaining: Option<u64>,
+    wire_remaining: Option<u64>,
+}
+
+pub async fn run(args: Args) -> Result<()> {
+    let output = inspect(&args.run_dir)?;
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+fn inspect(root: &Path) -> Result<Output> {
+    let manifest_path = checked_path(root, Path::new("iterations.json"))?;
+    let manifest: Manifest = read_json(&manifest_path)?;
+    if manifest.version != 1 {
+        return Err(anyhow!("unsupported manifest version"));
+    }
+    if manifest.max_iterations == 0 || manifest.max_task_requests_per_iteration == 0 {
+        return Err(anyhow!("limits must be positive"));
+    }
+    let product = manifest
+        .max_iterations
+        .checked_mul(manifest.max_task_requests_per_iteration)
+        .ok_or_else(|| anyhow!("limit overflow"))?;
+    if product != manifest.max_task_requests
+        || manifest.max_wire_requests < manifest.max_task_requests
+    {
+        return Err(anyhow!("invalid limits"));
+    }
+    if manifest.iterations.len() as u64 > manifest.max_iterations {
+        return Err(anyhow!("too many iterations"));
+    }
+
+    let mut ids = HashSet::new();
+    let mut rows = Vec::new();
+    let mut task_sum = 0u64;
+    let mut wire_sum = 0u64;
+    for (index, row) in manifest.iterations.iter().enumerate() {
+        let expected = index as u64 + 1;
+        if row.iteration != expected || row.directory != format!("iteration-{expected:02}") {
+            return Err(anyhow!("invalid iteration ordering"));
+        }
+        if row.task_id.is_empty() || !ids.insert(row.task_id.clone()) {
+            return Err(anyhow!("duplicate or empty task id"));
+        }
+        if row.parent_task_id
+            != if index == 0 {
+                None
+            } else {
+                Some(manifest.iterations[index - 1].task_id.clone())
+            }
+        {
+            return Err(anyhow!("invalid parent task id"));
+        }
+        if row.completed != (row.termination == "completed")
+            || row.task_requests > manifest.max_task_requests_per_iteration
+        {
+            return Err(anyhow!("invalid row completion or usage"));
+        }
+        if row.completed && index + 1 != manifest.iterations.len() {
+            return Err(anyhow!("only the last row may be completed"));
+        }
+        let ledger = read_ledger(root, &row.directory)?;
+        let usage = ledger_usage(&ledger, &row.task_id)?;
+        if usage.0 != row.task_requests || usage.1 != row.wire_requests {
+            return Err(anyhow!("row counts do not match ledger"));
+        }
+        task_sum = task_sum
+            .checked_add(usage.0)
+            .ok_or_else(|| anyhow!("usage overflow"))?;
+        wire_sum = wire_sum
+            .checked_add(usage.1)
+            .ok_or_else(|| anyhow!("usage overflow"))?;
+        rows.push(OutputRow {
+            iteration: row.iteration,
+            task_id: row.task_id.clone(),
+            termination: row.termination.clone(),
+            task_requests: row.task_requests,
+            wire_requests: row.wire_requests,
+            changed_files: row.progress.changed_files.clone(),
+            newly_verified: row.progress.newly_verified.clone(),
+        });
+    }
+
+    let pending_name = match (&manifest.active_iteration, &manifest.interrupted_iteration) {
+        (Some(_), Some(_)) => return Err(anyhow!("multiple pending iterations")),
+        (Some(name), None) => Some((name.clone(), false)),
+        (None, Some(item)) => Some((item.directory.clone(), true)),
+        (None, None) => None,
+    };
+    let mut pending = None;
+    let mut total_task = task_sum;
+    let mut total_wire = wire_sum;
+    if let Some((directory, interrupted)) = pending_name {
+        let next = manifest.iterations.len() as u64 + 1;
+        if directory != format!("iteration-{next:02}")
+            || next > manifest.max_iterations
+            || directory.contains("..")
+        {
+            return Err(anyhow!("invalid pending directory"));
+        }
+        if interrupted != (manifest.stop_reason.as_deref() == Some("interrupted")) {
+            return Err(anyhow!("invalid pending state"));
+        }
+        let path = root.join(&directory).join("state").join("tui-work.json");
+        let exists = safe_exists(
+            root,
+            Path::new(&directory).join("state").join("tui-work.json"),
+        )?;
+        let (task_id, task_requests, wire_requests, in_flight) = if exists {
+            let ledger: Value = read_json(&path)?;
+            let id = ledger
+                .get("task_id")
+                .and_then(Value::as_str)
+                .map(str::to_owned);
+            if id.as_deref().is_some_and(|v| ids.contains(v)) {
+                return Err(anyhow!("duplicate pending task id"));
+            }
+            let (task, wire, flight) = ledger_usage_full(&ledger)?;
+            total_task = total_task
+                .checked_add(task)
+                .ok_or_else(|| anyhow!("usage overflow"))?;
+            total_wire = total_wire
+                .checked_add(wire)
+                .ok_or_else(|| anyhow!("usage overflow"))?;
+            (id, Some(task), Some(wire), Some(flight))
+        } else {
+            (None, None, None, None)
+        };
+        if interrupted {
+            if let Some(item) = manifest.interrupted_iteration.as_ref() {
+                if item.task_requests != task_requests || item.wire_requests != wire_requests {
+                    return Err(anyhow!("pending counts mismatch"));
+                }
+            }
+        }
+        pending = Some(Pending {
+            directory,
+            task_id,
+            task_requests,
+            wire_requests,
+            in_flight_requests: in_flight,
+        });
+    }
+    let has_interrupted = manifest.interrupted_iteration.is_some();
+    if has_interrupted {
+        if pending.as_ref().is_some_and(|p| p.task_requests.is_none()) {
+            if manifest.task_requests.is_some() || manifest.wire_requests.is_some() {
+                return Err(anyhow!(
+                    "unknown interrupted usage must have unknown totals"
+                ));
+            }
+        } else if manifest.task_requests != Some(total_task)
+            || manifest.wire_requests != Some(total_wire)
+        {
+            return Err(anyhow!("manifest counts mismatch"));
+        }
+    } else if manifest.task_requests != Some(task_sum) || manifest.wire_requests != Some(wire_sum) {
+        return Err(anyhow!("manifest counts mismatch"));
+    }
+    if total_task > manifest.max_task_requests || total_wire > manifest.max_wire_requests {
+        return Err(anyhow!("usage exceeds limits"));
+    }
+    let is_completed = manifest.stop_reason.as_deref() == Some("completed");
+    if manifest.completed != is_completed {
+        return Err(anyhow!("completed mismatch"));
+    }
+    if is_completed
+        && (manifest.iterations.last().is_none_or(|r| !r.completed) || pending.is_some())
+    {
+        return Err(anyhow!("invalid completed manifest"));
+    }
+    if rows.iter().any(|r| r.termination == "completed") && !is_completed {
+        return Err(anyhow!("completed row in unfinished manifest"));
+    }
+    let known = pending.as_ref().is_none_or(|p| p.task_requests.is_some());
+    let used_task = if known { Some(total_task) } else { None };
+    let used_wire = if known { Some(total_wire) } else { None };
+    Ok(Output {
+        version: 1,
+        status: if is_completed {
+            "completed"
+        } else if manifest.stop_reason.is_some() {
+            "stopped"
+        } else {
+            "running"
+        }
+        .into(),
+        stop_reason: manifest.stop_reason.clone(),
+        iterations: rows,
+        pending,
+        requests: Requests {
+            task_used: used_task,
+            wire_used: used_wire,
+            task_limit: manifest.max_task_requests,
+            wire_limit: manifest.max_wire_requests,
+            task_remaining: used_task.clone().map(|v| manifest.max_task_requests - v),
+            wire_remaining: used_wire.clone().map(|v| manifest.max_wire_requests - v),
+        },
+    })
+}
+
+fn checked_path(root: &Path, relative: &Path) -> Result<PathBuf> {
+    let mut current = root.to_path_buf();
+    for component in relative.components() {
+        if let Component::Normal(part) = component {
+            current.push(part);
+            if current.is_symlink() {
+                return Err(anyhow!("symlink path component"));
+            }
+        }
+    }
+    Ok(current)
+}
+
+fn safe_exists(root: &Path, relative: PathBuf) -> Result<bool> {
+    let path = checked_path(root, &relative)?;
+    Ok(path.exists())
+}
+
+fn read_json<T: for<'de> Deserialize<'de>>(path: &Path) -> Result<T> {
+    let text = fs::read_to_string(path).with_context(|| format!("read {}", path.display()))?;
+    serde_json::from_str(&text).with_context(|| format!("parse {}", path.display()))
+}
+
+fn read_ledger(root: &Path, directory: &str) -> Result<Value> {
+    read_json(&checked_path(
+        root,
+        &Path::new(directory).join("state/tui-work.json"),
+    )?)
+}
+
+fn ledger_usage(ledger: &Value, task_id: &str) -> Result<(u64, u64)> {
+    if ledger.get("task_id").and_then(Value::as_str) != Some(task_id) {
+        return Err(anyhow!("ledger task mismatch"));
+    }
+    let (task, wire, _) = ledger_usage_full(ledger)?;
+    Ok((task, wire))
+}
+
+fn ledger_usage_full(ledger: &Value) -> Result<(u64, u64, u64)> {
+    let requests = ledger
+        .get("requests")
+        .and_then(Value::as_array)
+        .ok_or_else(|| anyhow!("missing requests"))?;
+    let mut ids = HashSet::new();
+    let mut task = 0u64;
+    let mut flight = 0u64;
+    for request in requests {
+        let id = request
+            .get("id")
+            .and_then(Value::as_u64)
+            .ok_or_else(|| anyhow!("invalid request id"))?;
+        if !ids.insert(id) {
+            return Err(anyhow!("duplicate request id"));
+        }
+        if request
+            .get("charge")
+            .and_then(Value::as_str)
+            .unwrap_or("task")
+            == "task"
+        {
+            task = task
+                .checked_add(1)
+                .ok_or_else(|| anyhow!("usage overflow"))?;
+        }
+        if request.get("status").and_then(Value::as_str) == Some("in_flight_or_interrupted") {
+            flight += 1;
+        }
+    }
+    Ok((task, requests.len() as u64, flight))
+}
