diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..d04e1d8
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,54 @@
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+fn fixture(kind: &str) -> tempfile::TempDir {
+    let dir = tempfile::tempdir().unwrap();
+    let status = Command::new("python3")
+        .args([
+            "-S",
+            "scripts/status_fixture.py",
+            dir.path().to_str().unwrap(),
+            kind,
+        ])
+        .status()
+        .unwrap();
+    assert!(status.success(), "fixture generation failed");
+    dir
+}
+
+fn cli(run_dir: &Path) -> std::process::Output {
+    Command::new(env!("CARGO_BIN_EXE_spiral-coder"))
+        .args(["coupled-status", "--run-dir"])
+        .arg(run_dir)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn completed_fixture_is_reported_by_public_cli() {
+    let dir = fixture("completed");
+    let output = cli(dir.path());
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+    assert_eq!(value["status"], "completed");
+    assert_eq!(value["iterations"].as_array().unwrap().len(), 1);
+}
+
+#[test]
+fn unsupported_manifest_version_is_rejected_without_stdout() {
+    let dir = fixture("completed");
+    let path = dir.path().join("iterations.json");
+    let mut manifest: serde_json::Value =
+        serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    manifest["version"] = serde_json::json!(99);
+    fs::write(path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+    let output = cli(dir.path());
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
