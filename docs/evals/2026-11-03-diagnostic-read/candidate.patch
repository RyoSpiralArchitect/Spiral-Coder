diff --git a/src/tui_replay.rs b/src/tui_replay.rs
index 4d27247..c39a111 100644
--- a/src/tui_replay.rs
+++ b/src/tui_replay.rs
@@ -9,6 +9,33 @@ use crate::tui::app::{App, Message, Role};
 use crate::tui::{events, intent};
 
 pub(crate) mod diagnostics;
+pub(crate) mod catalog;
+
+pub(crate) fn select_cases(
+    spec: &TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<TuiReplayCase> {
+    let filter_lc = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<TuiReplayCase> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter_lc.as_deref().is_none_or(|needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case
+                        .tags
+                        .iter()
+                        .any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .cloned()
+        .collect();
+    if let Some(limit) = max_cases.map(|n| n.max(1)) {
+        selected.truncate(limit);
+    }
+    selected
+}
 
 fn default_spec_version() -> u32 {
     1
diff --git a/src/tui_replay/catalog.rs b/src/tui_replay/catalog.rs
new file mode 100644
index 0000000..a22718b
--- /dev/null
+++ b/src/tui_replay/catalog.rs
@@ -0,0 +1,52 @@
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{load_spec, resolve_path, select_cases};
+
+#[derive(Debug, Serialize)]
+struct CatalogOutput {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub(crate) fn run(args: crate::TuiReplayListArgs) -> Result<()> {
+    let cwd = std::env::current_dir().context("failed to get current directory")?;
+    let base_root = args
+        .tool_root
+        .clone()
+        .or_else(|| cwd.to_str().map(str::to_owned))
+        .unwrap_or_else(|| ".".to_owned());
+    let base_root_path = PathBuf::from(base_root);
+    let spec_path = resolve_path(&base_root_path, args.spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, args.filter.as_deref(), args.max_cases);
+    if selected.is_empty() {
+        return Err(super::diagnostics::empty_selection(
+            &spec_path,
+            &base_root_path,
+            args.filter.as_deref(),
+            &spec.cases,
+        ));
+    }
+    let output = CatalogOutput {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase {
+                id: case.id,
+                tags: case.tags,
+            })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
