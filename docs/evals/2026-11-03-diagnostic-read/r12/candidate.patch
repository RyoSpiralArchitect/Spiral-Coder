+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+use super::{load_spec, resolve_path, TuiReplayCase, TuiReplaySpec};
+
+#[derive(Debug, Serialize)]
+struct CatalogOutput {
+    version: u32,
+    total: usize,
+    cases: Vec<CatalogCase>,
+}
+
+#[derive(Debug, Serialize)]
+struct CatalogCase {
+    id: String,
+    tags: Vec<String>,
+}
+
+pub fn list(
+    tool_root: Option<PathBuf>,
+    spec: PathBuf,
+    filter: Option<String>,
+    max_cases: Option<usize>,
+) -> Result<()> {
+    let root = tool_root.unwrap_or(std::env::current_dir()?);
+    let spec_path = resolve_path(&root, spec);
+    let spec = load_spec(&spec_path)?;
+    let selected = select_cases(&spec, filter.as_deref(), max_cases);
+    if selected.is_empty() {
+        anyhow::bail!("no replay cases selected from {}", spec_path.display());
+    }
+    validate_selected(&selected).with_context(|| {
+        format!("invalid replay catalog selection in {}", spec_path.display())
+    })?;
+    let output = CatalogOutput {
+        version: 1,
+        total: selected.len(),
+        cases: selected
+            .into_iter()
+            .map(|case| CatalogCase { id: case.id, tags: case.tags })
+            .collect(),
+    };
+    println!("{}", serde_json::to_string(&output)?);
+    Ok(())
+}
+
+pub(crate) fn select_cases(
+    spec: &TuiReplaySpec,
+    filter: Option<&str>,
+    max_cases: Option<usize>,
+) -> Vec<TuiReplayCase> {
+    let filter = filter.map(str::to_ascii_lowercase);
+    let mut selected: Vec<_> = spec
+        .cases
+        .iter()
+        .filter(|case| {
+            filter.as_deref().map_or(true, |needle| {
+                case.id.to_ascii_lowercase().contains(needle)
+                    || case.tags.iter().any(|tag| tag.to_ascii_lowercase().contains(needle))
+            })
+        })
+        .cloned()
+        .collect();
+    if let Some(limit) = max_cases {
+        selected.truncate(limit.max(1));
+    }
+    selected
+}
+
+fn validate_selected(cases: &[TuiReplayCase]) -> Result<()> {
+    for case in cases {
+        if case.checks.is_empty() {
+            anyhow::bail!("case '{}' has empty checks", case.id);
+        }
+    }
+    Ok(())
+}
