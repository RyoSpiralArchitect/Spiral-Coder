@@ -4,4 +4,11 @@
 def parse_bool(value, default=False):
     if value is None:
         return default
-    return bool(value)
+    token = value.strip().lower()
+    if not token:
+        return default
+    if token in ("true", "1", "yes", "on"):
+        return True
+    if token in ("false", "0", "no", "off"):
+        return False
+    raise ValueError(f"unrecognized boolean value: {value!r}")
