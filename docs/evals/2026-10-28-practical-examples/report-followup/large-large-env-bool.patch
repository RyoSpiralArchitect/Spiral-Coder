 # Boolean settings
 
-`parse_bool(value, default=False)` reads an environment-style setting.
-The current implementation treats every nonempty string as enabled.
+`parse_bool(value, default=False)` reads an environment-style boolean setting.
+
+## Accepted tokens
+
+- True: `true`, `1`, `yes`, `on`
+- False: `false`, `0`, `no`, `off`
+
+Matching ignores case and surrounding whitespace, so `"  YeS  "` is `True` and `"OFF"` is `False`.
+
+## Defaults
+
+`None`, empty strings, and whitespace-only strings return the supplied `default` (a bool, `False` unless overridden). An explicit token always wins over the default.
+
+## Invalid values
+
+Any other string raises `ValueError`; a nonempty string is not automatically true.
+
+## Examples
+
+- `parse_bool("OFF") -> False`
+- `parse_bool("", default=True) -> True`
+
+## Verify
+
+Run the test suite with:
+
+```
+python3 -B -S -m unittest discover -s tests -v
+```
diff --git a/settings.py b/settings.py
index b3c7c3f..d15df9c 100644
--- a/settings.py
+++ b/settings.py
@@ -4,4 +4,11 @@
 def parse_bool(value, default=False):
     if value is None:
         return default
-    return bool(value)
+    normalized = value.strip().lower()
+    if not normalized:
+        return default
+    if normalized in ("true", "1", "yes", "on"):
+        return True
+    if normalized in ("false", "0", "no", "off"):
+        return False
+    raise ValueError(f"Unknown boolean value: {value!r}")
