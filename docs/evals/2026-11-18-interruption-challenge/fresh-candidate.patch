diff --git a/tests/coupled_status.rs b/tests/coupled_status.rs
new file mode 100644
index 0000000..da7ba90
--- /dev/null
+++ b/tests/coupled_status.rs
@@ -0,0 +1,73 @@
+use serde_json::Value;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn fixture(root: &Path, state: &str) -> Value {
+    let status = Command::new("python3")
+        .args(["-S", "scripts/status_fixture.py"])
+        .arg(root)
+        .arg(state)
+        .status()
+        .expect("fixture helper runs");
+    assert!(status.success());
+    serde_json::from_str(&fs::read_to_string(root.join("iterations.json")).unwrap()).unwrap()
+}
+
+fn run(root: &Path) -> std::process::Output {
+    let binary = PathBuf::from(env!("CARGO_BIN_EXE_spiral-coder"));
+    Command::new(binary)
+        .args(["coupled-status", "--run-dir"])
+        .arg(root)
+        .output()
+        .unwrap()
+}
+
+#[test]
+fn native_fixture_states_are_public_cli_compatible() {
+    let tmp = tempfile::tempdir().unwrap();
+    for state in ["completed", "running", "interrupted", "unknown", "stopped"] {
+        let root = tmp.path().join(state);
+        let _manifest = fixture(&root, state);
+        let output = run(&root);
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let value: Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert_eq!(value["version"], 1);
+        assert!(value["requests"].is_object());
+    }
+}
+
+#[test]
+fn duplicate_request_id_is_rejected() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().join("duplicate");
+    fixture(&root, "completed");
+    let path = root.join("iteration-01/state/tui-work.json");
+    let mut ledger: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    let first = ledger["requests"][0]["id"].clone();
+    ledger["requests"][1]["id"] = first;
+    fs::write(&path, serde_json::to_vec_pretty(&ledger).unwrap()).unwrap();
+    let output = run(&root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
+
+#[test]
+fn wrong_parent_linkage_is_rejected() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path().join("parent");
+    fixture(&root, "completed");
+    let path = root.join("iterations.json");
+    let mut manifest: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+    manifest["iterations"][0]["parent_task_id"] = Value::String("wrong".into());
+    fs::write(&path, serde_json::to_vec_pretty(&manifest).unwrap()).unwrap();
+    let output = run(&root);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+    assert!(!output.stderr.is_empty());
+}
