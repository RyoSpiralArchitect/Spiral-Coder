@@ -0,0 +1,61 @@
+use super::{load_spec, resolve_path, selected_cases};
+use anyhow::{Context, Result};
+use serde::Serialize;
+use std::path::PathBuf;
+
+#[derive(clap::Args, Debug, Clone)]
+pub(crate) struct Args {
+    #[arg(long, short = 'C', alias = "root")]
+    tool_root: Option<PathBuf>,
+
+    #[arg(long, default_value = ".spiral-coder/tui_replay.json")]
+    spec: PathBuf,
+
+    #[arg(long)]
+    filter: Option<String>,
+
+    #[arg(long)]
+    max_cases: Option<usize>,
+}
+
+#[derive(Serialize)]
+struct Entry<'a> {
+    id: &'a str,
+    tags: &'a [String],
+}
+
+#[derive(Serialize)]
+struct Catalog<'a> {
+    version: u32,
+    total: usize,
+    cases: Vec<Entry<'a>>,
+}
+
+pub(crate) fn run(args: Args) -> Result<()> {
+    let root = match args.tool_root {
+        Some(root) => root,
+        None => std::env::current_dir().context("get working directory")?,
+    };
+    let path = resolve_path(&root, args.spec);
+    let spec = load_spec(&path)?;
+    let cases: Vec<_> = selected_cases(
+        &spec.cases,
+        args.filter.as_deref(),
+        args.max_cases,
+        &path,
+        &root,
+    )?
+    .into_iter()
+    .map(|c| Entry {
+        id: &c.id,
+        tags: &c.tags,
+    })
+    .collect();
+    let catalog = Catalog {
+        version: spec.version,
+        total: cases.len(),
+        cases,
+    };
+    println!("{}", serde_json::to_string(&catalog)?);
+    Ok(())
+}
