{
  "version": 2,
  "id": "coupled-status",
  "prompt": "prompt.txt",
  "editable": [
    "src/main.rs",
    "src/coupled_status.rs",
    "npm/spiral-coder/lib/launcher.cjs",
    "docs/coupled-status.md",
    "docs/state-schema.md",
    "tests/coupled_status.rs"
  ],
  "required_changed_paths": [
    "src/main.rs",
    "src/coupled_status.rs",
    "npm/spiral-coder/lib/launcher.cjs",
    "docs/coupled-status.md",
    "docs/state-schema.md"
  ],
  "protected": [
    "Cargo.toml",
    "Cargo.lock",
    ".spiral-coder/tui_replay.json",
    "scripts/check-local.sh",
    "src/tui/events/coupled_run/iterations.rs",
    "src/work_budget.rs"
  ],
  "roles": {
    "coder": {
      "provider": "openai",
      "model": "gpt-5.6-luna"
    },
    "observer": {
      "provider": "openai",
      "model": "gpt-5.6-luna"
    }
  },
  "max_requests": 32,
  "observer_reserved_requests": 8,
  "transport_repair_requests": 4,
  "coder_chunk_requests": 8,
  "wall_seconds": 3600,
  "evaluation_wall_seconds": 1200,
  "timeout_seconds": 90,
  "max_tokens": 32768,
  "observer_max_tokens": 8192,
  "temperature": 0,
  "native_checks": [
    "cargo fmt --all -- --check",
    "python3 -S -m unittest -v scripts.status_visible",
    "python3 -S -m unittest -v scripts.status_guide",
    "cargo test --locked --bin spiral-coder -q"
  ],
  "reproducer_command": "python3 -S -m unittest -v scripts.status_visible",
  "visible_check_id": "status-visible",
  "checks": [
    {
      "id": "candidate-build",
      "kind": "build",
      "baseline": "pass",
      "argv": [
        "cargo",
        "build",
        "--locked",
        "--bin",
        "spiral-coder"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "status-visible",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        "-m",
        "unittest",
        "-v",
        "scripts.status_visible"
      ],
      "expected_test_count": 1,
      "baseline_failure_contains": [
        "coupled-status command missing from --help"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "status-held-out",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        ".status-checks/status_oracle.py",
        "{target_dir}/debug/spiral-coder"
      ],
      "expected_test_count": 24,
      "expected_baseline_failures": 24,
      "baseline_failure_contains": [
        "coupled-status command missing from --help"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "packaged-status",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        ".status-checks/packaged_status.py",
        "{target_dir}/debug/spiral-coder"
      ],
      "expected_test_count": 1,
      "baseline_failure_contains": [
        "coupled-status command missing from --help"
      ],
      "timeout_seconds": 90
    },
    {
      "id": "guide-example",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        "-m",
        "unittest",
        "-v",
        "scripts.status_guide"
      ],
      "expected_test_count": 1,
      "baseline_failure_contains": [
        "coupled-status guide missing"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "stock-regressions",
      "kind": "regression",
      "baseline": "pass",
      "argv": [
        "python3",
        "-S",
        ".status-checks/stock_checks.py",
        "{receipts}"
      ],
      "timeout_seconds": 600
    }
  ],
  "visible_fixtures": [
    {
      "source": "status_fixture.py",
      "target": "scripts/status_fixture.py"
    },
    {
      "source": "status_visible.py",
      "target": "scripts/status_visible.py"
    },
    {
      "source": "status_guide.py",
      "target": "scripts/status_guide.py"
    }
  ],
  "probes": [
    {
      "source": "status_oracle.py",
      "target": ".status-checks/status_oracle.py"
    },
    {
      "source": "packaged_status.py",
      "target": ".status-checks/packaged_status.py"
    },
    {
      "source": "stock_checks.py",
      "target": ".status-checks/stock_checks.py"
    }
  ],
  "reference": [
    {
      "source": "reference/src/main.rs",
      "target": "src/main.rs"
    },
    {
      "source": "reference/src/coupled_status.rs",
      "target": "src/coupled_status.rs"
    },
    {
      "source": "reference/npm/spiral-coder/lib/launcher.cjs",
      "target": "npm/spiral-coder/lib/launcher.cjs"
    },
    {
      "source": "reference/docs/coupled-status.md",
      "target": "docs/coupled-status.md"
    },
    {
      "source": "reference/docs/state-schema.md",
      "target": "docs/state-schema.md"
    }
  ]
}
