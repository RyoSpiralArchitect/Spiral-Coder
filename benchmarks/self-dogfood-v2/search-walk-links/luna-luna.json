{
  "version": 2,
  "id": "search-walk-links",
  "prompt": "prompt.txt",
  "editable": [
    "src/file_tools.rs"
  ],
  "required_changed_paths": [
    "src/file_tools.rs"
  ],
  "protected": [
    "Cargo.toml",
    "Cargo.lock",
    ".spiral-coder/tui_replay.json",
    "scripts/check-local.sh"
  ],
  "roles": {
    "coder": {
      "provider": "openai",
      "model": "gpt-5.6-luna"
    },
    "observer": {
      "provider": "openai",
      "model": "gpt-5.6-luna"
    }
  },
  "max_requests": 32,
  "observer_reserved_requests": 8,
  "transport_repair_requests": 4,
  "coder_chunk_requests": 8,
  "wall_seconds": 1200,
  "evaluation_wall_seconds": 900,
  "timeout_seconds": 90,
  "max_tokens": 32768,
  "observer_max_tokens": 8192,
  "temperature": 0,
  "native_checks": [
    "python3 -S -m unittest -v scripts.search_walk_visible",
    "cargo test --locked --bin spiral-coder -q"
  ],
  "reproducer_command": "python3 -S -m unittest -v scripts.search_walk_visible",
  "visible_check_id": "search-walk-visible",
  "checks": [
    {
      "id": "candidate-build",
      "kind": "build",
      "baseline": "pass",
      "argv": [
        "cargo",
        "build",
        "--locked",
        "--bin",
        "spiral-coder"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "search-walk-visible",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        "-m",
        "unittest",
        "-v",
        "scripts.search_walk_visible"
      ],
      "timeout_seconds": 180,
      "expected_test_count": 1,
      "expected_baseline_failures": 1,
      "baseline_failure_contains": [
        "recursive search followed a discovered file link"
      ]
    },
    {
      "id": "search-walk-held-out",
      "kind": "improvement",
      "baseline": "fail",
      "argv": [
        "python3",
        "-S",
        ".search-checks/held_out.py",
        "{target_dir}/debug/spiral-coder"
      ],
      "timeout_seconds": 60,
      "expected_test_count": 2,
      "expected_baseline_failures": 2,
      "baseline_failure_contains": [
        "discovered directory link contributed a row",
        "discovered nested file link contributed a row"
      ]
    },
    {
      "id": "ordinary-search",
      "kind": "regression",
      "baseline": "pass",
      "argv": [
        "python3",
        "-S",
        ".search-checks/control.py",
        "{target_dir}/debug/spiral-coder"
      ],
      "timeout_seconds": 60,
      "expected_test_count": 1
    },
    {
      "id": "stock-regressions",
      "kind": "regression",
      "baseline": "pass",
      "argv": [
        "python3",
        "-S",
        ".search-checks/stock.py",
        "{receipts}"
      ],
      "timeout_seconds": 420
    }
  ],
  "visible_fixtures": [
    {
      "source": "fixture.py",
      "target": "scripts/search_walk_fixture.py"
    },
    {
      "source": "visible.py",
      "target": "scripts/search_walk_visible.py"
    }
  ],
  "probes": [
    {
      "source": "held_out.py",
      "target": ".search-checks/held_out.py"
    },
    {
      "source": "control.py",
      "target": ".search-checks/control.py"
    },
    {
      "source": "stock.py",
      "target": ".search-checks/stock.py"
    }
  ],
  "reference": [
    {
      "source": "reference.rs",
      "target": "src/file_tools.rs"
    }
  ]
}
